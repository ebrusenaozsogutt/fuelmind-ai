<UserControl x:Class="FuelMind.Desktop.Controls.AlarmAiAnalysisControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             DataContext="{Binding Alarm, ElementName=Root}">
    <Border Margin="0,18,0,0"
            Padding="14"
            Background="{DynamicResource ControlBackgroundBrush}"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            TextElement.Foreground="{DynamicResource AppForegroundBrush}">
        <StackPanel>
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="YAPAY ZEKÂ ANALİZİ" />

            <TextBlock Margin="0,10,0,0"
                       Foreground="{DynamicResource MutedForegroundBrush}"
                       Text="Bu alarm için yapay zekâ değerlendirmesi bulunmuyor."
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNoAiAnalysis}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Margin="0,10,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasAiAnalysis}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,8,10">
                        <TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="Risk Skoru" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding AiRiskDisplay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,10">
                        <TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="Risk Seviyesi" />
                        <Border Margin="0,3,0,0"
                                Padding="8,3"
                                HorizontalAlignment="Left"
                                Background="{Binding RiskLevel, Converter={StaticResource AiRiskLevelToBrushConverter}}"
                                CornerRadius="10"
                                TextElement.Foreground="{DynamicResource AppForegroundBrush}">
                            <TextBlock FontWeight="SemiBold" Text="{Binding RiskLevelDisplay}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10">
                        <TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="Karar Kaynağı" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding DecisionSourceDisplay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,0,8,0">
                        <TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="Model" />
                        <TextBlock Text="{Binding ModelVersionDisplay}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="Anomali Türü" />
                        <TextBlock Text="{Binding AnomalyTypeDisplay}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <TextBlock Margin="0,16,0,0" FontWeight="SemiBold" Text="YAPAY ZEKÂ BULGULARI" />
                <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding FindingsDisplay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0,2,0,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Text="{Binding StringFormat=• {0}}"
                                       TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Margin="0,16,0,0" FontWeight="SemiBold" Text="MUHTEMEL NEDENLER" />
                <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding ProbableCauses}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0,2,0,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Text="{Binding DisplayDescription, StringFormat=• {0}}"
                                       TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Margin="0,16,0,0" FontWeight="SemiBold" Text="ÖNERİLEN KONTROLLER" />
                <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding RecommendedChecksDisplay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0,2,0,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Text="{Binding StringFormat=• {0}}"
                                       TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Margin="0,16,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataQualityNote}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DataQualityNote}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock FontWeight="SemiBold" Text="VERİ KALİTESİ" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{DynamicResource WarningForegroundBrush}"
                               Text="{Binding DataQualityNoteDisplay}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
