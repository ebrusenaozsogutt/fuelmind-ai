<UserControl x:Class="FuelMind.Desktop.Controls.AiAnalysisControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Padding="18" Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6">
        <StackPanel>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="YAPAY ZEKÂ ANALİZİ" />
            <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource MutedForegroundBrush}"
                       Text="Canlı yapay zekâ sonucu bekleniyor…">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Result, ElementName=Root}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <StackPanel Margin="0,12,0,0" DataContext="{Binding Result, ElementName=Root}">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <Trigger Property="DataContext" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <WrapPanel>
                    <Border Padding="12,7" CornerRadius="5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource InactiveBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RiskLevel}" Value="NORMAL"><Setter Property="Background" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding RiskLevel}" Value="WATCH"><Setter Property="Background" Value="{DynamicResource InactiveBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding RiskLevel}" Value="MEDIUM"><Setter Property="Background" Value="{DynamicResource WarningBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding RiskLevel}" Value="HIGH"><Setter Property="Background" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding RiskLevel}" Value="CRITICAL"><Setter Property="Background" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontWeight="SemiBold" Text="Risk Skoru: " />
                            <TextBlock FontWeight="Bold" Text="{Binding RiskDisplay}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Margin="14,7,0,0" FontWeight="SemiBold" Text="{Binding StateDisplay}" />
                </WrapPanel>
                <UniformGrid Margin="0,14,0,0" Columns="3">
                    <StackPanel><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="Karar Kaynağı" /><TextBlock FontWeight="SemiBold" Text="{Binding DecisionSourceDisplay}" /></StackPanel>
                    <StackPanel><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="Model" /><TextBlock FontWeight="SemiBold" Text="{Binding ModelVersion, TargetNullValue=—}" /></StackPanel>
                    <StackPanel><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="Anomali Türü" /><TextBlock FontWeight="SemiBold" Text="{Binding AnomalyType, TargetNullValue=—}" /></StackPanel>
                </UniformGrid>
                <TextBlock Margin="0,14,0,0" FontWeight="SemiBold" Text="Bulgular" />
                <ItemsControl ItemsSource="{Binding FindingsDisplay}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="0,3,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock Margin="0,14,0,0" FontWeight="SemiBold" Text="Muhtemel nedenler" />
                <ItemsControl ItemsSource="{Binding ProbableCauses}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="0,3,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock Margin="0,14,0,0" FontWeight="SemiBold" Text="Önerilen işlem" />
                <ItemsControl ItemsSource="{Binding RecommendedChecks}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="0,3,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource WarningForegroundBrush}"
                           Text="{Binding DataQualityNote}" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
