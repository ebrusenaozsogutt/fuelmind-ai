<UserControl x:Class="FuelMind.Desktop.Controls.PumpControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Width="300"
            Padding="16"
            Background="{DynamicResource CardBrush}"
            BorderBrush="#3B5362"
            BorderThickness="1"
            CornerRadius="6">
        <StackPanel>
            <DockPanel>
                <StackPanel>
                    <TextBlock FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppForegroundBrush}"
                               Text="{Binding Pump.PumpId, ElementName=Root, StringFormat=Pompa {0}, TargetNullValue=Pompa --}" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="#B8C7D1"
                               Text="{Binding Pump.TankId, ElementName=Root, StringFormat=Bağlı tank ID: {0}, TargetNullValue=Bağlı tank ID: --}" />
                </StackPanel>
                <Border DockPanel.Dock="Right"
                        Padding="9,4"
                        Background="{DynamicResource AppBackgroundBrush}"
                        CornerRadius="4">
                    <TextBlock FontWeight="SemiBold"
                               Foreground="{DynamicResource AppForegroundBrush}"
                               Text="{Binding Pump.Status, ElementName=Root, TargetNullValue=--}" />
                </Border>
            </DockPanel>

            <Separator Margin="0,12,0,10" Background="#3B5362" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Foreground="#B8C7D1" Text="Akış hızı" />
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Pump.FlowRate, ElementName=Root, StringFormat={}{0:N1}, TargetNullValue=--}" />
                    <TextBlock Margin="0,12,0,0" Foreground="#B8C7D1" Text="Basınç" />
                    <TextBlock Text="{Binding Pump.Pressure, ElementName=Root, StringFormat={}{0:N1}, TargetNullValue=--}" />
                    <TextBlock Margin="0,12,0,0" Foreground="#B8C7D1" Text="Motor akımı" />
                    <TextBlock Text="{Binding Pump.MotorCurrent, ElementName=Root, StringFormat={}{0:N1}, TargetNullValue=--}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Foreground="#B8C7D1" Text="Sıcaklık" />
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Pump.Temperature, ElementName=Root, StringFormat={}{0:N1}, TargetNullValue=--}" />
                    <TextBlock Margin="0,12,0,0" Foreground="#B8C7D1" Text="Hata sayısı" />
                    <TextBlock Text="{Binding Pump.ErrorCount, ElementName=Root, TargetNullValue=--}" />
                    <TextBlock Margin="0,12,0,0" Foreground="#B8C7D1" Text="Çalışma süresi" />
                    <TextBlock Text="{Binding Pump.WorkingDuration, ElementName=Root, StringFormat={}{0:N1}, TargetNullValue=--}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
