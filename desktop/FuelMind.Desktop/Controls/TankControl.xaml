<UserControl x:Class="FuelMind.Desktop.Controls.TankControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Width="300"
            Padding="16"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                <Border Width="58"
                        Height="190"
                        Padding="5"
                        Background="{DynamicResource AppBackgroundBrush}"
                        BorderBrush="{DynamicResource MutedForegroundBrush}"
                        BorderThickness="2"
                        CornerRadius="8">
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding FillPercentage, ElementName=Root, TargetNullValue=0}"
                                 Foreground="#2C9B68"
                                 Background="{DynamicResource AppBackgroundBrush}"
                                 BorderThickness="0"
                                 Orientation="Vertical" />
                </Border>
                <TextBlock Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           Text="{Binding FillPercentageText, ElementName=Root}" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppForegroundBrush}"
                           Text="{Binding Tank.Code, ElementName=Root, TargetNullValue=Tank --}" />
                <TextBlock Margin="0,3,0,0"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           Text="{Binding Tank.TankId, ElementName=Root, StringFormat=Tank ID: {0}, TargetNullValue=Tank ID: --}" />
                <TextBlock Foreground="{DynamicResource MutedForegroundBrush}"
                           Text="{Binding Tank.FuelTypeId, ElementName=Root, StringFormat=Yakıt türü ID: {0}, TargetNullValue=Yakıt türü ID: --}" />

                <Separator Margin="0,12,0,10" Background="{DynamicResource ControlBorderBrush}" />

                <TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="Ölçülen seviye" />
                <TextBlock FontSize="16"
                           FontWeight="SemiBold"
                           Text="{Binding Tank.MeasuredLevelLiters, ElementName=Root, StringFormat={}{0:N0} L, TargetNullValue=--}" />
                <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="Gerçek seviye" />
                <TextBlock Text="{Binding Tank.TrueLevelLiters, ElementName=Root, StringFormat={}{0:N0} L, TargetNullValue=--}" />
                <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="Kapasite" />
                <TextBlock Text="{Binding Tank.CapacityLiters, ElementName=Root, StringFormat={}{0:N0} L, TargetNullValue=Veri yok}" />
                <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="Sıcaklık" />
                <TextBlock Text="{Binding Tank.Temperature, ElementName=Root, StringFormat={}{0:N1} °C, TargetNullValue=--}" />
                <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="Su seviyesi" />
                <TextBlock Text="{Binding Tank.WaterLevel, ElementName=Root, StringFormat={}{0:N1}, TargetNullValue=--}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
