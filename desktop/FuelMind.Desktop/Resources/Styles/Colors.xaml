<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:FuelMind.Desktop.Converters">
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#101820" />
    <SolidColorBrush x:Key="AppForegroundBrush" Color="#F4F7FA" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#16232E" />
    <SolidColorBrush x:Key="CardBrush" Color="#233442" />
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#B8C7D1" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#1B2A33" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#3B5362" />
    <SolidColorBrush x:Key="AlarmSeverityLOWBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AlarmSeverityMEDIUMBrush" Color="#D97706" />
    <SolidColorBrush x:Key="AlarmSeverityHIGHBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="AlarmSeverityCRITICALBrush" Color="#7F1D1D" />
    <SolidColorBrush x:Key="AlarmSeverityDefaultBrush" Color="#64748B" />
    <SolidColorBrush x:Key="AlarmStatusNEWBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AlarmStatusACKNOWLEDGEDBrush" Color="#64748B" />
    <SolidColorBrush x:Key="AlarmStatusINVESTIGATINGBrush" Color="#D97706" />
    <SolidColorBrush x:Key="AlarmStatusRESOLVEDBrush" Color="#15803D" />
    <SolidColorBrush x:Key="AlarmStatusFALSE_POSITIVEBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="AlarmStatusDefaultBrush" Color="#64748B" />
    <converters:AlarmSeverityToBrushConverter x:Key="AlarmSeverityToBrushConverter" />
    <converters:AlarmStatusToBrushConverter x:Key="AlarmStatusToBrushConverter" />
    <Style x:Key="SidebarButtonStyle" TargetType="Button">
        <Setter Property="Margin" Value="8,3" /><Setter Property="Padding" Value="12,9" />
        <Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Foreground" Value="#F4F7FA" />
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style x:Key="DashboardCardStyle" TargetType="Border">
        <Setter Property="Margin" Value="6" /><Setter Property="Padding" Value="18" />
        <Setter Property="Background" Value="{StaticResource CardBrush}" /><Setter Property="CornerRadius" Value="6" />
        <Setter Property="TextElement.Foreground" Value="#F4F7FA" />
    </Style>
    <Style x:Key="AlarmBadgeStyle" TargetType="Border">
        <Setter Property="Padding" Value="8,3" /><Setter Property="CornerRadius" Value="10" />
        <Setter Property="TextElement.Foreground" Value="#F8FAFC" />
    </Style>
    <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource AppForegroundBrush}" />
        <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource AppForegroundBrush}" />
                    <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}" />
                    <Setter Property="Padding" Value="8,5" />
                    <Style.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#29485A" /></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#2563EB" /></Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="AlarmSidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
        <Style.Triggers><DataTrigger Binding="{Binding CurrentPageTitle}" Value="Alarm Merkezi"><Setter Property="Background" Value="#29485A" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="BorderBrush" Value="#38BDF8" /><Setter Property="BorderThickness" Value="3,0,0,0" /></DataTrigger></Style.Triggers>
    </Style>
</ResourceDictionary>
