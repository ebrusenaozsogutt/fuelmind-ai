<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:FuelMind.Desktop.Converters">
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#070D18" />
    <SolidColorBrush x:Key="AppForegroundBrush" Color="#F7FAFF" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#0A1324" />
    <SolidColorBrush x:Key="HeaderBrush" Color="#0D1728" />
    <SolidColorBrush x:Key="CardBrush" Color="#111E31" />
    <SolidColorBrush x:Key="RaisedCardBrush" Color="#15243A" />
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#B4C2D6" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#0D192A" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#263B59" />
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#1B2D48" />
    <SolidColorBrush x:Key="TableHeaderBrush" Color="#0C1829" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#182B45" />
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#123C5B" />
    <SolidColorBrush x:Key="RowSelectedBorderBrush" Color="#39C6FF" />
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#788BA4" />
    <SolidColorBrush x:Key="AccentBrush" Color="#39C6FF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#103750" />
    <SolidColorBrush x:Key="AiAccentBrush" Color="#A78BFA" />
    <SolidColorBrush x:Key="AiAccentSoftBrush" Color="#282451" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#167C5A" />
    <SolidColorBrush x:Key="WarningBrush" Color="#C88718" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C3475C" />
    <SolidColorBrush x:Key="InactiveBrush" Color="#405874" />
    <SolidColorBrush x:Key="SuccessForegroundBrush" Color="#6EE7B7" />
    <SolidColorBrush x:Key="WarningForegroundBrush" Color="#FCD56A" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="#FDA4AF" />
    <SolidColorBrush x:Key="AlarmSeverityLOWBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AlarmSeverityMEDIUMBrush" Color="#D97706" />
    <SolidColorBrush x:Key="AlarmSeverityHIGHBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="AlarmSeverityCRITICALBrush" Color="#7F1D1D" />
    <SolidColorBrush x:Key="AlarmSeverityDefaultBrush" Color="#64748B" />
    <SolidColorBrush x:Key="AlarmStatusNEWBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AlarmStatusACKNOWLEDGEDBrush" Color="#64748B" />
    <SolidColorBrush x:Key="AlarmStatusINVESTIGATINGBrush" Color="#D97706" />
    <SolidColorBrush x:Key="AlarmStatusRESOLVEDBrush" Color="#15803D" />
    <SolidColorBrush x:Key="AlarmStatusFALSE_POSITIVEBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="AlarmStatusDefaultBrush" Color="#64748B" />
    <SolidColorBrush x:Key="AiRiskNORMALBrush" Color="#15803D" />
    <SolidColorBrush x:Key="AiRiskWATCHBrush" Color="#526377" />
    <SolidColorBrush x:Key="AiRiskMEDIUMBrush" Color="#9A3412" />
    <SolidColorBrush x:Key="AiRiskHIGHBrush" Color="#B91C1C" />
    <SolidColorBrush x:Key="AiRiskCRITICALBrush" Color="#7F1D1D" />
    <SolidColorBrush x:Key="AiRiskDefaultBrush" Color="#64748B" />
    <Thickness x:Key="PageContentMargin">30,28</Thickness>
    <Thickness x:Key="PageHeaderMargin">30,0</Thickness>
    <Thickness x:Key="CardPadding">20</Thickness>
    <Thickness x:Key="ControlPadding">12,7</Thickness>
    <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">16</CornerRadius>
    <DropShadowEffect x:Key="CardShadowEffect" BlurRadius="22" ShadowDepth="8" Opacity="0.32" Color="#000000" />
    <DropShadowEffect x:Key="AccentGlowEffect" BlurRadius="18" ShadowDepth="0" Opacity="0.28" Color="#1598D0" />
    <converters:AlarmSeverityToBrushConverter x:Key="AlarmSeverityToBrushConverter" />
    <converters:AlarmStatusToBrushConverter x:Key="AlarmStatusToBrushConverter" />
    <converters:AiRiskLevelToBrushConverter x:Key="AiRiskLevelToBrushConverter" />
    <Style TargetType="Window">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="SidebarButtonStyle" TargetType="Button">
        <Setter Property="Margin" Value="12,2" /><Setter Property="Padding" Value="12,9" />
        <Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="40" /><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="Medium" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" /><Setter Property="TextOptions.TextRenderingMode" Value="ClearType" /><Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="NavSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextElement.Foreground="{TemplateBinding Foreground}" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="{DynamicResource RowHoverBrush}" /><Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="{DynamicResource AccentSoftBrush}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="DashboardCardStyle" TargetType="Border">
        <Setter Property="Margin" Value="8" /><Setter Property="Padding" Value="{DynamicResource CardPadding}" />
        <Setter Property="Background" Value="{DynamicResource CardBrush}" /><Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" /><Setter Property="BorderThickness" Value="1" />
        <Setter Property="Effect" Value="{StaticResource CardShadowEffect}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource AppForegroundBrush}" />
    </Style>
    <Style x:Key="KpiCardStyle" TargetType="Border" BasedOn="{StaticResource DashboardCardStyle}">
        <Setter Property="MinWidth" Value="190" /><Setter Property="MinHeight" Value="122" />
        <Setter Property="Padding" Value="20" /><Setter Property="Margin" Value="0,0,16,16" />
    </Style>
    <Style x:Key="SectionCardStyle" TargetType="Border" BasedOn="{StaticResource DashboardCardStyle}">
        <Setter Property="Margin" Value="0,0,0,22" /><Setter Property="Padding" Value="22" />
    </Style>
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="TextOptions.TextFormattingMode" Value="Display" /><Setter Property="TextOptions.TextRenderingMode" Value="ClearType" /><Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
    </Style>
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="19" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="TextOptions.TextFormattingMode" Value="Display" /><Setter Property="TextOptions.TextRenderingMode" Value="ClearType" /><Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
    </Style>
    <Style x:Key="AlarmBadgeStyle" TargetType="Border">
        <Setter Property="Padding" Value="8,4" /><Setter Property="CornerRadius" Value="12" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppForegroundBrush}" />
    </Style>
    <Style x:Key="HeaderRoleBadgeStyle" TargetType="Border">
        <Setter Property="MinHeight" Value="28" /><Setter Property="Padding" Value="10,4" /><Setter Property="Background" Value="{DynamicResource AiAccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AiAccentBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="14" /><Setter Property="TextElement.Foreground" Value="{DynamicResource AppForegroundBrush}" /><Setter Property="TextElement.FontSize" Value="11" />
    </Style>
    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,6,0,0" /><Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" /><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="TextOptions.TextFormattingMode" Value="Display" /><Setter Property="TextOptions.TextRenderingMode" Value="ClearType" /><Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="FilterChipStyle" TargetType="Border">
        <Setter Property="Padding" Value="8,4" /><Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" /><Setter Property="TextElement.Foreground" Value="{DynamicResource MutedForegroundBrush}" /><Setter Property="TextElement.FontSize" Value="11" />
    </Style>
    <Style x:Key="ShowcaseKpiCardStyle" TargetType="Border" BasedOn="{StaticResource KpiCardStyle}">
        <Setter Property="Background" Value="{DynamicResource RaisedCardBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" /><Setter Property="Padding" Value="18" />
    </Style>
    <Style x:Key="DashboardHeroCardStyle" TargetType="Border" BasedOn="{StaticResource DashboardCardStyle}">
        <Setter Property="Background" Value="{DynamicResource RaisedCardBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}" /><Setter Property="Padding" Value="24" />
    </Style>
    <Style x:Key="DashboardTankCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="14" /><Setter Property="Margin" Value="0,0,10,0" /><Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style x:Key="DashboardPumpRowStyle" TargetType="Border">
        <Setter Property="Padding" Value="12,9" /><Setter Property="Margin" Value="0,0,0,8" /><Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style x:Key="LiveConnectionPanelStyle" TargetType="Border" BasedOn="{StaticResource DashboardHeroCardStyle}">
        <Setter Property="Margin" Value="0,20,0,0" /><Setter Property="Padding" Value="22" />
    </Style>
    <Style x:Key="LiveMetricCardStyle" TargetType="Border" BasedOn="{StaticResource DashboardCardStyle}">
        <Setter Property="Padding" Value="16" /><Setter Property="Margin" Value="0,0,14,14" /><Setter Property="MinHeight" Value="100" />
    </Style>
    <Style x:Key="LiveMonitoringStateBadgeStyle" TargetType="Border">
        <Setter Property="Padding" Value="9,4" /><Setter Property="MinHeight" Value="26" /><Setter Property="Background" Value="{DynamicResource InactiveBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="13" /><Setter Property="TextElement.Foreground" Value="{DynamicResource AppForegroundBrush}" /><Setter Property="TextElement.FontSize" Value="11" />
        <Style.Triggers><DataTrigger Binding="{Binding ConnectionState}" Value="Connected"><Setter Property="Background" Value="{DynamicResource SuccessBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SuccessForegroundBrush}"/></DataTrigger><DataTrigger Binding="{Binding ConnectionState}" Value="Connecting"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></DataTrigger><DataTrigger Binding="{Binding ConnectionState}" Value="Reconnecting"><Setter Property="Background" Value="{DynamicResource AiAccentSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AiAccentBrush}"/></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="TopologyControllerCardStyle" TargetType="Border" BasedOn="{StaticResource DashboardCardStyle}">
        <Setter Property="Margin" Value="0,0,0,20" /><Setter Property="Padding" Value="24" /><Setter Property="Background" Value="{DynamicResource RaisedCardBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style x:Key="TopologyPortCardStyle" TargetType="Border">
        <Setter Property="Margin" Value="0,0,0,16" /><Setter Property="Padding" Value="18" /><Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style x:Key="TopologyDeviceCardStyle" TargetType="Border">
        <Setter Property="Margin" Value="0,0,0,10" /><Setter Property="Padding" Value="15" /><Setter Property="Background" Value="{DynamicResource CardBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style x:Key="TopologyMicroLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" /><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="TextOptions.TextFormattingMode" Value="Display" /><Setter Property="TextOptions.TextRenderingMode" Value="ClearType" /><Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="TopologyMetricChipStyle" TargetType="Border">
        <Setter Property="Margin" Value="0,0,8,8" /><Setter Property="Padding" Value="9,6" /><Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="9" /><Setter Property="MinWidth" Value="116" />
    </Style>
    <Style x:Key="TopologyNozzleRowStyle" TargetType="Border">
        <Setter Property="Margin" Value="0,4" /><Setter Property="Padding" Value="9,6" /><Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style x:Key="PremiumFilterBarStyle" TargetType="Border" BasedOn="{StaticResource DashboardCardStyle}">
        <Setter Property="Padding" Value="16" /><Setter Property="Background" Value="{DynamicResource RaisedCardBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    </Style>
    <Style x:Key="PremiumTablePanelStyle" TargetType="Border" BasedOn="{StaticResource DashboardCardStyle}">
        <Setter Property="Padding" Value="14" /><Setter Property="Background" Value="{DynamicResource CardBrush}" />
    </Style>
    <Style x:Key="PremiumDetailPanelStyle" TargetType="Border" BasedOn="{StaticResource DashboardCardStyle}">
        <Setter Property="Padding" Value="20" /><Setter Property="Background" Value="{DynamicResource RaisedCardBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style x:Key="PremiumProfileCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="16" /><Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style x:Key="PremiumListItemCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="16" /><Setter Property="Margin" Value="0,0,0,10" /><Setter Property="Background" Value="{DynamicResource CardBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style x:Key="PremiumEmptyStateCardStyle" TargetType="Border" BasedOn="{StaticResource DashboardCardStyle}">
        <Setter Property="Padding" Value="28" /><Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
    </Style>
    <Style x:Key="PremiumFormSectionStyle" TargetType="Border">
        <Setter Property="Padding" Value="14" /><Setter Property="Margin" Value="0,0,0,12" /><Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" />
    </Style>
    <!-- Shared semantic device status treatment for the live topology. -->
    <Style x:Key="StatusBadgeStyle" TargetType="Border">
        <Setter Property="MinWidth" Value="62" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Background" Value="{DynamicResource InactiveBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppForegroundBrush}" />
        <Setter Property="TextElement.FontSize" Value="11" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="ACTIVE"><Setter Property="Background" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="ONLINE"><Setter Property="Background" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="AVAILABLE"><Setter Property="Background" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="COMPLETED"><Setter Property="Background" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="RESOLVED"><Setter Property="Background" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="NEW"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="ACKNOWLEDGED"><Setter Property="Background" Value="{DynamicResource InactiveBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="IDLE"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="WARNING"><Setter Property="Background" Value="{DynamicResource WarningBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="FAULT"><Setter Property="Background" Value="{DynamicResource DangerBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="CRITICAL"><Setter Property="Background" Value="{DynamicResource DangerBrush}" /></DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="TopologyStatusBadgeStyle" TargetType="Border" BasedOn="{StaticResource StatusBadgeStyle}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="CornerRadius" Value="13" />
    </Style>
    <Style x:Key="LiveConnectionBadgeStyle" TargetType="Border">
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="13" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding ConnectionDisplay}" Value="Connected"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
