<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:FuelMind.Desktop.Converters">
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#101820" />
    <SolidColorBrush x:Key="AppForegroundBrush" Color="#F4F7FA" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#16232E" />
    <SolidColorBrush x:Key="CardBrush" Color="#233442" />
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#B8C7D1" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#1B2A33" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#3B5362" />
    <SolidColorBrush x:Key="TableHeaderBrush" Color="#16232E" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#2B4658" />
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#145A75" />
    <SolidColorBrush x:Key="RowSelectedBorderBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#9FB0BC" />
    <SolidColorBrush x:Key="AccentBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#153C52" />
    <SolidColorBrush x:Key="AiAccentBrush" Color="#A78BFA" />
    <SolidColorBrush x:Key="AiAccentSoftBrush" Color="#33285C" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#15803D" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D97706" />
    <SolidColorBrush x:Key="DangerBrush" Color="#B91C1C" />
    <SolidColorBrush x:Key="InactiveBrush" Color="#526377" />
    <SolidColorBrush x:Key="SuccessForegroundBrush" Color="#86EFAC" />
    <SolidColorBrush x:Key="WarningForegroundBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="#FCA5A5" />
    <SolidColorBrush x:Key="AlarmSeverityLOWBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AlarmSeverityMEDIUMBrush" Color="#D97706" />
    <SolidColorBrush x:Key="AlarmSeverityHIGHBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="AlarmSeverityCRITICALBrush" Color="#7F1D1D" />
    <SolidColorBrush x:Key="AlarmSeverityDefaultBrush" Color="#64748B" />
    <SolidColorBrush x:Key="AlarmStatusNEWBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AlarmStatusACKNOWLEDGEDBrush" Color="#64748B" />
    <SolidColorBrush x:Key="AlarmStatusINVESTIGATINGBrush" Color="#D97706" />
    <SolidColorBrush x:Key="AlarmStatusRESOLVEDBrush" Color="#15803D" />
    <SolidColorBrush x:Key="AlarmStatusFALSE_POSITIVEBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="AlarmStatusDefaultBrush" Color="#64748B" />
    <SolidColorBrush x:Key="AiRiskNORMALBrush" Color="#15803D" />
    <SolidColorBrush x:Key="AiRiskWATCHBrush" Color="#526377" />
    <SolidColorBrush x:Key="AiRiskMEDIUMBrush" Color="#9A3412" />
    <SolidColorBrush x:Key="AiRiskHIGHBrush" Color="#B91C1C" />
    <SolidColorBrush x:Key="AiRiskCRITICALBrush" Color="#7F1D1D" />
    <SolidColorBrush x:Key="AiRiskDefaultBrush" Color="#64748B" />
    <Thickness x:Key="PageContentMargin">28</Thickness>
    <Thickness x:Key="PageHeaderMargin">28,0</Thickness>
    <converters:AlarmSeverityToBrushConverter x:Key="AlarmSeverityToBrushConverter" />
    <converters:AlarmStatusToBrushConverter x:Key="AlarmStatusToBrushConverter" />
    <converters:AiRiskLevelToBrushConverter x:Key="AiRiskLevelToBrushConverter" />
    <Style x:Key="SidebarButtonStyle" TargetType="Button">
        <Setter Property="Margin" Value="10,2" /><Setter Property="Padding" Value="12,7" />
        <Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Height" Value="36" />
        <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource RowHoverBrush}" /></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="DashboardCardStyle" TargetType="Border">
        <Setter Property="Margin" Value="8" /><Setter Property="Padding" Value="18" />
        <Setter Property="Background" Value="{StaticResource CardBrush}" /><Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" /><Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextElement.Foreground" Value="#F4F7FA" />
    </Style>
    <Style x:Key="KpiCardStyle" TargetType="Border" BasedOn="{StaticResource DashboardCardStyle}">
        <Setter Property="MinWidth" Value="190" /><Setter Property="MinHeight" Value="118" />
        <Setter Property="Padding" Value="18" /><Setter Property="Margin" Value="0,0,14,14" />
    </Style>
    <Style x:Key="SectionCardStyle" TargetType="Border" BasedOn="{StaticResource DashboardCardStyle}">
        <Setter Property="Margin" Value="0,0,0,20" /><Setter Property="Padding" Value="20" />
    </Style>
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30" /><Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
    </Style>
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" /><Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
    </Style>
    <Style x:Key="AlarmBadgeStyle" TargetType="Border">
        <Setter Property="Padding" Value="8,3" /><Setter Property="CornerRadius" Value="10" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppForegroundBrush}" />
    </Style>
    <!-- Shared semantic device status treatment for the live topology. -->
    <Style x:Key="StatusBadgeStyle" TargetType="Border">
        <Setter Property="MinWidth" Value="62" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Background" Value="{DynamicResource InactiveBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppForegroundBrush}" />
        <Setter Property="TextElement.FontSize" Value="11" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="ACTIVE"><Setter Property="Background" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="ONLINE"><Setter Property="Background" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="AVAILABLE"><Setter Property="Background" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="IDLE"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="WARNING"><Setter Property="Background" Value="{DynamicResource WarningBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="FAULT"><Setter Property="Background" Value="{DynamicResource DangerBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="CRITICAL"><Setter Property="Background" Value="{DynamicResource DangerBrush}" /></DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="TopologyStatusBadgeStyle" TargetType="Border" BasedOn="{StaticResource StatusBadgeStyle}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="CornerRadius" Value="13" />
    </Style>
    <Style x:Key="AlarmSidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
        <Style.Triggers><DataTrigger Binding="{Binding CurrentPageTitle}" Value="Alarm Merkezi"><Setter Property="Background" Value="#29485A" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="BorderBrush" Value="#38BDF8" /><Setter Property="BorderThickness" Value="3,0,0,0" /></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource RowHoverBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}" /><Setter Property="Opacity" Value="0.72" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="DashboardCompactActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryActionButtonStyle}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style x:Key="LiveConnectionBadgeStyle" TargetType="Border">
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="13" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding ConnectionDisplay}" Value="Connected"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
