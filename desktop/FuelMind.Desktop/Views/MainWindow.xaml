<Window x:Class="FuelMind.Desktop.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:FuelMind.Desktop.Views" xmlns:viewModels="clr-namespace:FuelMind.Desktop.ViewModels" Title="{Binding ApplicationTitle}" Width="1280" Height="820" MinWidth="1040" MinHeight="680" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <DataTemplate DataType="{x:Type viewModels:LoginViewModel}"><views:LoginView/></DataTemplate>
    <DataTemplate DataType="{x:Type viewModels:AuthenticatedShellViewModel}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="244"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid Background="{DynamicResource SidebarBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Margin="14,16,14,12" Padding="14" Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="10"><StackPanel><TextBlock FontSize="22" FontWeight="Bold" Text="FuelMind AI"/><TextBlock Margin="0,4,0,0" Foreground="{DynamicResource AiAccentBrush}" FontSize="11" Text="OPERASYON PLATFORMU"/></StackPanel></Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,0,8"><TextBlock Margin="20,4,0,6" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" Text="OPERASYON"/><Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding ShowDashboardCommand}" Content="Dashboard"/><Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding ShowLiveMonitoringCommand}" Content="Canlı İzleme"/><Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding ShowFieldTopologyCommand}" Content="Saha Topolojisi"/><Button Style="{StaticResource AlarmSidebarButtonStyle}" Command="{Binding ShowAlarmsCommand}" Content="Alarmlar"/><Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding ShowAttendantsCommand}" Content="Pompacı &amp; Vardiya"/><Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding ShowFaultsCommand}" Content="Arıza Yönetimi"/><TextBlock Margin="20,14,0,6" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" Text="TİCARİ YÖNETİM"/><Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding ShowCustomersCommand}" Content="Müşteriler"/><Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding ShowFuelCardsCommand}" Content="Kartlar"/><Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding ShowSalesCommand}" Content="Satışlar"/><Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding ShowFuelPricesCommand}" Content="Fiyat Yönetimi"/><TextBlock Margin="20,14,0,6" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" Text="ANALİTİK"/><Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding ShowForecastsCommand}" Content="Tahminler"/><Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding ShowOrdersCommand}" Content="Sipariş Önerileri"/><Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding ShowSimulatorCommand}" Content="Simülasyon"/><Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding ShowReportsCommand}" Content="Raporlar"/></StackPanel></ScrollViewer>
        <Border Grid.Row="2" Margin="14" Padding="12" Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="10"><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding CurrentUserName}"/><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding CurrentUserRole}"/><Button Margin="0,10,0,0" Style="{StaticResource SecondaryActionButtonStyle}" HorizontalAlignment="Left" Command="{Binding LogoutCommand}" Content="Çıkış Yap"/></StackPanel></Border>
      </Grid>
      <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,0,0,1"><DockPanel Margin="{DynamicResource PageHeaderMargin}"><DockPanel.Style><Style TargetType="DockPanel"><Style.Triggers><DataTrigger Binding="{Binding CurrentPageTitle}" Value="Dashboard"><Setter Property="LastChildFill" Value="False"/></DataTrigger></Style.Triggers></Style></DockPanel.Style><StackPanel VerticalAlignment="Center"><TextBlock FontSize="21" FontWeight="SemiBold" Text="{Binding CurrentPageTitle}"/><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" FontSize="12" Text="FuelMind operasyon merkezi"/></StackPanel><Border DockPanel.Dock="Right" VerticalAlignment="Center"><Border.Style><Style TargetType="Border"><Setter Property="Padding" Value="12,6"/><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="CornerRadius" Value="14"/><Style.Triggers><DataTrigger Binding="{Binding CurrentPageTitle}" Value="Dashboard"><Setter Property="MinHeight" Value="26"/><Setter Property="Padding" Value="8,3"/><Setter Property="CornerRadius" Value="13"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="TextElement.FontSize" Value="11"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding CurrentUserRole}"/></Border></DockPanel></Border><ContentControl Grid.Row="1" Content="{Binding CurrentPage}"/></Grid>
    </Grid></DataTemplate>
    <DataTemplate DataType="{x:Type viewModels:ReportsViewModel}"><views:ReportsView/></DataTemplate><DataTemplate DataType="{x:Type viewModels:DashboardViewModel}"><views:DashboardView/></DataTemplate><DataTemplate DataType="{x:Type viewModels:LiveMonitoringViewModel}"><views:LiveMonitoringView/></DataTemplate><DataTemplate DataType="{x:Type viewModels:FieldTopologyViewModel}"><views:FieldTopologyView/></DataTemplate><DataTemplate DataType="{x:Type viewModels:TanksViewModel}"><views:TanksView/></DataTemplate><DataTemplate DataType="{x:Type viewModels:PumpsViewModel}"><views:PumpsView/></DataTemplate><DataTemplate DataType="{x:Type viewModels:SimulatorViewModel}"><views:SimulatorView/></DataTemplate><DataTemplate DataType="{x:Type viewModels:AlarmsViewModel}"><views:AlarmsView/></DataTemplate><DataTemplate DataType="{x:Type viewModels:EndOfDayAlarmReportViewModel}"><views:EndOfDayAlarmReportView/></DataTemplate><DataTemplate DataType="{x:Type viewModels:ModelManagementViewModel}"><views:ModelManagementView/></DataTemplate><DataTemplate DataType="{x:Type viewModels:TankDetailViewModel}"><views:TankDetailView/></DataTemplate><DataTemplate DataType="{x:Type viewModels:PumpDetailViewModel}"><views:PumpDetailView/></DataTemplate><DataTemplate DataType="{x:Type viewModels:CustomersViewModel}"><views:CustomersView/></DataTemplate><DataTemplate DataType="{x:Type viewModels:FuelCardsViewModel}"><views:FuelCardsView/></DataTemplate><DataTemplate DataType="{x:Type viewModels:FuelPricesViewModel}"><views:FuelPricesView/></DataTemplate><DataTemplate DataType="{x:Type viewModels:SalesHistoryViewModel}"><views:SalesHistoryView/></DataTemplate><DataTemplate DataType="{x:Type viewModels:PlaceholderPageViewModel}"><views:PlaceholderView/></DataTemplate>
  <DataTemplate DataType="{x:Type viewModels:AttendantsViewModel}"><views:AttendantsView/></DataTemplate><DataTemplate DataType="{x:Type viewModels:FaultsViewModel}"><views:FaultsView/></DataTemplate></Window.Resources><Grid Background="{DynamicResource AppBackgroundBrush}"><ContentControl Content="{Binding CurrentViewModel}"/></Grid>
</Window>
