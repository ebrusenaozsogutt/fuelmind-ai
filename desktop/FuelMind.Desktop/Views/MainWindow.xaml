<Window x:Class="FuelMind.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FuelMind.Desktop.Views"
        xmlns:viewModels="clr-namespace:FuelMind.Desktop.ViewModels"
        Title="{Binding ApplicationTitle}" Width="1280" Height="820" MinWidth="1040" MinHeight="680" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">
  <Window.Resources>
    <DataTemplate DataType="{x:Type viewModels:ForecastsViewModel}"><views:ForecastsView/></DataTemplate>
    <DataTemplate DataType="{x:Type viewModels:OrdersViewModel}"><views:OrdersView/></DataTemplate>
    <DataTemplate DataType="{x:Type viewModels:LoginViewModel}"><views:LoginView/></DataTemplate>
    <Style x:Key="SidebarDashboardStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPageTitle}" Value="Dashboard"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style>
    <Style x:Key="SidebarLiveStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPageTitle}" Value="Canlı İzleme"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style>
    <Style x:Key="SidebarTopologyStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPageTitle}" Value="Saha Topolojisi"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style>
    <Style x:Key="SidebarAlarmsStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPageTitle}" Value="Alarm Merkezi"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style>
    <Style x:Key="SidebarAttendantsStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPageTitle}" Value="Pompacı &amp; Vardiya"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style>
    <Style x:Key="SidebarFaultsStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPageTitle}" Value="Arıza Yönetimi"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style>
    <Style x:Key="SidebarCustomersStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPageTitle}" Value="Müşteriler"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style>
    <Style x:Key="SidebarCardsStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPageTitle}" Value="Kartlar"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style>
    <Style x:Key="SidebarSalesStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPageTitle}" Value="Satışlar"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style>
    <Style x:Key="SidebarPricesStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPageTitle}" Value="Fiyat Yönetimi"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style>
    <Style x:Key="SidebarForecastsStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPageTitle}" Value="Tahminler"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style>
    <Style x:Key="SidebarOrdersStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPageTitle}" Value="Sipariş Önerileri"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style>
    <Style x:Key="SidebarSimulatorStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPageTitle}" Value="Simülatör"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style>
    <Style x:Key="SidebarReportsStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPageTitle}" Value="Raporlar"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style>

    <DataTemplate DataType="{x:Type viewModels:AuthenticatedShellViewModel}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,1,0">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Margin="16,18,16,14" Padding="12" Background="{DynamicResource RaisedCardBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="14">
              <StackPanel Orientation="Horizontal"><Border Width="34" Height="34" VerticalAlignment="Center" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="10" Effect="{StaticResource AccentGlowEffect}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Text="FM"/></Border><StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock FontSize="17" FontWeight="SemiBold" Text="FuelMind AI"/><TextBlock Margin="0,2,0,0" Foreground="{DynamicResource AiAccentBrush}" FontSize="10" Text="CONTROL CENTER"/></StackPanel></StackPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="0,0,0,14">
                <TextBlock Margin="24,8,0,7" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="10" FontWeight="SemiBold" Text="OPERASYON"/>
                <Button Style="{StaticResource SidebarDashboardStyle}" Command="{Binding ShowDashboardCommand}"><StackPanel Orientation="Horizontal"><TextBlock Width="22" FontFamily="Segoe UI Symbol" Foreground="{DynamicResource AccentBrush}" Text="◈"/><TextBlock Text="Dashboard"/></StackPanel></Button>
                <Button Style="{StaticResource SidebarLiveStyle}" Command="{Binding ShowLiveMonitoringCommand}"><StackPanel Orientation="Horizontal"><TextBlock Width="22" FontFamily="Segoe UI Symbol" Foreground="{DynamicResource AccentBrush}" Text="◉"/><TextBlock Text="Canlı İzleme"/></StackPanel></Button>
                <Button Style="{StaticResource SidebarTopologyStyle}" Command="{Binding ShowFieldTopologyCommand}"><StackPanel Orientation="Horizontal"><TextBlock Width="22" FontFamily="Segoe UI Symbol" Foreground="{DynamicResource AccentBrush}" Text="⌘"/><TextBlock Text="Saha Topolojisi"/></StackPanel></Button>
                <Button Style="{StaticResource SidebarAlarmsStyle}" Command="{Binding ShowAlarmsCommand}"><StackPanel Orientation="Horizontal"><TextBlock Width="22" Foreground="{DynamicResource DangerForegroundBrush}" Text="!"/><TextBlock Text="Alarmlar"/></StackPanel></Button>
                <Button Style="{StaticResource SidebarAttendantsStyle}" Command="{Binding ShowAttendantsCommand}"><StackPanel Orientation="Horizontal"><TextBlock Width="22" Foreground="{DynamicResource AccentBrush}" Text="◌"/><TextBlock Text="Pompacı &amp; Vardiya"/></StackPanel></Button>
                <Button Style="{StaticResource SidebarFaultsStyle}" Command="{Binding ShowFaultsCommand}"><StackPanel Orientation="Horizontal"><TextBlock Width="22" Foreground="{DynamicResource WarningForegroundBrush}" Text="◇"/><TextBlock Text="Arıza Yönetimi"/></StackPanel></Button>
                <TextBlock Margin="24,20,0,7" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="10" FontWeight="SemiBold" Text="TİCARİ YÖNETİM"/>
                <Button Style="{StaticResource SidebarCustomersStyle}" Command="{Binding ShowCustomersCommand}"><StackPanel Orientation="Horizontal"><TextBlock Width="22" Foreground="{DynamicResource AiAccentBrush}" Text="◒"/><TextBlock Text="Müşteriler"/></StackPanel></Button>
                <Button Style="{StaticResource SidebarCardsStyle}" Command="{Binding ShowFuelCardsCommand}"><StackPanel Orientation="Horizontal"><TextBlock Width="22" Foreground="{DynamicResource AiAccentBrush}" Text="▣"/><TextBlock Text="Kartlar"/></StackPanel></Button>
                <Button Style="{StaticResource SidebarSalesStyle}" Command="{Binding ShowSalesCommand}"><StackPanel Orientation="Horizontal"><TextBlock Width="22" Foreground="{DynamicResource AiAccentBrush}" Text="↗"/><TextBlock Text="Satışlar"/></StackPanel></Button>
                <Button Style="{StaticResource SidebarPricesStyle}" Command="{Binding ShowFuelPricesCommand}"><StackPanel Orientation="Horizontal"><TextBlock Width="22" Foreground="{DynamicResource AiAccentBrush}" Text="₺"/><TextBlock Text="Fiyat Yönetimi"/></StackPanel></Button>
                <TextBlock Margin="24,20,0,7" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="10" FontWeight="SemiBold" Text="ANALİTİK"/>
                <Button Style="{StaticResource SidebarForecastsStyle}" Command="{Binding ShowForecastsCommand}"><StackPanel Orientation="Horizontal"><TextBlock Width="22" Foreground="{DynamicResource AccentBrush}" Text="⌁"/><TextBlock Text="Tahminler"/></StackPanel></Button>
                <Button Style="{StaticResource SidebarOrdersStyle}" Command="{Binding ShowOrdersCommand}"><StackPanel Orientation="Horizontal"><TextBlock Width="22" Foreground="{DynamicResource AccentBrush}" Text="✦"/><TextBlock Text="Sipariş Önerileri"/></StackPanel></Button>
                <Button Style="{StaticResource SidebarSimulatorStyle}" Command="{Binding ShowSimulatorCommand}"><StackPanel Orientation="Horizontal"><TextBlock Width="22" Foreground="{DynamicResource AccentBrush}" Text="◫"/><TextBlock Text="Simülasyon"/></StackPanel></Button>
                <Button Style="{StaticResource SidebarReportsStyle}" Command="{Binding ShowReportsCommand}"><StackPanel Orientation="Horizontal"><TextBlock Width="22" Foreground="{DynamicResource AccentBrush}" Text="▤"/><TextBlock Text="Raporlar"/></StackPanel></Button>
              </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" Margin="16,10,16,16" Padding="12" Background="{DynamicResource RaisedCardBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="14">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="30" Height="30" VerticalAlignment="Top" Background="{DynamicResource AiAccentSoftBrush}" CornerRadius="9"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AiAccentBrush}" Text="U"/></Border><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock FontWeight="SemiBold" Text="{Binding CurrentUserName}" TextTrimming="CharacterEllipsis"/><TextBlock Margin="0,2,0,7" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" Text="{Binding CurrentUserRole}"/><Button Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left" MinHeight="28" Padding="8,3" Command="{Binding LogoutCommand}" Content="Oturumu kapat"/></StackPanel></Grid>
            </Border>
          </Grid>
        </Border>
        <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1"><DockPanel Margin="{DynamicResource PageHeaderMargin}" LastChildFill="False"><StackPanel VerticalAlignment="Center"><TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding CurrentPageTitle}"/><TextBlock Margin="0,2,0,0" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" Text="FuelMind operasyon kontrol merkezi"/></StackPanel><Border DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource HeaderRoleBadgeStyle}"><StackPanel Orientation="Horizontal"><TextBlock Foreground="{DynamicResource AiAccentBrush}" Text="●"/><TextBlock Margin="5,0,0,0" FontWeight="SemiBold" Text="{Binding CurrentUserRole}"/></StackPanel></Border></DockPanel></Border><ContentControl Grid.Row="1" Content="{Binding CurrentPage}"/></Grid>
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewModels:ReportsViewModel}"><views:ReportsView/></DataTemplate><DataTemplate DataType="{x:Type viewModels:DashboardViewModel}"><views:DashboardView/></DataTemplate><DataTemplate DataType="{x:Type viewModels:LiveMonitoringViewModel}"><views:LiveMonitoringView/></DataTemplate><DataTemplate DataType="{x:Type viewModels:FieldTopologyViewModel}"><views:FieldTopologyView/></DataTemplate><DataTemplate DataType="{x:Type viewModels:TanksViewModel}"><views:TanksView/></DataTemplate><DataTemplate DataType="{x:Type viewModels:PumpsViewModel}"><views:PumpsView/></DataTemplate><DataTemplate DataType="{x:Type viewModels:SimulatorViewModel}"><views:SimulatorView/></DataTemplate><DataTemplate DataType="{x:Type viewModels:AlarmsViewModel}"><views:AlarmsView/></DataTemplate><DataTemplate DataType="{x:Type viewModels:EndOfDayAlarmReportViewModel}"><views:EndOfDayAlarmReportView/></DataTemplate><DataTemplate DataType="{x:Type viewModels:ModelManagementViewModel}"><views:ModelManagementView/></DataTemplate><DataTemplate DataType="{x:Type viewModels:TankDetailViewModel}"><views:TankDetailView/></DataTemplate><DataTemplate DataType="{x:Type viewModels:PumpDetailViewModel}"><views:PumpDetailView/></DataTemplate><DataTemplate DataType="{x:Type viewModels:CustomersViewModel}"><views:CustomersView/></DataTemplate><DataTemplate DataType="{x:Type viewModels:FuelCardsViewModel}"><views:FuelCardsView/></DataTemplate><DataTemplate DataType="{x:Type viewModels:FuelPricesViewModel}"><views:FuelPricesView/></DataTemplate><DataTemplate DataType="{x:Type viewModels:SalesHistoryViewModel}"><views:SalesHistoryView/></DataTemplate><DataTemplate DataType="{x:Type viewModels:PlaceholderPageViewModel}"><views:PlaceholderView/></DataTemplate><DataTemplate DataType="{x:Type viewModels:AttendantsViewModel}"><views:AttendantsView/></DataTemplate><DataTemplate DataType="{x:Type viewModels:FaultsViewModel}"><views:FaultsView/></DataTemplate>
  </Window.Resources>
  <Grid Background="{DynamicResource AppBackgroundBrush}"><ContentControl Content="{Binding CurrentViewModel}"/></Grid>
</Window>
