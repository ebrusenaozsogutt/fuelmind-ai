<Window x:Class="FuelMind.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FuelMind.Desktop.Views"
        xmlns:viewModels="clr-namespace:FuelMind.Desktop.ViewModels"
        Title="{Binding ApplicationTitle}"
        Width="1100"
        Height="700"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <DataTemplate DataType="{x:Type viewModels:LoginViewModel}">
            <views:LoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:AuthenticatedShellViewModel}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0" Background="{DynamicResource SidebarBrush}"><StackPanel DockPanel.Dock="Top"><TextBlock Margin="18,20,18,24" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AppForegroundBrush}" Text="FuelMind AI"/><Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding ShowDashboardCommand}" Content="Dashboard"/><Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding ShowLiveMonitoringCommand}" Content="Canlı İzleme"/><Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding ShowTanksCommand}" Content="Tanklar"/><Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding ShowPumpsCommand}" Content="Pompalar"/><Button Style="{StaticResource AlarmSidebarButtonStyle}" Command="{Binding ShowAlarmsCommand}" Content="Alarmlar"/><Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding ShowForecastsCommand}" Content="Tahminler"/><Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding ShowOrdersCommand}" Content="Sipariş Önerileri"/><Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding ShowSimulatorCommand}" Content="Simülasyon"/><Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding ShowReportsCommand}" Content="Raporlar"/><Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding ShowModelManagementCommand}" Content="Model Yönetimi"/><Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding ShowSettingsCommand}" Content="Ayarlar"/></StackPanel><StackPanel DockPanel.Dock="Bottom" Margin="12"><TextBlock Foreground="{DynamicResource AppForegroundBrush}" Text="{Binding CurrentUserName}"/><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding CurrentUserRole}"/><Button Margin="0,12,0,0" Command="{Binding LogoutCommand}" Content="Çıkış Yap"/></StackPanel></DockPanel>
                <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="{DynamicResource CardBrush}"><DockPanel Margin="24,0"><TextBlock VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AppForegroundBrush}" Text="{Binding CurrentPageTitle}"/><TextBlock DockPanel.Dock="Right" Margin="24,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding CurrentUserRole}"/></DockPanel></Border><ContentControl Grid.Row="1" Content="{Binding CurrentPage}"/></Grid>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}"><views:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:LiveMonitoringViewModel}"><views:LiveMonitoringView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:TanksViewModel}"><views:TanksView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:PumpsViewModel}"><views:PumpsView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SimulatorViewModel}"><views:SimulatorView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:AlarmsViewModel}"><views:AlarmsView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ModelManagementViewModel}"><views:ModelManagementView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:TankDetailViewModel}"><views:TankDetailView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:PumpDetailViewModel}"><views:PumpDetailView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:PlaceholderPageViewModel}"><views:PlaceholderView /></DataTemplate>
    </Window.Resources>
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <ContentControl Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>
