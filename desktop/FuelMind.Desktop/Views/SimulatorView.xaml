<UserControl x:Class="FuelMind.Desktop.Views.SimulatorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
        <TextBlock FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource AppForegroundBrush}" Text="Simülatör" />
        <Border Margin="0,20,0,0" Padding="18" Background="{DynamicResource CardBrush}" BorderBrush="#3B5362" BorderThickness="1" CornerRadius="6"><StackPanel>
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Simülasyon ayarları" />
            <UniformGrid Margin="0,16,0,0" Columns="2">
                <StackPanel Margin="0,0,16,12"><TextBlock Foreground="#B8C7D1" Text="Station ID" /><TextBox Margin="0,6,0,0" Text="{Binding StationId, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                <StackPanel Margin="0,0,0,12"><TextBlock Foreground="#B8C7D1" Text="Tick interval (ms)" /><TextBox Margin="0,6,0,0" Text="{Binding TickIntervalMilliseconds, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                <StackPanel Margin="0,0,16,12"><TextBlock Foreground="#B8C7D1" Text="Simulation step (seconds)" /><TextBox Margin="0,6,0,0" Text="{Binding SimulationStepSeconds, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                <StackPanel Margin="0,0,0,12"><TextBlock Foreground="#B8C7D1" Text="Speed multiplier" /><TextBox Margin="0,6,0,0" Text="{Binding SpeedMultiplier, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                <StackPanel Margin="0,0,16,0"><TextBlock Foreground="#B8C7D1" Text="Random seed" /><TextBox Margin="0,6,0,0" Text="{Binding RandomSeed, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                <StackPanel><TextBlock Foreground="#B8C7D1" Text="Persist every N ticks" /><TextBox Margin="0,6,0,0" Text="{Binding PersistEveryNTicks, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
            </UniformGrid>
            <TextBlock Margin="0,12,0,0" Foreground="#B8C7D1" Text="Mode: REALTIME" />
            <Button Margin="0,12,0,0" Padding="14,7" HorizontalAlignment="Left" Command="{Binding PrepareDemoStockCommand}" Content="Demo Stoklarını Hazırla" />
            <TextBlock Margin="0,8,0,0" Foreground="#B8C7D1" Text="{Binding StockPreparationResult}" TextWrapping="Wrap" />
            <Button Margin="0,16,0,0" Padding="14,7" HorizontalAlignment="Left" Command="{Binding CreateSimulationCommand}" Content="Yeni Simülasyon Oluştur" />
        </StackPanel></Border>
        <Border Margin="0,20,0,0" Padding="18" Background="{DynamicResource CardBrush}" BorderBrush="#3B5362" BorderThickness="1" CornerRadius="6"><StackPanel>
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Oluşturulan run" />
            <UniformGrid Margin="0,16,0,0" Columns="3">
                <StackPanel Margin="0,0,12,12"><TextBlock Foreground="#B8C7D1" Text="Run ID" /><TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding RunId, TargetNullValue=--}" /></StackPanel>
                <StackPanel Margin="0,0,12,12"><TextBlock Foreground="#B8C7D1" Text="Station" /><TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding RunStationId, TargetNullValue=--}" /></StackPanel>
                <StackPanel Margin="0,0,0,12"><TextBlock Foreground="#B8C7D1" Text="Mode / Status" /><TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Mode}" /><TextBlock Text="{Binding Status}" /></StackPanel>
                <StackPanel Margin="0,0,12,0"><TextBlock Foreground="#B8C7D1" Text="Sequence" /><TextBlock Text="{Binding SequenceNumber, TargetNullValue=--}" /></StackPanel>
                <StackPanel Grid.ColumnSpan="2"><TextBlock Foreground="#B8C7D1" Text="Simulation time" /><TextBlock Text="{Binding CurrentSimulationTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}, TargetNullValue=--}" /></StackPanel>
            </UniformGrid>
            <Border Margin="0,16,0,0" Padding="12" Background="#1B2A33" BorderBrush="#3B5362" BorderThickness="1" CornerRadius="4"><StackPanel>
                <TextBlock FontWeight="SemiBold" Text="Aktif run (backend)" />
                <UniformGrid Margin="0,8,0,0" Columns="5">
                    <StackPanel><TextBlock Foreground="#B8C7D1" Text="Run ID" /><TextBlock Text="{Binding ActiveRunId, TargetNullValue=--}" /></StackPanel>
                    <StackPanel><TextBlock Foreground="#B8C7D1" Text="Status" /><TextBlock Text="{Binding ActiveRunStatus}" /></StackPanel>
                    <StackPanel><TextBlock Foreground="#B8C7D1" Text="Station" /><TextBlock Text="{Binding ActiveRunStationId, TargetNullValue=--}" /></StackPanel>
                    <StackPanel><TextBlock Foreground="#B8C7D1" Text="Sequence" /><TextBlock Text="{Binding ActiveRunSequenceNumber, TargetNullValue=--}" /></StackPanel>
                    <StackPanel><TextBlock Foreground="#B8C7D1" Text="Simulation time" /><TextBlock Text="{Binding ActiveRunSimulationTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}, TargetNullValue=--}" /></StackPanel>
                </UniformGrid>
            </StackPanel></Border>
            <TextBlock Margin="0,8,0,0" Foreground="#FFCF8A" Text="{Binding StartAvailabilityMessage}" />
            <TextBlock Margin="0,16,0,0" FontWeight="SemiBold" Text="Lifecycle controls" />
            <StackPanel Margin="0,10,0,0" Orientation="Horizontal"><Button Padding="14,7" Command="{Binding StartCommand}" Content="Başlat" /><Button Margin="10,0,0,0" Padding="14,7" Command="{Binding PauseCommand}" Content="Duraklat" /><Button Margin="10,0,0,0" Padding="14,7" Command="{Binding ResumeCommand}" Content="Devam Et" /><Button Margin="10,0,0,0" Padding="14,7" Command="{Binding StopCommand}" Content="Durdur" /></StackPanel>
            <TextBlock Margin="0,14,0,0" Foreground="#FFB4B4" Text="{Binding LastError}" TextWrapping="Wrap" />
        </StackPanel></Border>
    </StackPanel></ScrollViewer>
</UserControl>
