<UserControl x:Class="FuelMind.Desktop.Views.SimulatorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="{DynamicResource PageContentMargin}"><TextBlock Style="{StaticResource PageTitleStyle}" Text="Simülatör"/><TextBlock Style="{StaticResource PageSubtitleStyle}" Text="Gerçek zamanlı istasyon senaryolarını hazırlayın, çalıştırın ve yaşam döngüsünü yönetin."/>
    <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource PremiumDetailPanelStyle}" Margin="0,0,12,0"><StackPanel><Border HorizontalAlignment="Left" Style="{StaticResource FilterChipStyle}"><TextBlock Text="SİMÜLASYON AYARLARI"/></Border><UniformGrid Margin="0,16,0,0" Columns="2"><StackPanel Margin="0,0,14,12"><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="STATION ID"/><TextBox Margin="0,5,0,0" Text="{Binding StationId, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,0,0,12"><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="TICK INTERVAL (MS)"/><TextBox Margin="0,5,0,0" Text="{Binding TickIntervalMilliseconds, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,0,14,12"><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="SIMULATION STEP (S)"/><TextBox Margin="0,5,0,0" Text="{Binding SimulationStepSeconds, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,0,0,12"><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="SPEED MULTIPLIER"/><TextBox Margin="0,5,0,0" Text="{Binding SpeedMultiplier, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,0,14,0"><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="RANDOM SEED"/><TextBox Margin="0,5,0,0" Text="{Binding RandomSeed, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="PERSIST EVERY N TICKS"/><TextBox Margin="0,5,0,0" Text="{Binding PersistEveryNTicks, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></UniformGrid><WrapPanel Margin="0,16,0,0"><Button Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding PrepareDemoStockCommand}" Content="Demo Stoklarını Hazırla"/><Button Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CreateSimulationCommand}" Content="Yeni Simülasyon Başlat"/></WrapPanel><TextBlock Margin="0,10,0,0" Foreground="{DynamicResource SuccessForegroundBrush}" Text="{Binding StockPreparationResult}" TextWrapping="Wrap"/></StackPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource DashboardHeroCardStyle}" Margin="12,0,0,0"><StackPanel><Border HorizontalAlignment="Left" Style="{StaticResource FilterChipStyle}"><TextBlock Text="OLUŞTURULAN RUN"/></Border><UniformGrid Margin="0,16,0,0" Columns="3"><StackPanel><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="RUN ID"/><TextBlock Margin="0,4,0,0" FontSize="20" FontWeight="SemiBold" Text="{Binding RunId, TargetNullValue=--}"/></StackPanel><StackPanel><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="STATION"/><TextBlock Margin="0,4,0,0" FontSize="20" FontWeight="SemiBold" Text="{Binding RunStationId, TargetNullValue=--}"/></StackPanel><StackPanel><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="MODE / STATUS"/><TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Text="{Binding Mode}"/><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding Status}"/></StackPanel></UniformGrid><Border Margin="0,18,0,0" Style="{StaticResource PremiumProfileCardStyle}"><UniformGrid Columns="3"><StackPanel><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="SEQUENCE"/><TextBlock Margin="0,4,0,0" Text="{Binding SequenceNumber, TargetNullValue=--}"/></StackPanel><StackPanel><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="SIMULATION TIME"/><TextBlock Margin="0,4,0,0" Text="{Binding CurrentSimulationTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}, TargetNullValue=--}"/></StackPanel><StackPanel><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="MODE"/><TextBlock Margin="0,4,0,0" Text="REALTIME"/></StackPanel></UniformGrid></Border></StackPanel></Border>
    </Grid>
    <Border Margin="0,20,0,0" Style="{StaticResource PremiumTablePanelStyle}"><StackPanel><DockPanel LastChildFill="False"><StackPanel><TextBlock Style="{StaticResource SectionTitleStyle}" Text="Aktif Run"/><TextBlock Margin="0,3,0,0" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" Text="Backend tarafından tutulan canlı çalıştırma kaydı"/></StackPanel><Border DockPanel.Dock="Right" Style="{StaticResource StatusBadgeStyle}"><TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{Binding ActiveRunStatus}"/></Border></DockPanel><UniformGrid Margin="0,16,0,0" Columns="5"><StackPanel><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="RUN ID"/><TextBlock Margin="0,4,0,0" Text="{Binding ActiveRunId, TargetNullValue=--}"/></StackPanel><StackPanel><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="STATION"/><TextBlock Margin="0,4,0,0" Text="{Binding ActiveRunStationId, TargetNullValue=--}"/></StackPanel><StackPanel><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="SEQUENCE"/><TextBlock Margin="0,4,0,0" Text="{Binding ActiveRunSequenceNumber, TargetNullValue=--}"/></StackPanel><StackPanel><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="SIMULATION TIME"/><TextBlock Margin="0,4,0,0" Text="{Binding ActiveRunSimulationTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}, TargetNullValue=--}"/></StackPanel><StackPanel><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="DURUM"/><TextBlock Margin="0,4,0,0" Text="{Binding ActiveRunStatus}"/></StackPanel></UniformGrid><TextBlock Margin="0,14,0,0" Foreground="{DynamicResource WarningForegroundBrush}" Text="{Binding StartAvailabilityMessage}"/><WrapPanel Margin="0,16,0,0"><Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StartCommand}" Content="Başlat"/><Button Margin="8,0,0,0" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding PauseCommand}" Content="Duraklat"/><Button Margin="8,0,0,0" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding ResumeCommand}" Content="Devam Et"/><Button Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding StopCommand}" Content="Durdur"/></WrapPanel><TextBlock Margin="0,12,0,0" Foreground="{DynamicResource DangerForegroundBrush}" Text="{Binding LastError}" TextWrapping="Wrap"/></StackPanel></Border>
  </StackPanel></ScrollViewer>
</UserControl>
