<UserControl x:Class="FuelMind.Desktop.Views.FuelPricesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><StackPanel Orientation="Horizontal"><TextBlock FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource AppForegroundBrush}" Text="Fiyat Yönetimi"/><Button Margin="16,0,0,0" Content="Yenile" Command="{Binding LoadCommand}"/><Button Margin="8,0,0,0" Content="Düzenle" Command="{Binding EditPriceCommand}" IsEnabled="{Binding IsAdmin}"/><Button Margin="8,0,0,0" Content="Pasifleştir" Command="{Binding DeactivatePriceCommand}" IsEnabled="{Binding IsAdmin}"/></StackPanel><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="180"/><ColumnDefinition Width="130"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="İstasyon"/><ComboBox ItemsSource="{Binding Stations}" SelectedItem="{Binding SelectedStation}" DisplayMemberPath="DisplayName"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Yakıt Türü"/><ComboBox ItemsSource="{Binding FuelTypes}" SelectedItem="{Binding SelectedFuelType}" DisplayMemberPath="DisplayName"/></StackPanel><StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="Birim Fiyat (TL/L)"/><TextBox Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="3" Margin="8,0,0,0"><TextBlock Text="Geçerlilik Başlangıcı"/><DatePicker SelectedDate="{Binding EffectiveFrom}"/></StackPanel><Button Grid.Column="4" Margin="8,22,0,0" Content="Kaydet" Command="{Binding CreatePriceCommand}" IsEnabled="{Binding IsAdmin}"/></Grid><TextBlock Foreground="IndianRed" Text="{Binding ErrorMessage}"/></StackPanel><DataGrid Grid.Row="1" Margin="0,16,0,0" AutoGenerateColumns="False" ItemsSource="{Binding Prices}" SelectedItem="{Binding SelectedPrice, Mode=TwoWay}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="İstasyon" Width="1.8*" Binding="{Binding StationDisplayName}"/><DataGridTextColumn Header="Yakıt" Width="1.3*" Binding="{Binding FuelTypeDisplayName}"/><DataGridTextColumn Header="Birim Fiyat" Width="1.2*" Binding="{Binding UnitPrice, StringFormat={}{0:N2} TL/L}"/><DataGridTextColumn Header="Başlangıç" Width="1.5*" Binding="{Binding EffectiveFrom, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/><DataGridTextColumn Header="Bitiş" Width="1.5*" Binding="{Binding EffectiveUntil, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/><DataGridCheckBoxColumn Header="Aktif" Width="0.7*" Binding="{Binding IsActive}"/></DataGrid.Columns></DataGrid></Grid></UserControl>
