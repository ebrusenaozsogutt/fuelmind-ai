<UserControl x:Class="FuelMind.Desktop.Views.FuelPricesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="{DynamicResource PageContentMargin}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel LastChildFill="False">
      <StackPanel><TextBlock Style="{StaticResource PageTitleStyle}" Text="Fiyat Yönetimi"/><TextBlock Style="{StaticResource PageSubtitleStyle}" Text="İstasyon fiyatlarını ve geçerlilik aralıklarını tek bir çalışma alanından yönetin."/></StackPanel>
      <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center"><Button Margin="0,0,8,0" Style="{StaticResource SecondaryActionButtonStyle}" Content="Yenile" Command="{Binding LoadCommand}"/><Button Margin="0,0,8,0" Style="{StaticResource SecondaryActionButtonStyle}" Content="Düzenle" Command="{Binding EditPriceCommand}" IsEnabled="{Binding IsAdmin}"/><Button Style="{StaticResource GhostButtonStyle}" Content="Pasifleştir" Command="{Binding DeactivatePriceCommand}" IsEnabled="{Binding IsAdmin}"/></WrapPanel>
    </DockPanel>
    <Border Grid.Row="1" Margin="0,18,0,16" Style="{StaticResource DashboardCardStyle}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,10,0"><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" Text="İSTASYON"/><ComboBox Margin="0,6,0,0" ItemsSource="{Binding Stations}" SelectedItem="{Binding SelectedStation}" DisplayMemberPath="DisplayName"/></StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" Text="YAKIT TÜRÜ"/><ComboBox Margin="0,6,0,0" ItemsSource="{Binding FuelTypes}" SelectedItem="{Binding SelectedFuelType}" DisplayMemberPath="DisplayName"/></StackPanel>
        <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" Text="BİRİM FİYAT"/><TextBox Margin="0,6,0,0" Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
        <StackPanel Grid.Column="3" Margin="0,0,10,0"><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" Text="GEÇERLİLİK BAŞLANGICI"/><DatePicker Margin="0,6,0,0" SelectedDate="{Binding EffectiveFrom}"/></StackPanel>
        <Button Grid.Column="4" Margin="4,22,0,0" Style="{StaticResource PrimaryButtonStyle}" Content="Kaydet" Command="{Binding CreatePriceCommand}" IsEnabled="{Binding IsAdmin}"/>
      </Grid>
    </Border>
    <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock Margin="0,0,0,8" Foreground="{DynamicResource DangerForegroundBrush}" Text="{Binding ErrorMessage}"/>
      <Border Grid.Row="1" Style="{StaticResource DashboardCardStyle}" Padding="0"><DataGrid Margin="1" AutoGenerateColumns="False" ItemsSource="{Binding Prices}" SelectedItem="{Binding SelectedPrice, Mode=TwoWay}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="İstasyon" Width="1.8*" Binding="{Binding StationDisplayName}"/><DataGridTextColumn Header="Yakıt" Width="1.3*" Binding="{Binding FuelTypeDisplayName}"/><DataGridTextColumn Header="Birim Fiyat" Width="1.2*" Binding="{Binding UnitPrice, StringFormat={}{0:N2} TL/L}"/><DataGridTextColumn Header="Başlangıç" Width="1.5*" Binding="{Binding EffectiveFrom, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/><DataGridTextColumn Header="Bitiş" Width="1.5*" Binding="{Binding EffectiveUntil, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/><DataGridCheckBoxColumn Header="Aktif" Width="0.7*" Binding="{Binding IsActive}"/></DataGrid.Columns></DataGrid></Border>
    </Grid>
  </Grid>
</UserControl>
