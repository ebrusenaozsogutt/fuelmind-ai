<UserControl x:Class="FuelMind.Desktop.Views.FieldTopologyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="TopologyStretchItemsControlStyle" TargetType="ItemsControl">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ContentPresenter">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TopologySectionColumnStyle" TargetType="StackPanel">
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" MinWidth="0">
      <StackPanel Margin="{DynamicResource PageContentMargin}" HorizontalAlignment="Stretch">
        <DockPanel LastChildFill="False">
          <StackPanel>
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Saha Topolojisi"/>
            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                       Text="Controller, port, pompa ve prob bağlantı zincirini canlı durumlarıyla inceleyin."/>
          </StackPanel>
          <Border DockPanel.Dock="Right"
                  VerticalAlignment="Center"
                  Style="{StaticResource LiveMonitoringStateBadgeStyle}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Foreground="{DynamicResource SuccessForegroundBrush}" Text="●"/>
              <TextBlock Margin="5,0,0,0" FontWeight="SemiBold" Text="{Binding ConnectionState}"/>
            </StackPanel>
          </Border>
        </DockPanel>

        <Border Margin="0,18,0,0" Padding="20" Style="{StaticResource DashboardHeroCardStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <StackPanel>
                <TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="İSTASYON SEÇİMİ"/>
                <ComboBox Width="260"
                          Margin="0,6,0,0"
                          ItemsSource="{Binding Stations}"
                          SelectedValuePath="Id"
                          DisplayMemberPath="DisplayName"
                          SelectedValue="{Binding SelectedStationId, Mode=TwoWay}"/>
              </StackPanel>
              <Button Margin="12,20,0,0"
                      Style="{StaticResource PrimaryButtonStyle}"
                      Command="{Binding RefreshCommand}"
                      Content="Topolojiyi Yenile"/>
            </StackPanel>
            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
              <TextBlock HorizontalAlignment="Right"
                         Style="{StaticResource TopologyMicroLabelStyle}"
                         Text="CANLI BAĞLANTI"/>
              <TextBlock Margin="0,5,0,0"
                         HorizontalAlignment="Right"
                         FontSize="18"
                         FontWeight="SemiBold"
                         Text="{Binding ConnectionState}"/>
            </StackPanel>
          </Grid>
        </Border>

        <TextBlock Margin="0,10,0,0"
                   Foreground="{DynamicResource DangerForegroundBrush}"
                   Text="{Binding ErrorMessage}"
                   TextWrapping="Wrap"/>

        <Border Margin="0,14,0,0"
                Padding="16"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource SubtleBorderBrush}"
                BorderThickness="1"
                CornerRadius="14">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding ShowEmptyState}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Foreground="{DynamicResource MutedForegroundBrush}"
                     Text="Bu istasyon için saha topolojisi henüz tanımlanmamış."/>
        </Border>

        <ItemsControl Margin="0,16,0,0"
                      Style="{StaticResource TopologyStretchItemsControlStyle}"
                      ItemsSource="{Binding Controllers}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Padding="16"
                      Margin="0,0,0,12"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Top"
                      Style="{StaticResource TopologyControllerCardStyle}">
                <StackPanel VerticalAlignment="Top">
                  <DockPanel LastChildFill="False">
                    <StackPanel>
                      <Border HorizontalAlignment="Left" Style="{StaticResource FilterChipStyle}">
                        <TextBlock Text="CONTROLLER"/>
                      </Border>
                      <TextBlock Margin="0,8,0,0"
                                 FontSize="20"
                                 FontWeight="SemiBold"
                                 Text="{Binding Code}"/>
                      <TextBlock Margin="0,3,0,0"
                                 Foreground="{DynamicResource MutedForegroundBrush}"
                                 Text="{Binding Name}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">
                      <TextBlock HorizontalAlignment="Right"
                                 Style="{StaticResource TopologyMicroLabelStyle}"
                                 Text="{Binding ControllerType}"/>
                      <Border Margin="0,5,0,0"
                              HorizontalAlignment="Right"
                              Style="{StaticResource TopologyStatusBadgeStyle}">
                        <TextBlock HorizontalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="{Binding Status}"/>
                      </Border>
                      <TextBlock Margin="0,5,0,0"
                                 HorizontalAlignment="Right"
                                 Foreground="{DynamicResource MutedForegroundBrush}"
                                 FontSize="11"
                                 Text="{Binding LastCommunicationAt, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}, TargetNullValue=İletişim yok}"/>
                    </StackPanel>
                  </DockPanel>

                  <Border Margin="0,12,0,8"
                          Padding="8,5"
                          Background="{DynamicResource AppBackgroundBrush}"
                          BorderBrush="{DynamicResource SubtleBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="9">
                    <TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="BAĞLI PORTLAR"/>
                  </Border>

                  <ItemsControl Style="{StaticResource TopologyStretchItemsControlStyle}"
                                ItemsSource="{Binding Ports}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Padding="14"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                Style="{StaticResource TopologyPortCardStyle}">
                          <StackPanel VerticalAlignment="Top">
                            <DockPanel LastChildFill="False">
                              <StackPanel>
                                <TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="PORT"/>
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Text="{Binding Port.PortNumber, StringFormat=PORT {0}}"/>
                                <TextBlock Margin="0,3,0,0"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           Text="{Binding PortType}"/>
                              </StackPanel>
                              <StackPanel DockPanel.Dock="Right"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Top">
                                <TextBlock HorizontalAlignment="Right"
                                           Style="{StaticResource TopologyMicroLabelStyle}"
                                           Text="{Binding Protocol}"/>
                                <Border Margin="0,5,0,0"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource TopologyStatusBadgeStyle}">
                                  <TextBlock HorizontalAlignment="Center"
                                             FontWeight="SemiBold"
                                             Text="{Binding Status}"/>
                                </Border>
                                <TextBlock Margin="0,5,0,0"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           FontSize="11"
                                           Text="{Binding Port.BaudRate, StringFormat={}{0} baud, TargetNullValue=-}"/>
                              </StackPanel>
                            </DockPanel>

                            <Grid Margin="0,10,0,0" VerticalAlignment="Top">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                              </Grid.ColumnDefinitions>

                              <StackPanel Style="{StaticResource TopologySectionColumnStyle}">
                                <Border Padding="8,5"
                                        Background="{DynamicResource AppBackgroundBrush}"
                                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9">
                                  <TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="POMPALAR"/>
                                </Border>
                                <ItemsControl Margin="0,8,0,0"
                                              Style="{StaticResource TopologyStretchItemsControlStyle}"
                                              ItemsSource="{Binding Pumps}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                      <Border Padding="10"
                                              Margin="0,0,0,6"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Top"
                                              Style="{StaticResource TopologyDeviceCardStyle}">
                                        <StackPanel VerticalAlignment="Top">
                                          <DockPanel LastChildFill="False">
                                            <StackPanel>
                                              <TextBlock FontWeight="SemiBold" Text="{Binding Code}"/>
                                              <TextBlock Margin="0,3,0,0"
                                                         Foreground="{DynamicResource MutedForegroundBrush}"
                                                         FontSize="11"
                                                         Text="{Binding TankId, StringFormat=Tank: {0}}"/>
                                            </StackPanel>
                                            <Border DockPanel.Dock="Right"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource TopologyStatusBadgeStyle}">
                                              <TextBlock HorizontalAlignment="Center"
                                                         FontWeight="SemiBold"
                                                         Text="{Binding Status}"/>
                                            </Border>
                                          </DockPanel>
                                          <ItemsControl Margin="0,8,0,0"
                                                        Style="{StaticResource TopologyStretchItemsControlStyle}"
                                                        ItemsSource="{Binding Nozzles}">
                                            <ItemsControl.ItemTemplate>
                                              <DataTemplate>
                                                <Border Style="{StaticResource TopologyNozzleRowStyle}">
                                                  <Grid>
                                                    <Grid.ColumnDefinitions>
                                                      <ColumnDefinition Width="78"/>
                                                      <ColumnDefinition Width="*"/>
                                                      <ColumnDefinition Width="Auto"/>
                                                      <ColumnDefinition Width="88"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding Nozzle.NozzleNumber, StringFormat=Tabanca {0}}"/>
                                                    <TextBlock Grid.Column="1"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding FuelType}"/>
                                                    <Border Grid.Column="2"
                                                            Margin="6,0"
                                                            Style="{StaticResource StatusBadgeStyle}">
                                                      <TextBlock HorizontalAlignment="Center"
                                                                 FontWeight="SemiBold"
                                                                 Text="{Binding Status}"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="3"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                                               Text="{Binding TotalizerLiters, StringFormat={}{0:N2} L}"/>
                                                  </Grid>
                                                </Border>
                                              </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                          </ItemsControl>
                                        </StackPanel>
                                      </Border>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>

                              <StackPanel Grid.Column="2" Style="{StaticResource TopologySectionColumnStyle}">
                                <Border Padding="8,5"
                                        Background="{DynamicResource AppBackgroundBrush}"
                                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9">
                                  <TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="TANK PROBLARI"/>
                                </Border>
                                <ItemsControl Margin="0,8,0,0"
                                              Style="{StaticResource TopologyStretchItemsControlStyle}"
                                              ItemsSource="{Binding Probes}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                      <Border Padding="10"
                                              Margin="0,0,0,6"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Top"
                                              Style="{StaticResource TopologyDeviceCardStyle}">
                                        <StackPanel VerticalAlignment="Top">
                                          <DockPanel LastChildFill="False">
                                            <StackPanel>
                                              <TextBlock FontWeight="SemiBold" Text="{Binding Code}"/>
                                              <TextBlock Margin="0,3,0,0"
                                                         Foreground="{DynamicResource MutedForegroundBrush}"
                                                         FontSize="11"
                                                         Text="{Binding TankDisplay, StringFormat=Tank: {0}}"/>
                                            </StackPanel>
                                            <Border DockPanel.Dock="Right"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource TopologyStatusBadgeStyle}">
                                              <TextBlock HorizontalAlignment="Center"
                                                         FontWeight="SemiBold"
                                                         Text="{Binding Status}"/>
                                            </Border>
                                          </DockPanel>
                                          <WrapPanel Margin="0,8,0,0"
                                                     VerticalAlignment="Top">
                                            <Border Margin="0,0,6,6" Style="{StaticResource TopologyMetricChipStyle}">
                                              <StackPanel>
                                                <TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="YAKIT"/>
                                                <TextBlock Margin="0,3,0,0" Text="{Binding Probe.FuelVolumeLiters, StringFormat={}{0:N2} L, TargetNullValue=-}"/>
                                              </StackPanel>
                                            </Border>
                                            <Border Margin="0,0,6,6" Style="{StaticResource TopologyMetricChipStyle}">
                                              <StackPanel>
                                                <TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="YÜKSEKLİK"/>
                                                <TextBlock Margin="0,3,0,0" Text="{Binding Probe.FuelHeightMm, StringFormat={}{0:N1} mm, TargetNullValue=-}"/>
                                              </StackPanel>
                                            </Border>
                                            <Border Margin="0,0,6,6" Style="{StaticResource TopologyMetricChipStyle}">
                                              <StackPanel>
                                                <TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="SU"/>
                                                <TextBlock Margin="0,3,0,0" Text="{Binding Probe.WaterVolumeLiters, StringFormat={}{0:N2} L, TargetNullValue=-}"/>
                                              </StackPanel>
                                            </Border>
                                            <Border Margin="0,0,6,6" Style="{StaticResource TopologyMetricChipStyle}">
                                              <StackPanel>
                                                <TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="SICAKLIK"/>
                                                <TextBlock Margin="0,3,0,0" Text="{Binding Probe.TemperatureCelsius, StringFormat={}{0:N1} °C, TargetNullValue=-}"/>
                                              </StackPanel>
                                            </Border>
                                            <Border Margin="0,0,6,6" Style="{StaticResource TopologyMetricChipStyle}">
                                              <StackPanel>
                                                <TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="KALİTE"/>
                                                <TextBlock Margin="0,3,0,0" Text="{Binding Probe.DataQualityScore, StringFormat=%{0:N0}, TargetNullValue=-}"/>
                                              </StackPanel>
                                            </Border>
                                          </WrapPanel>
                                          <TextBlock Margin="0,4,0,0"
                                                     Foreground="{DynamicResource MutedForegroundBrush}"
                                                     FontSize="11"
                                                     Text="{Binding Probe.ReadingTimestamp, StringFormat=Son okuma: {0:dd.MM.yyyy HH:mm:ss}, TargetNullValue=Son okuma yok}"/>
                                        </StackPanel>
                                      </Border>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </Grid>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Margin="0,2,0,20" VerticalAlignment="Top">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Margin="0,0,10,0" VerticalAlignment="Top" Style="{StaticResource DashboardCardStyle}">
            <StackPanel>
              <TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="ENVANTER KONTROLÜ"/>
              <TextBlock Margin="0,6,0,0" FontSize="17" FontWeight="SemiBold" Text="Atanmamış Pompalar"/>
              <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding UnassignedPumps}">
                <ItemsControl.Style>
                  <Style TargetType="ItemsControl">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasUnassignedPumps}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,3" Padding="8,5" Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="8">
                      <TextBlock Text="{Binding Code}"/>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="Atanmamış pompa bulunmuyor.">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasUnassignedPumps}" Value="False">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top" Style="{StaticResource DashboardCardStyle}">
            <StackPanel>
              <TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="ENVANTER KONTROLÜ"/>
              <TextBlock Margin="0,6,0,0" FontSize="17" FontWeight="SemiBold" Text="Atanmamış Problar"/>
              <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding UnassignedProbes}">
                <ItemsControl.Style>
                  <Style TargetType="ItemsControl">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasUnassignedProbes}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,3" Padding="8,5" Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="8">
                      <TextBlock Text="{Binding Code}"/>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="Atanmamış prob bulunmuyor.">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasUnassignedProbes}" Value="False">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
