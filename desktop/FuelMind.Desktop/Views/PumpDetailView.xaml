<UserControl x:Class="FuelMind.Desktop.Views.PumpDetailView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"><StackPanel Margin="28"><Button HorizontalAlignment="Left" Command="{Binding BackCommand}" Content="← Pompalara Dön"/><TextBlock Margin="0,16,0,0" FontSize="26" Text="{Binding Pump.PumpId, StringFormat=Pump ID: {0}, TargetNullValue=Canlı veri yok}"/><TextBlock Text="{Binding Pump.Status}"/><ComboBox SelectedValue="{Binding Metric}" SelectedValuePath="Content"><ComboBoxItem Content="flow_rate"/><ComboBoxItem Content="pressure"/><ComboBoxItem Content="motor_current"/><ComboBoxItem Content="temperature"/></ComboBox><UniformGrid Columns="3"><TextBlock Text="{Binding Pump.FlowRate, StringFormat=Flow: {0:N1}}"/><TextBlock Text="{Binding Pump.Pressure, StringFormat=Pressure: {0:N1}}"/><TextBlock Text="{Binding Pump.MotorCurrent, StringFormat=Current: {0:N1}}"/><TextBlock Text="{Binding Pump.Temperature, StringFormat=Temperature: {0:N1}}"/><TextBlock Text="{Binding Pump.ErrorCount, StringFormat=Errors: {0}}"/><TextBlock Text="{Binding Pump.WorkingDuration, StringFormat=Working: {0:N1}}"/></UniformGrid><lvc:CartesianChart Height="300" Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}"/></StackPanel></UserControl>
