<UserControl x:Class="FuelMind.Desktop.Views.LiveMonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FuelMind.Desktop.Controls">
  <UserControl.Resources><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/></UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="{DynamicResource PageContentMargin}">
      <DockPanel LastChildFill="False"><StackPanel><TextBlock Style="{StaticResource PageTitleStyle}" Text="Canlı İzleme"/><TextBlock Style="{StaticResource PageSubtitleStyle}" Text="WebSocket akışını, mesaj ritmini ve bağlı istasyon ekipmanını tek bakışta izleyin."/></StackPanel><Border DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource LiveMonitoringStateBadgeStyle}"><StackPanel Orientation="Horizontal"><TextBlock Foreground="{DynamicResource SuccessForegroundBrush}" Text="●"/><TextBlock Margin="5,0,0,0" FontWeight="SemiBold" Text="{Binding ConnectionState}"/></StackPanel></Border></DockPanel>

      <Border Style="{StaticResource LiveConnectionPanelStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><Border HorizontalAlignment="Left" Style="{StaticResource FilterChipStyle}"><TextBlock Text="LIVE DATA STREAM"/></Border><TextBlock Margin="0,12,0,0" FontSize="20" FontWeight="SemiBold" Text="İstasyon bağlantısı"/><TextBlock Margin="0,5,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="Bağlantı başladığında ekipman telemetrisi anlık olarak bu panele akar."/><StackPanel Margin="0,16,0,0" Orientation="Horizontal"><StackPanel><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="İSTASYON ID"/><TextBox Width="104" Margin="0,6,0,0" Text="{Binding StationId, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><Button Margin="12,20,0,0" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ConnectCommand}" Content="Bağlan"/><Button Margin="8,20,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding DisconnectCommand}" Content="Bağlantıyı Kes"/></StackPanel><TextBlock Margin="0,12,0,0" Foreground="{DynamicResource DangerForegroundBrush}" Text="{Binding LastError}" TextWrapping="Wrap"/></StackPanel><Border Grid.Column="1" Width="180" Margin="24,0,0,0" Padding="16" VerticalAlignment="Stretch" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="1" CornerRadius="12"><StackPanel><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="BAĞLI İSTASYON"/><TextBlock Margin="0,8,0,0" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="{Binding ConnectedStationId, TargetNullValue=—}"/><Separator Margin="0,14,0,10"/><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="SON SIRA"/><TextBlock Margin="0,5,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding LastSequence, TargetNullValue=—}"/></StackPanel></Border></Grid></Border>

      <WrapPanel Margin="0,18,0,4"><Border Style="{StaticResource LiveMetricCardStyle}"><StackPanel><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="BAĞLANTI DURUMU"/><TextBlock Margin="0,10,0,0" FontSize="20" FontWeight="SemiBold" Text="{Binding ConnectionState}"/></StackPanel></Border><Border Style="{StaticResource LiveMetricCardStyle}"><StackPanel><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="SON PAKET"/><TextBlock Margin="0,10,0,0" FontSize="17" FontWeight="SemiBold" Text="{Binding LastMessageAt, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}, TargetNullValue=Henüz veri yok}"/></StackPanel></Border><Border Style="{StaticResource LiveMetricCardStyle}"><StackPanel><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="SON SIRA NUMARASI"/><TextBlock Margin="0,10,0,0" FontSize="20" FontWeight="SemiBold" Text="{Binding LastSequence, TargetNullValue=Henüz veri yok}"/></StackPanel></Border><Border Style="{StaticResource LiveMetricCardStyle}"><StackPanel><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="CANLI TANKLAR"/><TextBlock Margin="0,10,0,0" FontSize="20" FontWeight="SemiBold" Text="{Binding TankCount}"/></StackPanel></Border><Border Style="{StaticResource LiveMetricCardStyle}"><StackPanel><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="CANLI POMPALAR"/><TextBlock Margin="0,10,0,0" FontSize="20" FontWeight="SemiBold" Text="{Binding PumpCount}"/></StackPanel></Border></WrapPanel>

      <Border Margin="0,10,0,0" Padding="16" Background="{DynamicResource WarningBrush}" CornerRadius="12" Visibility="{Binding HasSequenceGap, Converter={StaticResource BooleanToVisibilityConverter}}"><DockPanel LastChildFill="False"><TextBlock FontSize="18" Foreground="{DynamicResource WarningForegroundBrush}" Text="!"/><StackPanel Margin="10,0,0,0"><TextBlock FontWeight="SemiBold" Text="Sequence boşluğu algılandı"/><TextBlock Margin="0,4,0,0" Text="{Binding ExpectedSequence, StringFormat=Beklenen: {0}}"/><TextBlock Text="{Binding ReceivedSequence, StringFormat=Alınan: {0}}"/></StackPanel></DockPanel></Border>

      <Grid Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,12,22"><StackPanel><DockPanel LastChildFill="False"><StackPanel><TextBlock Style="{StaticResource SectionTitleStyle}" Text="Canlı Tanklar"/><TextBlock Margin="0,3,0,0" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" Text="Seviye ve çevresel telemetri"/></StackPanel><Border DockPanel.Dock="Right" Style="{StaticResource FilterChipStyle}"><TextBlock Text="{Binding TankCount, StringFormat={}{0} TANK}"/></Border></DockPanel><TextBlock Margin="0,14,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="Canlı tank verisi henüz mevcut değil."><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding TankCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Tanks}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><controls:TankControl Margin="0,0,12,12" Tank="{Binding}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
        <Border Grid.Column="1" Style="{StaticResource SectionCardStyle}" Margin="12,0,0,22"><StackPanel><DockPanel LastChildFill="False"><StackPanel><TextBlock Style="{StaticResource SectionTitleStyle}" Text="Canlı Pompalar"/><TextBlock Margin="0,3,0,0" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" Text="Debi, motor ve AI risk telemetrisi"/></StackPanel><Border DockPanel.Dock="Right" Style="{StaticResource FilterChipStyle}"><TextBlock Text="{Binding PumpCount, StringFormat={}{0} POMPA}"/></Border></DockPanel><TextBlock Margin="0,14,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="Canlı pompa verisi henüz mevcut değil."><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding PumpCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Pumps}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><controls:PumpControl Margin="0,0,12,12" Pump="{Binding}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
