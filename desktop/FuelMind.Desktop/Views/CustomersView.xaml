<UserControl x:Class="FuelMind.Desktop.Views.CustomersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><DockPanel><StackPanel><TextBlock Style="{StaticResource PageTitleStyle}" Text="Müşteriler ve Filo Yönetimi"/><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="Müşteri hiyerarşisi ve ticari kayıtları yönetin."/></StackPanel><WrapPanel DockPanel.Dock="Right"><Button Margin="4" Command="{Binding NewCustomerCommand}" Content="+ Yeni Müşteri" IsEnabled="{Binding IsAdmin}"/><Button Margin="4" Command="{Binding EditCustomerCommand}" Content="Düzenle" IsEnabled="{Binding IsAdmin}"/><Button Margin="4" Command="{Binding LoadCommand}" Content="Yenile"/><Button Margin="4" Command="{Binding DeactivateCustomerCommand}" Content="Pasife Al" IsEnabled="{Binding IsAdmin}"/></WrapPanel></DockPanel>
      <Border Margin="0,14,0,0" Padding="12" Background="{DynamicResource CardBrush}" CornerRadius="8"><StackPanel><TextBlock FontWeight="SemiBold" Text="Müşteri Formu"/><UniformGrid Columns="5" Margin="0,8,0,0"><StackPanel Margin="4"><TextBlock Text="Müşteri Kodu"/><TextBox Text="{Binding NewCode}"/></StackPanel><StackPanel Margin="4"><TextBlock Text="Müşteri Adı"/><TextBox Text="{Binding NewName}"/></StackPanel><StackPanel Margin="4"><TextBlock Text="Tür"/><ComboBox ItemsSource="{Binding CustomerTypes}" SelectedItem="{Binding NewCustomerType}"/></StackPanel><StackPanel Margin="4"><TextBlock Text="Sektör"/><TextBox Text="{Binding NewCustomerSector}"/></StackPanel><StackPanel Margin="4"><TextBlock Text="İskonto %"/><TextBox Text="{Binding NewCustomerDiscountRate}"/></StackPanel><StackPanel Margin="4"><TextBlock Text="Talep Durumu"/><ComboBox ItemsSource="{Binding RequestStatuses}" SelectedItem="{Binding NewCustomerRequestStatus}"/></StackPanel><StackPanel Margin="4"><TextBlock Text="Telefon"/><TextBox Text="{Binding NewCustomerPhone}"/></StackPanel><StackPanel Margin="4"><TextBlock Text="E-posta"/><TextBox Text="{Binding NewCustomerEmail}"/></StackPanel><StackPanel Margin="4"><TextBlock Text="Vergi No"/><TextBox Text="{Binding NewCustomerTaxNumber}"/></StackPanel><StackPanel Margin="4"><TextBlock Text="Vergi Dairesi"/><TextBox Text="{Binding NewCustomerTaxOffice}"/></StackPanel></UniformGrid><Button Margin="4" HorizontalAlignment="Left" Command="{Binding CreateCustomerCommand}" Content="Müşteriyi Kaydet" IsEnabled="{Binding IsAdmin}"/></StackPanel></Border><TextBlock Foreground="{DynamicResource DangerForegroundBrush}" Text="{Binding ErrorMessage}"/></StackPanel>
    <Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <DataGrid AutoGenerateColumns="False" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Kod" Binding="{Binding Code}"/><DataGridTextColumn Header="Müşteri" Binding="{Binding Name}"/><DataGridTextColumn Header="Tür" Binding="{Binding CustomerType}"/><DataGridTextColumn Header="İskonto" Binding="{Binding DiscountRate, StringFormat={}{0:N2}%}"/><DataGridCheckBoxColumn Header="Aktif" Binding="{Binding IsActive}"/></DataGrid.Columns></DataGrid>
      <Border Grid.Column="1" Margin="14,0,0,0" Padding="12" Background="{DynamicResource CardBrush}" CornerRadius="8"><ScrollViewer VerticalScrollBarVisibility="Auto"><TabControl Style="{StaticResource CommercialTabControlStyle}">
        <TabItem Header="Yetkililer"><StackPanel Margin="8"><TextBlock FontWeight="SemiBold" Text="Yetkili Ekle / Düzenle"/><UniformGrid Columns="2"><StackPanel Margin="4"><TextBlock Text="Ad Soyad"/><TextBox Text="{Binding NewAuthorizedPersonName}"/></StackPanel><StackPanel Margin="4"><TextBlock Text="Unvan"/><TextBox Text="{Binding NewAuthorizedPersonTitle}"/></StackPanel><StackPanel Margin="4"><TextBlock Text="Telefon"/><TextBox Text="{Binding NewAuthorizedPersonPhone}"/></StackPanel><StackPanel Margin="4"><TextBlock Text="E-posta"/><TextBox Text="{Binding NewAuthorizedPersonEmail}"/></StackPanel></UniformGrid><CheckBox Margin="4" Content="Birincil Yetkili" IsChecked="{Binding NewAuthorizedPersonIsPrimary}"/><Button Margin="4" HorizontalAlignment="Left" Command="{Binding CreateAuthorizedPersonCommand}" Content="Yetkili Kaydet" IsEnabled="{Binding IsAdmin}"/><ItemsControl ItemsSource="{Binding AuthorizedPersons}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="4"><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding FullName}"/><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding Title}"/><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding Phone}"/></StackPanel><WrapPanel DockPanel.Dock="Right"><Button Margin="3" Command="{Binding DataContext.EditAuthorizedPersonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Düzenle"/><Button Margin="3" Command="{Binding DataContext.DeactivateAuthorizedPersonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Pasife Al"/></WrapPanel></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></TabItem>
        <TabItem Header="Filo ve Grup"><StackPanel Margin="8"><TextBlock FontWeight="SemiBold" Text="Filo Ekle / Düzenle"/><UniformGrid Columns="3"><StackPanel Margin="4"><TextBlock Text="Filo Kodu"/><TextBox Text="{Binding NewFleetCode}"/></StackPanel><StackPanel Margin="4"><TextBlock Text="Filo Adı"/><TextBox Text="{Binding NewFleetName}"/></StackPanel><StackPanel Margin="4"><TextBlock Text="Açıklama"/><TextBox Text="{Binding NewFleetDescription}"/></StackPanel></UniformGrid><Button Margin="4" HorizontalAlignment="Left" Command="{Binding CreateFleetCommand}" Content="Filo Kaydet" IsEnabled="{Binding IsAdmin}"/><ListBox ItemsSource="{Binding Fleets}" SelectedItem="{Binding SelectedFleet}"><ListBox.ItemTemplate><DataTemplate><DockPanel><TextBlock FontWeight="SemiBold" Text="{Binding Name}"/><WrapPanel DockPanel.Dock="Right"><Button Margin="3" Command="{Binding DataContext.EditFleetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Düzenle"/><Button Margin="3" Command="{Binding DataContext.DeactivateFleetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Pasife Al"/></WrapPanel></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox><Separator Margin="0,10,0,6"/><TextBlock FontWeight="SemiBold" Text="Grup Ekle / Düzenle"/><UniformGrid Columns="3"><StackPanel Margin="4"><TextBlock Text="Grup Kodu"/><TextBox Text="{Binding NewGroupCode}"/></StackPanel><StackPanel Margin="4"><TextBlock Text="Grup Adı"/><TextBox Text="{Binding NewGroupName}"/></StackPanel><StackPanel Margin="4"><TextBlock Text="Açıklama"/><TextBox Text="{Binding NewGroupDescription}"/></StackPanel></UniformGrid><TextBlock Margin="4" Foreground="{DynamicResource MutedForegroundBrush}" Text="Grup için önce listeden filo seçin."/><Button Margin="4" HorizontalAlignment="Left" Command="{Binding CreateFleetGroupCommand}" Content="Grup Kaydet" IsEnabled="{Binding CanCreateFleetGroup}"/><ListBox ItemsSource="{Binding FleetGroups}" SelectedItem="{Binding SelectedFleetGroup}"><ListBox.ItemTemplate><DataTemplate><DockPanel><TextBlock FontWeight="SemiBold" Text="{Binding Name}"/><WrapPanel DockPanel.Dock="Right"><Button Margin="3" Command="{Binding DataContext.EditFleetGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Düzenle"/><Button Margin="3" Command="{Binding DataContext.DeactivateFleetGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Pasife Al"/></WrapPanel></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></TabItem>
        <TabItem Header="Araç ve Sürücü"><StackPanel Margin="8"><TextBlock FontWeight="SemiBold" Text="Araç Ekle / Düzenle"/><UniformGrid Columns="2"><StackPanel Margin="4"><TextBlock Text="Plaka"/><TextBox Text="{Binding NewPlate}"/></StackPanel><StackPanel Margin="4"><TextBlock Text="Marka"/><TextBox Text="{Binding NewVehicleBrand}"/></StackPanel><StackPanel Margin="4"><TextBlock Text="Model"/><TextBox Text="{Binding NewVehicleModel}"/></StackPanel><StackPanel Margin="4"><TextBlock Text="Araç Tipi / Açıklama"/><TextBox Text="{Binding NewVehicleType}"/></StackPanel></UniformGrid><Button Margin="4" HorizontalAlignment="Left" Command="{Binding CreateVehicleCommand}" Content="Araç Kaydet" IsEnabled="{Binding CanCreateVehicle}"/><ListBox ItemsSource="{Binding Vehicles}" SelectedItem="{Binding SelectedVehicle}"><ListBox.ItemTemplate><DataTemplate><DockPanel><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Plate}"/><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding Brand}"/></StackPanel><WrapPanel DockPanel.Dock="Right"><Button Margin="3" Command="{Binding DataContext.EditVehicleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Düzenle"/><Button Margin="3" Command="{Binding DataContext.DeactivateVehicleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Pasife Al"/></WrapPanel></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox><Separator Margin="0,10,0,6"/><TextBlock FontWeight="SemiBold" Text="Sürücü Ekle / Düzenle"/><UniformGrid Columns="3"><StackPanel Margin="4"><TextBlock Text="Ad Soyad"/><TextBox Text="{Binding NewDriverName}"/></StackPanel><StackPanel Margin="4"><TextBlock Text="Telefon"/><TextBox Text="{Binding NewDriverPhone}"/></StackPanel><StackPanel Margin="4"><TextBlock Text="Referans Kodu"/><TextBox Text="{Binding NewDriverReferenceCode}"/></StackPanel></UniformGrid><Button Margin="4" HorizontalAlignment="Left" Command="{Binding CreateDriverCommand}" Content="Sürücü Kaydet" IsEnabled="{Binding IsAdmin}"/><ListBox ItemsSource="{Binding Drivers}" SelectedItem="{Binding SelectedDriver}"><ListBox.ItemTemplate><DataTemplate><DockPanel><TextBlock FontWeight="SemiBold" Text="{Binding FullName}"/><WrapPanel DockPanel.Dock="Right"><Button Margin="3" Command="{Binding DataContext.EditDriverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Düzenle"/><Button Margin="3" Command="{Binding DataContext.DeactivateDriverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Pasife Al"/></WrapPanel></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox><Button Margin="4" HorizontalAlignment="Left" Command="{Binding AssignSelectedDriverCommand}" Content="Seçili sürücüyü araca ata" IsEnabled="{Binding CanAssignDriver}"/><ItemsControl ItemsSource="{Binding Assignments}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding Status, StringFormat=Mevcut atama: {0}}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></TabItem>
      </TabControl></ScrollViewer></Border>
    </Grid>
  </Grid>
</UserControl>
