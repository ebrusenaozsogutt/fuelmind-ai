<UserControl x:Class="FuelMind.Desktop.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="{DynamicResource PageContentMargin}">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <DockPanel LastChildFill="False">
      <StackPanel>
        <TextBlock Style="{StaticResource PageTitleStyle}" Text="Müşteriler" />
        <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="Müşteri, filo, araç ve sürücü ilişkilerini seçili müşteri üzerinden yönetin." />
      </StackPanel>
      <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
        <Button Margin="3" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding NewCustomerCommand}" Content="+ Yeni Müşteri" IsEnabled="{Binding IsAdmin}" />
        <Button Margin="3" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding EditCustomerCommand}" Content="Düzenle" IsEnabled="{Binding IsAdmin}" />
        <Button Margin="3" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding LoadCommand}" Content="Yenile" />
        <Button Margin="3" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding DeactivateCustomerCommand}" Content="Pasife Al" IsEnabled="{Binding IsAdmin}" />
      </WrapPanel>
    </DockPanel>
    <Grid Grid.Row="1" Margin="0,16,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*" MinWidth="520" /><ColumnDefinition Width="1.65*" MinWidth="500" /></Grid.ColumnDefinitions>
      <Border Style="{StaticResource PremiumTablePanelStyle}">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <TextBlock FontSize="17" FontWeight="SemiBold" Text="Müşteri Listesi" />
          <DataGrid Grid.Row="1" Margin="0,10,0,0" AutoGenerateColumns="False" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" IsReadOnly="True"><DataGrid.Columns>
            <DataGridTextColumn Header="Kod" Width="85" Binding="{Binding Code}" /><DataGridTextColumn Header="Müşteri" Width="160" Binding="{Binding Name}" /><DataGridTextColumn Header="Tür" Width="85" Binding="{Binding CustomerType}" /><DataGridTextColumn Header="Telefon" Width="110" Binding="{Binding Phone}" /><DataGridTextColumn Header="E-posta" Width="170" Binding="{Binding Email}" /><DataGridTextColumn Header="Sektör" Width="105" Binding="{Binding Sector}" /><DataGridTextColumn Header="İskonto" Width="78" Binding="{Binding DiscountRate, StringFormat={}{0:N2}%}" /><DataGridCheckBoxColumn Header="Aktif" Width="58" Binding="{Binding IsActive}" />
          </DataGrid.Columns></DataGrid>
        </Grid>
      </Border>
      <Border Grid.Column="1" Margin="16,0,0,0" Style="{StaticResource PremiumDetailPanelStyle}">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <StackPanel><TextBlock FontSize="17" FontWeight="SemiBold" Text="Seçili Müşteri" /><TextBlock Margin="0,3,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding SelectedCustomer.Name, TargetNullValue=Detay görmek için soldan bir müşteri seçin}" /></StackPanel>
          <TabControl Grid.Row="1" Margin="0,10,0,0" Style="{StaticResource CommercialTabControlStyle}">
            <TabItem Header="Genel Bilgiler"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8"><TextBlock FontWeight="SemiBold" Text="Müşteri Bilgileri" /><UniformGrid Margin="0,8,0,0" Columns="2"><StackPanel Margin="4"><TextBlock Text="Müşteri kodu" /><TextBox Text="{Binding NewCode}" /></StackPanel><StackPanel Margin="4"><TextBlock Text="Müşteri adı" /><TextBox Text="{Binding NewName}" /></StackPanel><StackPanel Margin="4"><TextBlock Text="Tür" /><ComboBox ItemsSource="{Binding CustomerTypes}" SelectedItem="{Binding NewCustomerType}" /></StackPanel><StackPanel Margin="4"><TextBlock Text="Sektör" /><TextBox Text="{Binding NewCustomerSector}" /></StackPanel><StackPanel Margin="4"><TextBlock Text="İskonto (%)" /><TextBox Text="{Binding NewCustomerDiscountRate}" /></StackPanel><StackPanel Margin="4"><TextBlock Text="Talep durumu" /><ComboBox ItemsSource="{Binding RequestStatuses}" SelectedItem="{Binding NewCustomerRequestStatus}" /></StackPanel><StackPanel Margin="4"><TextBlock Text="Telefon" /><TextBox Text="{Binding NewCustomerPhone}" /></StackPanel><StackPanel Margin="4"><TextBlock Text="E-posta" /><TextBox Text="{Binding NewCustomerEmail}" /></StackPanel></UniformGrid><Button Margin="4,10,4,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding CreateCustomerCommand}" Content="Müşteriyi Kaydet" IsEnabled="{Binding IsAdmin}" /></StackPanel></ScrollViewer></TabItem>
            <TabItem Header="Yetkililer"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8"><TextBlock FontWeight="SemiBold" Text="Yetkili Ekle / Düzenle" /><UniformGrid Columns="2"><StackPanel Margin="4"><TextBlock Text="Ad soyad" /><TextBox Text="{Binding NewAuthorizedPersonName}" /></StackPanel><StackPanel Margin="4"><TextBlock Text="Unvan" /><TextBox Text="{Binding NewAuthorizedPersonTitle}" /></StackPanel><StackPanel Margin="4"><TextBlock Text="Telefon" /><TextBox Text="{Binding NewAuthorizedPersonPhone}" /></StackPanel><StackPanel Margin="4"><TextBlock Text="E-posta" /><TextBox Text="{Binding NewAuthorizedPersonEmail}" /></StackPanel></UniformGrid><CheckBox Margin="4" Content="Birincil yetkili" IsChecked="{Binding NewAuthorizedPersonIsPrimary}" /><Button Margin="4" HorizontalAlignment="Left" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding CreateAuthorizedPersonCommand}" Content="Yetkili Kaydet" IsEnabled="{Binding IsAdmin}" /><ListBox Margin="4,8,4,0" ItemsSource="{Binding AuthorizedPersons}"><ListBox.ItemTemplate><DataTemplate><DockPanel Margin="4"><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding FullName}" /><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding Title}" /><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding Phone}" /></StackPanel><WrapPanel DockPanel.Dock="Right"><Button Margin="3" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding DataContext.EditAuthorizedPersonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Düzenle" /><Button Margin="3" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding DataContext.DeactivateAuthorizedPersonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Pasife Al" /></WrapPanel></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></ScrollViewer></TabItem>
            <TabItem Header="Filo / Grup">
              <Grid Margin="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="0.95*" MinWidth="250" /><ColumnDefinition Width="1.45*" MinWidth="400" /></Grid.ColumnDefinitions>
                <Border Margin="0,0,10,0" Padding="10" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8">
                  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel LastChildFill="False"><StackPanel><TextBlock FontSize="16" FontWeight="SemiBold" Text="Filolar" /><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="Seçili müşteri için filolar" /></StackPanel><Button DockPanel.Dock="Right" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding NewFleetCommand}" Content="+ Yeni Filo" IsEnabled="{Binding IsAdmin}" /></DockPanel>
                    <ListBox Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Fleets}" SelectedItem="{Binding SelectedFleet, Mode=TwoWay}" ScrollViewer.VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent">
                      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,7" /><Setter Property="Background" Value="Transparent" /><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource RowSelectedBrush}" /></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle>
                      <ListBox.ItemTemplate><DataTemplate><Border Padding="10" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" /><TextBlock Margin="0,2,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding Code}" /><TextBlock Margin="0,4,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding GroupCount, StringFormat={}{0} grup}" /></StackPanel><TextBlock Grid.Column="1" VerticalAlignment="Top" FontSize="11" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="PASİF" /><Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Text" Value="AKTİF" /><Setter Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Border>
                <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                  <Border Padding="12" Background="{DynamicResource RaisedCardBrush}" BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="1" CornerRadius="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="MÜŞTERİ └── FİLO └── GRUP" /><TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding SelectedCustomer.Name, TargetNullValue=Müşteri seçin}" /><TextBlock Margin="0,8,0,0" Style="{StaticResource TopologyMicroLabelStyle}" Text="SEÇİLİ FİLO" /><TextBlock Margin="0,3,0,0" FontSize="17" FontWeight="SemiBold" Text="{Binding SelectedFleet.Name, TargetNullValue=Filo seçin}" /></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><Button Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding EditFleetCommand}" CommandParameter="{Binding SelectedFleet}" Content="Düzenle" IsEnabled="{Binding IsAdmin}" /><Button Margin="0,7,0,0" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding ToggleFleetActiveCommand}" Content="Pasife Al / Aktifleştir" IsEnabled="{Binding IsAdmin}" /></StackPanel></Grid></Border>
                  <Border Grid.Row="1" Margin="0,10,0,0" Padding="12" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="KOD" /><TextBlock FontWeight="SemiBold" Text="{Binding SelectedFleet.Code, TargetNullValue=—}" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="AÇIKLAMA" /><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding SelectedFleet.Description, TargetNullValue=Açıklama belirtilmedi}" TextWrapping="Wrap" /><TextBlock Margin="0,5,0,0" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="PASİF" /><Style.Triggers><DataTrigger Binding="{Binding SelectedFleet.IsActive}" Value="True"><Setter Property="Text" Value="AKTİF" /><Setter Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Grid></Border>
                  <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel LastChildFill="False"><StackPanel><TextBlock FontSize="16" FontWeight="SemiBold" Text="Bu Filonun Grupları" /><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding FleetGroups.Count, StringFormat={}{0} kayıt}" /></StackPanel><WrapPanel DockPanel.Dock="Right"><Button Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding NewFleetGroupCommand}" Content="+ Yeni Grup" IsEnabled="{Binding CanCreateFleetGroup}" /><Button Margin="7,0,0,0" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding EditFleetGroupCommand}" CommandParameter="{Binding SelectedFleetGroup}" Content="Düzenle" IsEnabled="{Binding IsAdmin}" /><Button Margin="7,0,0,0" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding ToggleFleetGroupActiveCommand}" Content="Pasife Al / Aktifleştir" IsEnabled="{Binding IsAdmin}" /></WrapPanel></DockPanel>
                    <Border Grid.Row="1" Margin="0,10,0,0" Padding="10" Background="{DynamicResource RaisedCardBrush}" BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="1" CornerRadius="7" Visibility="{Binding IsFleetFormOpen, Converter={StaticResource BoolToVisibility}}"><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding FleetFormTitle}" /><UniformGrid Margin="0,6,0,0" Columns="3"><StackPanel Margin="3"><TextBlock Text="Filo kodu" /><TextBox Text="{Binding NewFleetCode, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Margin="3"><TextBlock Text="Filo adı" /><TextBox Text="{Binding NewFleetName, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Margin="3"><TextBlock Text="Açıklama" /><TextBox Text="{Binding NewFleetDescription, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></UniformGrid><WrapPanel Margin="3,6,3,0"><Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CreateFleetCommand}" Content="Kaydet" IsEnabled="{Binding IsAdmin}" /><Button Margin="8,0,0,0" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding CancelFleetFormCommand}" Content="Vazgeç" /></WrapPanel></StackPanel></Border>
                    <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                      <ListBox ItemsSource="{Binding FleetGroups}" SelectedItem="{Binding SelectedFleetGroup, Mode=TwoWay}" ScrollViewer.VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,6" /></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border Padding="10" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Name}" /><TextBlock Margin="0,2,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding Code}" /><TextBlock Margin="0,4,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding Description, TargetNullValue=Açıklama belirtilmedi}" TextTrimming="CharacterEllipsis" /></StackPanel><TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="PASİF" /><Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Text" Value="AKTİF" /><Setter Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
                      <Border Grid.Row="1" Margin="0,10,0,0" Padding="10" Background="{DynamicResource RaisedCardBrush}" BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="1" CornerRadius="7" Visibility="{Binding IsFleetGroupFormOpen, Converter={StaticResource BoolToVisibility}}"><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding FleetGroupFormTitle}" /><TextBlock Margin="0,3,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding SelectedFleet.Name, StringFormat=Bağlı filo: {0}}" /><UniformGrid Margin="0,6,0,0" Columns="3"><StackPanel Margin="3"><TextBlock Text="Grup kodu" /><TextBox Text="{Binding NewGroupCode, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Margin="3"><TextBlock Text="Grup adı" /><TextBox Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Margin="3"><TextBlock Text="Açıklama" /><TextBox Text="{Binding NewGroupDescription, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></UniformGrid><WrapPanel Margin="3,6,3,0"><Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CreateFleetGroupCommand}" Content="Kaydet" IsEnabled="{Binding CanCreateFleetGroup}" /><Button Margin="8,0,0,0" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding CancelFleetGroupFormCommand}" Content="Vazgeç" /></WrapPanel></StackPanel></Border>
                    </Grid>
                  </Grid>
                </Grid>
              </Grid>
            </TabItem>
            <TabItem Header="Araçlar"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8"><TextBlock FontWeight="SemiBold" Text="Araç Ekle / Düzenle" /><UniformGrid Columns="2"><StackPanel Margin="4"><TextBlock Text="Plaka" /><TextBox Text="{Binding NewPlate}" /></StackPanel><StackPanel Margin="4"><TextBlock Text="Marka" /><TextBox Text="{Binding NewVehicleBrand}" /></StackPanel><StackPanel Margin="4"><TextBlock Text="Model" /><TextBox Text="{Binding NewVehicleModel}" /></StackPanel><StackPanel Margin="4"><TextBlock Text="Araç tipi" /><TextBox Text="{Binding NewVehicleType}" /></StackPanel></UniformGrid><TextBlock Margin="4" Foreground="{DynamicResource MutedForegroundBrush}" Text="Araç eklemek için önce Filo / Grup sekmesinden bir grup seçin." /><Button Margin="4" HorizontalAlignment="Left" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding CreateVehicleCommand}" Content="Araç Kaydet" IsEnabled="{Binding CanCreateVehicle}" /><ListBox Margin="4" ItemsSource="{Binding Vehicles}" SelectedItem="{Binding SelectedVehicle}"><ListBox.ItemTemplate><DataTemplate><DockPanel><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Plate}" /><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding Brand}" /></StackPanel><WrapPanel DockPanel.Dock="Right"><Button Margin="3" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding DataContext.EditVehicleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Düzenle" /><Button Margin="3" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding DataContext.DeactivateVehicleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Pasife Al" /></WrapPanel></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></ScrollViewer></TabItem>
            <TabItem Header="Sürücüler"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8"><TextBlock FontWeight="SemiBold" Text="Sürücü Ekle / Düzenle" /><UniformGrid Columns="3"><StackPanel Margin="4"><TextBlock Text="Ad soyad" /><TextBox Text="{Binding NewDriverName}" /></StackPanel><StackPanel Margin="4"><TextBlock Text="Telefon" /><TextBox Text="{Binding NewDriverPhone}" /></StackPanel><StackPanel Margin="4"><TextBlock Text="Referans kodu" /><TextBox Text="{Binding NewDriverReferenceCode}" /></StackPanel></UniformGrid><Button Margin="4" HorizontalAlignment="Left" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding CreateDriverCommand}" Content="Sürücü Kaydet" IsEnabled="{Binding IsAdmin}" /><ListBox Margin="4" ItemsSource="{Binding Drivers}" SelectedItem="{Binding SelectedDriver}"><ListBox.ItemTemplate><DataTemplate><DockPanel><TextBlock FontWeight="SemiBold" Text="{Binding FullName}" /><WrapPanel DockPanel.Dock="Right"><Button Margin="3" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding DataContext.EditDriverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Düzenle" /><Button Margin="3" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding DataContext.DeactivateDriverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Pasife Al" /></WrapPanel></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox><Separator Margin="0,10,0,6" /><TextBlock FontWeight="SemiBold" Text="Araç–Sürücü Ataması" /><TextBlock Margin="0,4,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding SelectedVehicle.Plate, StringFormat=Seçili araç: {0}, TargetNullValue=Seçili araç: —}" /><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding SelectedDriver.FullName, StringFormat=Seçili sürücü: {0}, TargetNullValue=Seçili sürücü: —}" /><Button Margin="0,8,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding AssignSelectedDriverCommand}" Content="Seçili sürücüyü araca ata" IsEnabled="{Binding CanAssignDriver}" /><ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Assignments}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,3"><Button DockPanel.Dock="Right" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding DataContext.CancelAssignmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Atamayı Bitir" /><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding Status, StringFormat=Mevcut atama: {0}}" /></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></TabItem>
          </TabControl>
        </Grid>
      </Border>
    </Grid>
    <TextBlock Grid.Row="1" Margin="0,6,0,0" VerticalAlignment="Bottom" Foreground="{DynamicResource DangerForegroundBrush}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
  </Grid>
</UserControl>
