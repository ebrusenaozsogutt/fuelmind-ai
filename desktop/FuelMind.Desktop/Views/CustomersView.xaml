<UserControl x:Class="FuelMind.Desktop.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="{DynamicResource PageContentMargin}">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <DockPanel>
      <StackPanel>
        <TextBlock Style="{StaticResource PageTitleStyle}" Text="Müşteriler" />
        <TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="Müşteri, filo, araç ve sürücü ilişkilerini seçili müşteri üzerinden yönetin." />
      </StackPanel>
      <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
        <Button Margin="3" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding NewCustomerCommand}" Content="+ Yeni Müşteri" IsEnabled="{Binding IsAdmin}" />
        <Button Margin="3" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding EditCustomerCommand}" Content="Düzenle" IsEnabled="{Binding IsAdmin}" />
        <Button Margin="3" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding LoadCommand}" Content="Yenile" />
        <Button Margin="3" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding DeactivateCustomerCommand}" Content="Pasife Al" IsEnabled="{Binding IsAdmin}" />
      </WrapPanel>
    </DockPanel>
    <Grid Grid.Row="1" Margin="0,16,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*" MinWidth="520" /><ColumnDefinition Width="1.65*" MinWidth="500" /></Grid.ColumnDefinitions>
      <Border Padding="12" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <TextBlock FontSize="17" FontWeight="SemiBold" Text="Müşteri Listesi" />
          <DataGrid Grid.Row="1" Margin="0,10,0,0" AutoGenerateColumns="False" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" IsReadOnly="True"><DataGrid.Columns>
            <DataGridTextColumn Header="Kod" Width="85" Binding="{Binding Code}" /><DataGridTextColumn Header="Müşteri" Width="160" Binding="{Binding Name}" /><DataGridTextColumn Header="Tür" Width="85" Binding="{Binding CustomerType}" /><DataGridTextColumn Header="Telefon" Width="110" Binding="{Binding Phone}" /><DataGridTextColumn Header="E-posta" Width="170" Binding="{Binding Email}" /><DataGridTextColumn Header="Sektör" Width="105" Binding="{Binding Sector}" /><DataGridTextColumn Header="İskonto" Width="78" Binding="{Binding DiscountRate, StringFormat={}{0:N2}%}" /><DataGridCheckBoxColumn Header="Aktif" Width="58" Binding="{Binding IsActive}" />
          </DataGrid.Columns></DataGrid>
        </Grid>
      </Border>
      <Border Grid.Column="1" Margin="16,0,0,0" Padding="12" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <StackPanel><TextBlock FontSize="17" FontWeight="SemiBold" Text="Seçili Müşteri" /><TextBlock Margin="0,3,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding SelectedCustomer.Name, TargetNullValue=Detay görmek için soldan bir müşteri seçin}" /></StackPanel>
          <TabControl Grid.Row="1" Margin="0,10,0,0" Style="{StaticResource CommercialTabControlStyle}">
            <TabItem Header="Genel Bilgiler"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8"><TextBlock FontWeight="SemiBold" Text="Müşteri Bilgileri" /><UniformGrid Margin="0,8,0,0" Columns="2"><StackPanel Margin="4"><TextBlock Text="Müşteri kodu" /><TextBox Text="{Binding NewCode}" /></StackPanel><StackPanel Margin="4"><TextBlock Text="Müşteri adı" /><TextBox Text="{Binding NewName}" /></StackPanel><StackPanel Margin="4"><TextBlock Text="Tür" /><ComboBox ItemsSource="{Binding CustomerTypes}" SelectedItem="{Binding NewCustomerType}" /></StackPanel><StackPanel Margin="4"><TextBlock Text="Sektör" /><TextBox Text="{Binding NewCustomerSector}" /></StackPanel><StackPanel Margin="4"><TextBlock Text="İskonto (%)" /><TextBox Text="{Binding NewCustomerDiscountRate}" /></StackPanel><StackPanel Margin="4"><TextBlock Text="Talep durumu" /><ComboBox ItemsSource="{Binding RequestStatuses}" SelectedItem="{Binding NewCustomerRequestStatus}" /></StackPanel><StackPanel Margin="4"><TextBlock Text="Telefon" /><TextBox Text="{Binding NewCustomerPhone}" /></StackPanel><StackPanel Margin="4"><TextBlock Text="E-posta" /><TextBox Text="{Binding NewCustomerEmail}" /></StackPanel></UniformGrid><Button Margin="4,10,4,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding CreateCustomerCommand}" Content="Müşteriyi Kaydet" IsEnabled="{Binding IsAdmin}" /></StackPanel></ScrollViewer></TabItem>
            <TabItem Header="Yetkililer"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8"><TextBlock FontWeight="SemiBold" Text="Yetkili Ekle / Düzenle" /><UniformGrid Columns="2"><StackPanel Margin="4"><TextBlock Text="Ad soyad" /><TextBox Text="{Binding NewAuthorizedPersonName}" /></StackPanel><StackPanel Margin="4"><TextBlock Text="Unvan" /><TextBox Text="{Binding NewAuthorizedPersonTitle}" /></StackPanel><StackPanel Margin="4"><TextBlock Text="Telefon" /><TextBox Text="{Binding NewAuthorizedPersonPhone}" /></StackPanel><StackPanel Margin="4"><TextBlock Text="E-posta" /><TextBox Text="{Binding NewAuthorizedPersonEmail}" /></StackPanel></UniformGrid><CheckBox Margin="4" Content="Birincil yetkili" IsChecked="{Binding NewAuthorizedPersonIsPrimary}" /><Button Margin="4" HorizontalAlignment="Left" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding CreateAuthorizedPersonCommand}" Content="Yetkili Kaydet" IsEnabled="{Binding IsAdmin}" /><ListBox Margin="4,8,4,0" ItemsSource="{Binding AuthorizedPersons}"><ListBox.ItemTemplate><DataTemplate><DockPanel Margin="4"><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding FullName}" /><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding Title}" /><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding Phone}" /></StackPanel><WrapPanel DockPanel.Dock="Right"><Button Margin="3" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding DataContext.EditAuthorizedPersonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Düzenle" /><Button Margin="3" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding DataContext.DeactivateAuthorizedPersonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Pasife Al" /></WrapPanel></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></ScrollViewer></TabItem>
            <TabItem Header="Filo / Grup"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8"><TextBlock FontWeight="SemiBold" Text="Filo" /><UniformGrid Columns="3"><StackPanel Margin="4"><TextBlock Text="Filo kodu" /><TextBox Text="{Binding NewFleetCode}" /></StackPanel><StackPanel Margin="4"><TextBlock Text="Filo adı" /><TextBox Text="{Binding NewFleetName}" /></StackPanel><StackPanel Margin="4"><TextBlock Text="Açıklama" /><TextBox Text="{Binding NewFleetDescription}" /></StackPanel></UniformGrid><Button Margin="4" HorizontalAlignment="Left" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding CreateFleetCommand}" Content="Filo Kaydet" IsEnabled="{Binding IsAdmin}" /><ListBox Margin="4" ItemsSource="{Binding Fleets}" SelectedItem="{Binding SelectedFleet}"><ListBox.ItemTemplate><DataTemplate><DockPanel><TextBlock FontWeight="SemiBold" Text="{Binding Name}" /><WrapPanel DockPanel.Dock="Right"><Button Margin="3" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding DataContext.EditFleetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Düzenle" /><Button Margin="3" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding DataContext.DeactivateFleetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Pasife Al" /></WrapPanel></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox><Separator Margin="0,10,0,6" /><TextBlock FontWeight="SemiBold" Text="Filo Grubu" /><UniformGrid Columns="3"><StackPanel Margin="4"><TextBlock Text="Grup kodu" /><TextBox Text="{Binding NewGroupCode}" /></StackPanel><StackPanel Margin="4"><TextBlock Text="Grup adı" /><TextBox Text="{Binding NewGroupName}" /></StackPanel><StackPanel Margin="4"><TextBlock Text="Açıklama" /><TextBox Text="{Binding NewGroupDescription}" /></StackPanel></UniformGrid><TextBlock Margin="4" Foreground="{DynamicResource MutedForegroundBrush}" Text="Grup eklemek için listeden bir filo seçin." /><Button Margin="4" HorizontalAlignment="Left" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding CreateFleetGroupCommand}" Content="Grup Kaydet" IsEnabled="{Binding CanCreateFleetGroup}" /><ListBox Margin="4" ItemsSource="{Binding FleetGroups}" SelectedItem="{Binding SelectedFleetGroup}"><ListBox.ItemTemplate><DataTemplate><DockPanel><TextBlock FontWeight="SemiBold" Text="{Binding Name}" /><WrapPanel DockPanel.Dock="Right"><Button Margin="3" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding DataContext.EditFleetGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Düzenle" /><Button Margin="3" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding DataContext.DeactivateFleetGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Pasife Al" /></WrapPanel></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></ScrollViewer></TabItem>
            <TabItem Header="Araçlar"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8"><TextBlock FontWeight="SemiBold" Text="Araç Ekle / Düzenle" /><UniformGrid Columns="2"><StackPanel Margin="4"><TextBlock Text="Plaka" /><TextBox Text="{Binding NewPlate}" /></StackPanel><StackPanel Margin="4"><TextBlock Text="Marka" /><TextBox Text="{Binding NewVehicleBrand}" /></StackPanel><StackPanel Margin="4"><TextBlock Text="Model" /><TextBox Text="{Binding NewVehicleModel}" /></StackPanel><StackPanel Margin="4"><TextBlock Text="Araç tipi" /><TextBox Text="{Binding NewVehicleType}" /></StackPanel></UniformGrid><TextBlock Margin="4" Foreground="{DynamicResource MutedForegroundBrush}" Text="Araç eklemek için önce Filo / Grup sekmesinden bir grup seçin." /><Button Margin="4" HorizontalAlignment="Left" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding CreateVehicleCommand}" Content="Araç Kaydet" IsEnabled="{Binding CanCreateVehicle}" /><ListBox Margin="4" ItemsSource="{Binding Vehicles}" SelectedItem="{Binding SelectedVehicle}"><ListBox.ItemTemplate><DataTemplate><DockPanel><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Plate}" /><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding Brand}" /></StackPanel><WrapPanel DockPanel.Dock="Right"><Button Margin="3" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding DataContext.EditVehicleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Düzenle" /><Button Margin="3" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding DataContext.DeactivateVehicleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Pasife Al" /></WrapPanel></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></ScrollViewer></TabItem>
            <TabItem Header="Sürücüler"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8"><TextBlock FontWeight="SemiBold" Text="Sürücü Ekle / Düzenle" /><UniformGrid Columns="3"><StackPanel Margin="4"><TextBlock Text="Ad soyad" /><TextBox Text="{Binding NewDriverName}" /></StackPanel><StackPanel Margin="4"><TextBlock Text="Telefon" /><TextBox Text="{Binding NewDriverPhone}" /></StackPanel><StackPanel Margin="4"><TextBlock Text="Referans kodu" /><TextBox Text="{Binding NewDriverReferenceCode}" /></StackPanel></UniformGrid><Button Margin="4" HorizontalAlignment="Left" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding CreateDriverCommand}" Content="Sürücü Kaydet" IsEnabled="{Binding IsAdmin}" /><ListBox Margin="4" ItemsSource="{Binding Drivers}" SelectedItem="{Binding SelectedDriver}"><ListBox.ItemTemplate><DataTemplate><DockPanel><TextBlock FontWeight="SemiBold" Text="{Binding FullName}" /><WrapPanel DockPanel.Dock="Right"><Button Margin="3" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding DataContext.EditDriverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Düzenle" /><Button Margin="3" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding DataContext.DeactivateDriverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Pasife Al" /></WrapPanel></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox><Separator Margin="0,10,0,6" /><TextBlock FontWeight="SemiBold" Text="Araç–Sürücü Ataması" /><TextBlock Margin="0,4,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding SelectedVehicle.Plate, StringFormat=Seçili araç: {0}, TargetNullValue=Seçili araç: —}" /><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding SelectedDriver.FullName, StringFormat=Seçili sürücü: {0}, TargetNullValue=Seçili sürücü: —}" /><Button Margin="0,8,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding AssignSelectedDriverCommand}" Content="Seçili sürücüyü araca ata" IsEnabled="{Binding CanAssignDriver}" /><ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Assignments}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,3"><Button DockPanel.Dock="Right" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding DataContext.CancelAssignmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="Atamayı Bitir" /><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding Status, StringFormat=Mevcut atama: {0}}" /></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></TabItem>
          </TabControl>
        </Grid>
      </Border>
    </Grid>
    <TextBlock Grid.Row="1" Margin="0,6,0,0" VerticalAlignment="Bottom" Foreground="{DynamicResource DangerForegroundBrush}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
  </Grid>
</UserControl>
