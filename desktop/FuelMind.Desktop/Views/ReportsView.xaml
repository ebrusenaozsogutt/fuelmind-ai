<UserControl x:Class="FuelMind.Desktop.Views.ReportsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock FontSize="28" FontWeight="SemiBold" Text="Gelişmiş Raporlar"/><WrapPanel Margin="0,12,0,0"><ComboBox Width="180" ItemsSource="{Binding ReportTypes}" SelectedItem="{Binding SelectedReportType}" DisplayMemberPath="Name"/><DatePicker Margin="8,0,0,0" SelectedDate="{Binding DateFrom}"/><DatePicker Margin="8,0,0,0" SelectedDate="{Binding DateTo}"/><ComboBox Margin="8,0,0,0" Width="170" ItemsSource="{Binding Stations}" SelectedItem="{Binding SelectedStation}" DisplayMemberPath="DisplayName"/><TextBox Margin="8,0,0,0" Width="130" Text="{Binding Plate, UpdateSourceTrigger=PropertyChanged}"/><Button Margin="8,0,0,0" Content="Raporu Getir" Command="{Binding RunCommand}"/><Button Margin="8,0,0,0" Content="PDF İndir" Command="{Binding ExportPdfCommand}"/><Button Margin="8,0,0,0" Content="CSV İndir" Command="{Binding ExportCsvCommand}"/><Button Margin="8,0,0,0" Content="Temizle" Command="{Binding ClearFiltersCommand}"/></WrapPanel><TextBlock Foreground="IndianRed" Text="{Binding ErrorMessage}"/></StackPanel><Grid Grid.Row="1" Margin="0,16,0,0"><DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Tarih" Binding="{Binding Date}"/><DataGridTextColumn Header="İstasyon" Binding="{Binding Station}"/><DataGridTextColumn Header="Pompa" Binding="{Binding Pump}"/><DataGridTextColumn Header="Tabanca" Binding="{Binding Nozzle}"/><DataGridTextColumn Header="Pompacı" Binding="{Binding Attendant}"/><DataGridTextColumn Header="Vardiya" Binding="{Binding Shift}"/><DataGridTextColumn Header="Ürün" Binding="{Binding Fuel}"/><DataGridTextColumn Header="Litre" Binding="{Binding Liters}"/><DataGridTextColumn Header="Birim Fiyat" Binding="{Binding UnitPrice}"/><DataGridTextColumn Header="Tutar" Binding="{Binding TotalAmount}"/><DataGridTextColumn Header="Müşteri" Binding="{Binding Customer}"/><DataGridTextColumn Header="Plaka" Binding="{Binding Plate}"/><DataGridTextColumn Header="Kart" Binding="{Binding Card}"/><DataGridTextColumn Header="Durum" Binding="{Binding Status}"/></DataGrid.Columns></DataGrid><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}" Text="Kayıt bulunamadı."><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Grid>
</UserControl>
