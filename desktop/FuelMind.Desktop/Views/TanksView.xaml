<UserControl x:Class="FuelMind.Desktop.Views.TanksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FuelMind.Desktop.Controls"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{DynamicResource PageContentMargin}">
            <TextBlock FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AppForegroundBrush}"
                       Text="Tanklar" />
            <TextBlock Margin="0,16,0,0"
                       Foreground="{DynamicResource MutedForegroundBrush}"
                       Text="Canlı tank verisi bekleniyor.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TankCount}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Border Margin="0,20,0,0"
                    Padding="18"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppForegroundBrush}"
                               Text="Canlı ölçülen tank seviyesi" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="Tank seçimi" />
                            <ComboBox Margin="0,6,16,0" Style="{StaticResource DarkComboBoxStyle}"
                                      DisplayMemberPath="Code"
                                      ItemsSource="{Binding Tanks}"
                                      SelectedValue="{Binding SelectedTankId, Mode=TwoWay}"
                                      SelectedValuePath="TankId" />
                            <TextBlock Margin="0,16,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="Seçili tank" />
                            <TextBlock FontWeight="SemiBold" Text="{Binding SelectedTankDisplay}" />
                            <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="Güncel ölçülen seviye" />
                            <TextBlock Text="{Binding CurrentMeasuredLevel, StringFormat={}{0:N0} L, TargetNullValue=Veri yok}" />
                            <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="Kapasite" />
                            <TextBlock Text="{Binding CurrentCapacity, StringFormat={}{0:N0} L, TargetNullValue=Veri yok}" />
                            <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="Doluluk oranı" />
                            <TextBlock Text="{Binding CurrentFillPercentage, StringFormat={}{0:N0}%, TargetNullValue=Veri yok}" />
                        </StackPanel>
                        <lvc:CartesianChart Grid.Column="1"
                                            Height="280"
                                            Background="{DynamicResource AppBackgroundBrush}"
                                            LegendPosition="Top"
                                            Series="{Binding Series}"
                                            XAxes="{Binding XAxes}"
                                            YAxes="{Binding YAxes}"
                                            ZoomMode="None" />
                    </Grid>
                </StackPanel>
            </Border>
            <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding Tanks}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Padding="0" Background="Transparent" BorderThickness="0"
                                Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding TankId}">
                            <controls:TankControl Margin="6" Tank="{Binding}" />
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
