<UserControl x:Class="FuelMind.Desktop.Views.OrdersView" xml:lang="tr-TR" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="{DynamicResource PageContentMargin}"><DockPanel LastChildFill="False"><StackPanel><TextBlock Style="{StaticResource PageTitleStyle}" Text="Sipariş Önerileri"/><TextBlock Style="{StaticResource PageSubtitleStyle}" Text="Tahmini talep, mevcut stok, minimum güvenli stok ve güvenlik stoğuna göre önerilen sipariş zamanı ve miktarı hesaplanır."/><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="Tahminler: beklenen satış. Sipariş önerileri: ne zaman ve ne kadar yakıt alınmalı?"/></StackPanel><WrapPanel DockPanel.Dock="Right"><Button Margin="0,0,8,0" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding RefreshCommand}" Content="Yenile"/><Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding GenerateCommand}" IsEnabled="{Binding CanGenerate}" Content="Öneri Üret"/></WrapPanel></DockPanel><ComboBox Margin="0,16,0,12" MinWidth="280" HorizontalAlignment="Left" Style="{StaticResource DarkComboBoxStyle}" ItemsSource="{Binding Tanks}" DisplayMemberPath="Code" SelectedItem="{Binding SelectedTank}"/><TextBlock Foreground="{DynamicResource DangerForegroundBrush}" Text="{Binding ErrorMessage}" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/><Border Style="{StaticResource SectionCardStyle}"><WrapPanel><StackPanel MinWidth="190" Margin="0,0,22,8"><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="MEVCUT STOK"/><TextBlock FontSize="20" Text="{Binding DisplayedCurrentStock, StringFormat={}{0:N1} L}"/></StackPanel><StackPanel MinWidth="210" Margin="0,0,22,8"><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="MİNİMUM GÜVENLİ STOK"/><TextBlock FontSize="20" Text="{Binding DisplayedMinimumSafeStock, StringFormat={}{0:N1} L}"/></StackPanel><StackPanel MinWidth="190" Margin="0,0,22,8"><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="KRİTİK STOK TARİHİ"/><TextBlock FontSize="20" Text="{Binding Recommendation.CriticalStockDate, StringFormat={}{0:dd MMMM yyyy}}"/></StackPanel><StackPanel MinWidth="150"><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="ÖNCELİK"/><TextBlock FontSize="20" Text="{Binding PriorityDisplay}"/></StackPanel></WrapPanel></Border><Border Style="{StaticResource SectionCardStyle}"><StackPanel><TextBlock Style="{StaticResource SectionTitleStyle}" Text="Önerilen Sipariş Miktarı"/><TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding Recommendation.RecommendedQuantity, StringFormat={}{0:N1} L}" Visibility="{Binding HasOrder, Converter={StaticResource BooleanToVisibilityConverter}}"/><TextBlock FontSize="20" Foreground="{DynamicResource SuccessForegroundBrush}" Text="Şu anda sipariş gerekmiyor." Visibility="{Binding NoOrderRequired, Converter={StaticResource BooleanToVisibilityConverter}}"/><WrapPanel Margin="0,12,0,0" Visibility="{Binding HasOrder, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel MinWidth="220"><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="ÖNERİLEN SİPARİŞ TARİHİ"/><TextBlock Text="{Binding Recommendation.RecommendedOrderDate, StringFormat={}{0:dd MMMM yyyy}}"/></StackPanel><StackPanel MinWidth="220"><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="TESLİM TARİHİ"/><TextBlock Text="{Binding Recommendation.RecommendedDeliveryDate, StringFormat={}{0:dd MMMM yyyy}}"/></StackPanel></WrapPanel><TextBlock Margin="0,18,0,4" Style="{StaticResource SectionTitleStyle}" Text="Öneri Açıklaması"/><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding Recommendation.Explanation}" TextWrapping="Wrap"/></StackPanel></Border></StackPanel></ScrollViewer></UserControl>
