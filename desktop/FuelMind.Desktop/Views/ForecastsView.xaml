<UserControl x:Class="FuelMind.Desktop.Views.ForecastsView" xml:lang="tr-TR" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"><ScrollViewer x:Name="Root" VerticalScrollBarVisibility="Auto"><StackPanel Margin="{DynamicResource PageContentMargin}"><DockPanel LastChildFill="False"><StackPanel><TextBlock Style="{StaticResource PageTitleStyle}" Text="Tahmini Talep"/><TextBlock Style="{StaticResource PageSubtitleStyle}" Text="Önümüzdeki 7 gün için beklenen yakıt satış/tüketim miktarlarını gösterir; sipariş miktarı değildir."/></StackPanel><WrapPanel DockPanel.Dock="Right"><Button Margin="0,0,8,0" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding RefreshCommand}" Content="Yenile"/><Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding GenerateCommand}" IsEnabled="{Binding CanGenerate}" Content="Tahmin Üret"/></WrapPanel></DockPanel><WrapPanel Margin="0,16,0,12"><ComboBox MinWidth="220" Margin="0,0,12,0" Style="{StaticResource DarkComboBoxStyle}" ItemsSource="{Binding Stations}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedStation}"/><ComboBox MinWidth="210" Style="{StaticResource DarkComboBoxStyle}" ItemsSource="{Binding FuelTypes}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedFuelType}"/></WrapPanel><Border Style="{StaticResource SectionCardStyle}"><StackPanel><WrapPanel><StackPanel MinWidth="220" Margin="0,0,24,8"><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="KULLANILAN MODEL"/><TextBlock FontSize="18" Text="{Binding ModelDisplay}"/></StackPanel><StackPanel MinWidth="160"><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="ORTALAMA GÜVEN"/><TextBlock FontSize="18" Text="{Binding AverageConfidence, StringFormat={}{0:N1}%}"/></StackPanel></WrapPanel><TextBlock Margin="0,8,0,0" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap" Text="Tahminler sipariş önerileri hesabında kullanılır. Güven skoru kesin doğruluk oranı değildir."/></StackPanel></Border><Border Style="{StaticResource SectionCardStyle}"><StackPanel><TextBlock Style="{StaticResource SectionTitleStyle}" Text="7 Günlük Tahmini Talep"/><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="Tahmini Talep • Alt Güven Sınırı • Üst Güven Sınırı"/><lvc:CartesianChart Height="380" Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" LegendPosition="Top"/><DataGrid Margin="0,14,0,0" ItemsSource="{Binding Forecasts}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Width="*" Header="Tarih" Binding="{Binding ForecastDate, StringFormat={}{0:dd.MM.yyyy}}"/><DataGridTextColumn Width="1.4*" Header="Tahmini Talep" Binding="{Binding PredictedDemand, StringFormat={}{0:N1} L}"/><DataGridTextColumn Width="*" Header="Alt Sınır" Binding="{Binding LowerBound, StringFormat={}{0:N1} L}"/><DataGridTextColumn Width="*" Header="Üst Sınır" Binding="{Binding UpperBound, StringFormat={}{0:N1} L}"/><DataGridTextColumn Width="*" Header="Güven" Binding="{Binding ConfidenceScore, StringFormat={}{0:N1}%}"/></DataGrid.Columns></DataGrid></StackPanel></Border></StackPanel></ScrollViewer></UserControl>
