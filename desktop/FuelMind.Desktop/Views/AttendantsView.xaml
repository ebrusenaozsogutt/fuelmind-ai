<UserControl x:Class="FuelMind.Desktop.Views.AttendantsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="{DynamicResource PageContentMargin}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <DockPanel LastChildFill="False">
        <StackPanel>
          <TextBlock Style="{StaticResource PageTitleStyle}" Text="Pompacı &amp; Vardiya"/>
          <TextBlock Style="{StaticResource PageSubtitleStyle}"
                     Text="Pompacı seçin, vardiyayı seçin ve atamayı güvenle oluşturun."/>
        </StackPanel>
        <Button DockPanel.Dock="Right"
                VerticalAlignment="Center"
                Style="{StaticResource SecondaryActionButtonStyle}"
                Command="{Binding RefreshCommand}"
                Content="Yenile"/>
      </DockPanel>

      <Border Margin="0,10,0,0" Padding="8" Background="{DynamicResource DangerBrush}" CornerRadius="6">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <TextBlock Foreground="{DynamicResource AppForegroundBrush}"
                   Text="{Binding ErrorMessage}"
                   TextWrapping="Wrap"/>
      </Border>

      <Border Margin="0,8,0,0"
              Padding="8"
              Background="{DynamicResource SuccessBrush}"
              CornerRadius="6">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding SuccessMessage}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <TextBlock Foreground="{DynamicResource AppForegroundBrush}"
                   Text="{Binding SuccessMessage}"
                   TextWrapping="Wrap"/>
      </Border>

      <Border Margin="0,12,0,0"
              Padding="14"
              Background="{DynamicResource RaisedCardBrush}"
              BorderBrush="{DynamicResource AccentSoftBrush}"
              BorderThickness="1"
              CornerRadius="12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1.2*"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="1 · SEÇİLİ POMPACI"/>
            <TextBlock Margin="0,4,0,0"
                       FontWeight="SemiBold"
                       Text="{Binding SelectedAttendantSummary}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="18,0,0,0">
            <TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="2 · SEÇİLİ VARDİYA"/>
            <TextBlock Margin="0,4,0,0"
                       FontWeight="SemiBold"
                       Text="{Binding SelectedShiftSummary}"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Margin="18,0,0,0">
            <TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="3 · ATAMA DURUMU"/>
            <TextBlock Margin="0,4,0,0"
                       Foreground="{DynamicResource MutedForegroundBrush}"
                       Text="{Binding AssignmentReadinessMessage}"
                       TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>

    <TabControl Grid.Row="1"
                Margin="0,16,0,0"
                SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                Style="{StaticResource CommercialTabControlStyle}">
      <TabItem Header="Pompacılar">
        <Grid Margin="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*" MinWidth="320"/>
          </Grid.ColumnDefinitions>
          <Border Padding="8"
                  Background="{DynamicResource CardBrush}"
                  BorderBrush="{DynamicResource ControlBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="6">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <DockPanel LastChildFill="False">
                <TextBlock FontWeight="SemiBold" Text="1. Pompacı seçin"/>
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        Command="{Binding NewAttendantCommand}"
                        Content="+ Yeni Pompacı"/>
              </DockPanel>
              <DataGrid Grid.Row="1"
                        Margin="0,8,0,0"
                        ItemsSource="{Binding Attendants}"
                        SelectedItem="{Binding SelectedAttendant, Mode=TwoWay}"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="True">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Kod" Width="0.8*" Binding="{Binding Code}"/>
                  <DataGridTextColumn Header="Ad Soyad" Width="1.6*" Binding="{Binding FullName}"/>
                  <DataGridTextColumn Header="Personel No" Width="1.2*" Binding="{Binding EmployeeNumber}"/>
                  <DataGridTextColumn Header="İstasyon" Width="0.9*" Binding="{Binding StationId}"/>
                  <DataGridTextColumn Header="Telefon" Width="1.1*" Binding="{Binding Phone}"/>
                  <DataGridCheckBoxColumn Header="Aktif" Width="0.55*" Binding="{Binding IsActive}"/>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>
          <Border Grid.Column="1"
                  Margin="14,0,0,0"
                  Padding="14"
                  Background="{DynamicResource ControlBackgroundBrush}"
                  BorderBrush="{DynamicResource ControlBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock FontSize="17" FontWeight="SemiBold" Text="Pompacı Detay Formu"/>
                <TextBlock Margin="0,3,0,10"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           Text="{Binding AttendantSaveActionText}"/>
                <TextBlock Text="Pompacı kodu"/>
                <TextBox Margin="0,4,0,10" Text="{Binding Code}"/>
                <TextBlock Text="Ad soyad"/>
                <TextBox Margin="0,4,0,10" Text="{Binding FullName}"/>
                <TextBlock Text="Personel numarası"/>
                <TextBox Margin="0,4,0,10" Text="{Binding EmployeeNumber}"/>
                <TextBlock Text="Telefon"/>
                <TextBox Margin="0,4,0,10" Text="{Binding Phone}"/>
                <CheckBox Margin="0,0,0,10"
                          Content="Aktif"
                          IsChecked="{Binding AttendantIsActive}"/>
                <TextBlock Text="İstasyon"/>
                <ComboBox Margin="0,4,0,14"
                          Style="{StaticResource DarkComboBoxStyle}"
                          ItemsSource="{Binding Stations}"
                          SelectedItem="{Binding SelectedStation}"
                          DisplayMemberPath="DisplayName"/>
                <WrapPanel>
                  <Button Margin="0,0,8,0"
                          Style="{StaticResource SecondaryActionButtonStyle}"
                          Command="{Binding SaveAttendantCommand}"
                          Content="{Binding AttendantSaveActionText}"/>
                  <Button Style="{StaticResource SecondaryActionButtonStyle}"
                          Command="{Binding DeactivateAttendantCommand}"
                          Content="Pasife Al"
                          IsEnabled="{Binding IsEditMode}"/>
                </WrapPanel>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Vardiyalar">
        <Grid Margin="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*" MinWidth="320"/>
          </Grid.ColumnDefinitions>
          <Border Padding="8"
                  Background="{DynamicResource CardBrush}"
                  BorderBrush="{DynamicResource ControlBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="6">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TextBlock FontWeight="SemiBold" Text="2. Vardiya seçin"/>
              <DataGrid Grid.Row="1"
                        Margin="0,8,0,0"
                        ItemsSource="{Binding Shifts}"
                        SelectedItem="{Binding SelectedShift}"
                        AutoGenerateColumns="False">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Kod" Width="1*" Binding="{Binding Code}"/>
                  <DataGridTextColumn Header="Vardiya" Width="1.8*" Binding="{Binding Name}"/>
                  <DataGridTextColumn Header="Saat" Width="1.2*" Binding="{Binding Schedule}"/>
                  <DataGridTextColumn Header="İstasyon" Width="1*" Binding="{Binding StationId}"/>
                  <DataGridCheckBoxColumn Header="Aktif" Width="0.6*" Binding="{Binding IsActive}"/>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>
          <Border Grid.Column="1"
                  Margin="14,0,0,0"
                  Padding="14"
                  Background="{DynamicResource ControlBackgroundBrush}"
                  BorderBrush="{DynamicResource ControlBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="6">
            <StackPanel>
              <TextBlock FontSize="17" FontWeight="SemiBold" Text="Vardiya Formu"/>
              <TextBlock Margin="0,3,0,10"
                         Foreground="{DynamicResource MutedForegroundBrush}"
                         Text="Seçili pompacı korunur; vardiyayı seçtiğinizde özet alanından kontrol edin."/>
              <TextBlock Text="Vardiya kodu"/>
              <TextBox Margin="0,4,0,10" Text="{Binding ShiftCode}"/>
              <TextBlock Text="Vardiya adı"/>
              <TextBox Margin="0,4,0,10" Text="{Binding ShiftName}"/>
              <TextBlock Text="Başlangıç saati (HH:mm)"/>
              <TextBox Margin="0,4,0,10" Text="{Binding StartTime}"/>
              <TextBlock Text="Bitiş saati (HH:mm)"/>
              <TextBox Margin="0,4,0,10" Text="{Binding EndTime}"/>
              <TextBlock Text="İstasyon"/>
              <ComboBox Margin="0,4,0,14"
                        Style="{StaticResource DarkComboBoxStyle}"
                        ItemsSource="{Binding Stations}"
                        SelectedItem="{Binding SelectedStation}"
                        DisplayMemberPath="DisplayName"/>
              <WrapPanel>
                <Button Margin="0,0,8,0"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        Command="{Binding SaveShiftCommand}"
                        Content="Kaydet"/>
                <Button Style="{StaticResource SecondaryActionButtonStyle}"
                        Command="{Binding DeactivateShiftCommand}"
                        Content="Pasife Al"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Atamalar">
        <Grid Margin="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*" MinWidth="320"/>
          </Grid.ColumnDefinitions>
          <Border Padding="8"
                  Background="{DynamicResource CardBrush}"
                  BorderBrush="{DynamicResource ControlBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="6">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TextBlock FontWeight="SemiBold" Text="Pompacı–Vardiya Atamaları"/>
              <DataGrid Grid.Row="1"
                        Margin="0,8,0,0"
                        ItemsSource="{Binding Assignments}"
                        SelectedItem="{Binding SelectedAssignment}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Pompacı" Width="1.4*" Binding="{Binding Attendant}"/>
                  <DataGridTextColumn Header="Vardiya" Width="1.2*" Binding="{Binding Shift}"/>
                  <DataGridTextColumn Header="Saat" Width="1.1*" Binding="{Binding Schedule}"/>
                  <DataGridTextColumn Header="İstasyon" Width="1.4*" Binding="{Binding Station}"/>
                  <DataGridTextColumn Header="Durum" Width="0.75*" Binding="{Binding ActiveDisplay}"/>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>
          <Border Grid.Column="1"
                  Margin="14,0,0,0"
                  Padding="14"
                  Background="{DynamicResource ControlBackgroundBrush}"
                  BorderBrush="{DynamicResource ControlBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="6">
            <StackPanel>
              <TextBlock FontSize="17" FontWeight="SemiBold" Text="3. Atamayı Oluşturun"/>
              <TextBlock Margin="0,3,0,12"
                         Foreground="{DynamicResource MutedForegroundBrush}"
                         Text="Özet seçiminizi doğrulayın. Atama yalnızca aynı istasyondaki kayıtlar için etkinleşir."/>
              <TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="SEÇİLİ POMPACI"/>
              <TextBlock Margin="0,4,0,10" FontWeight="SemiBold" Text="{Binding SelectedAttendantSummary}"/>
              <TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="SEÇİLİ VARDİYA"/>
              <TextBlock Margin="0,4,0,10" FontWeight="SemiBold" Text="{Binding SelectedShiftSummary}"/>
              <TextBlock Margin="0,0,0,14"
                         Foreground="{DynamicResource MutedForegroundBrush}"
                         Text="{Binding AssignmentReadinessMessage}"
                         TextWrapping="Wrap"/>
              <Button HorizontalAlignment="Left"
                      Style="{StaticResource PrimaryButtonStyle}"
                      Command="{Binding AssignCommand}"
                      Content="Vardiyaya Ata"/>
              <Separator Margin="0,16,0,10"/>
              <TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="SEÇİLİ ATAMA"/>
              <TextBlock Margin="0,4,0,10"
                         Text="{Binding SelectedAssignment.Attendant, TargetNullValue=Henüz seçilmedi}"/>
              <Button HorizontalAlignment="Left"
                      Style="{StaticResource SecondaryActionButtonStyle}"
                      Command="{Binding ToggleAssignmentActiveCommand}"
                      Content="Aktif / Pasif Değiştir"/>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
