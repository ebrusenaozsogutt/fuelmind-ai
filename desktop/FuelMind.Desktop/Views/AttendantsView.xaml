<UserControl x:Class="FuelMind.Desktop.Views.AttendantsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock FontSize="28" FontWeight="SemiBold" Text="Pompacı &amp; Vardiya"/><TextBlock Foreground="#FFB4B4" Text="{Binding ErrorMessage}"/><TextBlock Foreground="LightGreen" Text="{Binding SuccessMessage}"/></StackPanel><TabControl Grid.Row="1" Margin="0,14,0,0"><TabItem Header="Pompacılar"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><DataGrid ItemsSource="{Binding Attendants}" SelectedItem="{Binding SelectedAttendant}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Kod" Binding="{Binding Code}"/><DataGridTextColumn Header="Ad Soyad" Binding="{Binding FullName}"/><DataGridTextColumn Header="Personel" Binding="{Binding EmployeeNumber}"/><DataGridTextColumn Header="İstasyon" Binding="{Binding StationId}"/><DataGridTextColumn Header="Telefon" Binding="{Binding Phone}"/><DataGridCheckBoxColumn Header="Aktif" Binding="{Binding IsActive}"/></DataGrid.Columns></DataGrid><StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBox Text="{Binding Code}"/><TextBox Text="{Binding FullName}"/><TextBox Text="{Binding EmployeeNumber}"/><TextBox Text="{Binding Phone}"/><ComboBox Style="{StaticResource DarkComboBoxStyle}" ItemsSource="{Binding Stations}" SelectedItem="{Binding SelectedStation}" DisplayMemberPath="DisplayName"/><Button Content="Kaydet" Command="{Binding SaveAttendantCommand}"/><Button Content="Pasife Al" Command="{Binding DeactivateAttendantCommand}"/><Button Content="Vardiya Ata" Command="{Binding AssignCommand}"/></StackPanel></Grid></TabItem><TabItem Header="Vardiyalar"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><DataGrid ItemsSource="{Binding Shifts}" SelectedItem="{Binding SelectedShift}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Kod" Binding="{Binding Code}"/><DataGridTextColumn Header="Ad" Binding="{Binding Name}"/><DataGridTextColumn Header="Saat" Binding="{Binding Schedule}"/><DataGridTextColumn Header="İstasyon" Binding="{Binding StationId}"/><DataGridCheckBoxColumn Header="Aktif" Binding="{Binding IsActive}"/></DataGrid.Columns></DataGrid><StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBox Text="{Binding ShiftCode}"/><TextBox Text="{Binding ShiftName}"/><TextBox Text="{Binding StartTime}"/><TextBox Text="{Binding EndTime}"/><ComboBox Style="{StaticResource DarkComboBoxStyle}" ItemsSource="{Binding Stations}" SelectedItem="{Binding SelectedStation}" DisplayMemberPath="DisplayName"/><Button Content="Kaydet" Command="{Binding SaveShiftCommand}"/><Button Content="Pasife Al" Command="{Binding DeactivateShiftCommand}"/></StackPanel></Grid></TabItem><TabItem Header="Atamalar"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid ItemsSource="{Binding Assignments}" SelectedItem="{Binding SelectedAssignment}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Pompacı" Binding="{Binding Attendant}"/><DataGridTextColumn Header="Vardiya" Binding="{Binding Shift}"/><DataGridTextColumn Header="İstasyon" Binding="{Binding Station}"/><DataGridTextColumn Header="Durum" Binding="{Binding ActiveDisplay}"/></DataGrid.Columns></DataGrid><Button Grid.Row="1" Margin="0,12,0,0" HorizontalAlignment="Left" Content="Aktif / Pasif Değiştir" Command="{Binding ToggleAssignmentActiveCommand}"/></Grid></TabItem></TabControl></Grid></UserControl>
