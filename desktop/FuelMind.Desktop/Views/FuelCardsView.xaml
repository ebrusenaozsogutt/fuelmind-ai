<UserControl x:Class="FuelMind.Desktop.Views.FuelCardsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolToVisibility"/></UserControl.Resources>
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><TextBlock FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource AppForegroundBrush}" Text="Kart Yönetimi"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><TextBox Width="240" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Kart, ID Unit veya araç ara"/><Button Margin="8,0" Content="Ara / Yenile" Command="{Binding LoadCommand}"/><Button Margin="8,0" Content="+ Yeni Kart" Command="{Binding OpenCreateCardCommand}" IsEnabled="{Binding IsAdmin}"/><Button Margin="8,0" Content="Düzenle" Command="{Binding OpenEditCardCommand}" IsEnabled="{Binding IsAdmin}"/><Button Margin="8,0" Content="Pasife Al" Command="{Binding DeactivateCardCommand}" IsEnabled="{Binding IsAdmin}"/></StackPanel><TextBlock Foreground="IndianRed" Text="{Binding ErrorMessage}"/></StackPanel>
    <Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.1*" MinWidth="460"/></Grid.ColumnDefinitions>
      <DataGrid AutoGenerateColumns="False" ItemsSource="{Binding Cards}" SelectedItem="{Binding SelectedCard}" IsReadOnly="True" RowHeight="34"><DataGrid.Columns><DataGridTextColumn Header="Kart" Width="1.5*" Binding="{Binding DisplayName}"/><DataGridTextColumn Header="Kod" Width="1.1*" Binding="{Binding CardCode}"/><DataGridTextColumn Header="ID Unit" Width="1.2*" Binding="{Binding UnitId}"/><DataGridTextColumn Header="Durum" Width="0.9*" Binding="{Binding Status}"/><DataGridTextColumn Header="Ödeme" Width="0.9*" Binding="{Binding PaymentType}"/><DataGridCheckBoxColumn Header="Aktif" Width="0.6*" Binding="{Binding IsActive}"/></DataGrid.Columns></DataGrid>
      <Border Grid.Column="1" Margin="16,0,0,0" Padding="12" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"><ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource CardBrush}"><StackPanel>
        <Border Padding="10" Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="4"><StackPanel><TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding SelectedCard.DisplayName, TargetNullValue=Kart seçin}"/><TextBlock Text="{Binding SelectedCard.CardCode, StringFormat=Kart kodu: {0}}"/><TextBlock Text="{Binding SelectedCard.UnitId, StringFormat=ID Unit: {0}}"/><TextBlock Text="{Binding SelectedCard.VehicleLabel, StringFormat=Plaka: {0}}"/><TextBlock Text="{Binding SelectedCard.CustomerLabel, StringFormat=Müşteri: {0}}"/><TextBlock Text="{Binding SelectedCard.Status, StringFormat=Durum: {0}}"/><TextBlock Text="{Binding SelectedCard.PaymentType, StringFormat=Ödeme tipi: {0}}"/><TextBlock Text="{Binding SelectedCard.ValidFrom, StringFormat=Başlangıç: {0:dd.MM.yyyy}}"/><TextBlock Text="{Binding SelectedCard.ValidUntil, StringFormat=Bitiş: {0:dd.MM.yyyy}, TargetNullValue=Bitiş: —}"/><TextBlock Text="{Binding SelectedCard.PrepaidBalance, StringFormat=Bakiye: {0:N2} TL}"/><TextBlock Text="{Binding SelectedCard.CreditLimit, StringFormat=Kredi limiti: {0:N2} TL}"/><TextBlock Text="{Binding SelectedCard.CreditUsed, StringFormat=Kullanılan kredi: {0:N2} TL}"/><TextBlock Text="{Binding SelectedCard.AvailableCredit, StringFormat=Kalan limit: {0:N2} TL}"/></StackPanel></Border>
        <StackPanel Margin="0,8,0,0"><TextBlock Text="{Binding SelectedCard.FleetLabel, StringFormat=Filo: {0}}"/><TextBlock Text="{Binding SelectedCard.FleetGroupLabel, StringFormat=Grup: {0}}"/></StackPanel>
        <TabControl Margin="0,10,0,0" Style="{StaticResource CommercialTabControlStyle}">
          <TabItem Header="Limitler"><StackPanel Margin="6"><Button Content="+ Limit Ekle" Command="{Binding OpenCreateLimitCommand}" IsEnabled="{Binding IsAdmin}"/><DataGrid Margin="0,6,0,0" MinHeight="180" AutoGenerateColumns="False" ItemsSource="{Binding Limits}" SelectedItem="{Binding SelectedLimit}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Tip" Width="1.1*" Binding="{Binding LimitType}"/><DataGridTextColumn Header="Litre" Width="1*" Binding="{Binding QuantityLimitLiters, StringFormat={}{0:N2} L}"/><DataGridCheckBoxColumn Header="Aktif" Width="0.6*" Binding="{Binding IsActive}"/><DataGridTemplateColumn Header="İşlem" Width="1.6*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="Düzenle" Command="{Binding DataContext.OpenEditLimitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/><Button Margin="4,0" Content="Pasife Al" Command="{Binding DataContext.DeactivateLimitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></StackPanel></TabItem>
          <TabItem Header="İstasyon İzni"><StackPanel Margin="6"><TextBlock FontWeight="SemiBold" Text="İzin verilen istasyonlar"/><TextBlock Margin="0,4" Text="İzin kaydı yoksa kart hiçbir istasyonda yetkili değildir." TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,6"><TextBox Width="80" Text="{Binding StationId}" ToolTip="İstasyon ID"/><Button Margin="6,0" Content="Yetki Ver" Command="{Binding AddStationCommand}" IsEnabled="{Binding IsAdmin}"/></StackPanel><ItemsControl ItemsSource="{Binding AllowedStations}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,4"><Button DockPanel.Dock="Right" Content="Yetkiyi Kaldır" Command="{Binding DataContext.RemoveStationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/><TextBlock Text="{Binding StationDisplayName, StringFormat={}{0} — Yetkili}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></TabItem>
          <TabItem Header="Yakıt İzni"><StackPanel Margin="6"><TextBlock FontWeight="SemiBold" Text="İzin verilen yakıtlar"/><TextBlock Margin="0,4" Text="İzin kaydı yoksa kart hiçbir yakıt türünde yetkili değildir." TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,6"><TextBox Width="80" Text="{Binding FuelTypeId}" ToolTip="Yakıt türü ID"/><Button Margin="6,0" Content="Yetki Ver" Command="{Binding AddFuelTypeCommand}" IsEnabled="{Binding IsAdmin}"/></StackPanel><ItemsControl ItemsSource="{Binding AllowedFuelTypes}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,4"><Button DockPanel.Dock="Right" Content="Yetkiyi Kaldır" Command="{Binding DataContext.RemoveFuelTypeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/><TextBlock Text="{Binding FuelTypeDisplayName, StringFormat={}{0} — Yetkili}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></TabItem>
          <TabItem Header="Kullanım Zamanları"><StackPanel Margin="6"><Button Content="+ Zaman Aralığı Ekle" Command="{Binding OpenCreateUsageWindowCommand}" IsEnabled="{Binding IsAdmin}"/><TextBlock Margin="0,8" Text="Zaman kısıtı yok — kart 7/24 kullanılabilir." Visibility="{Binding HasNoUsageWindows, Converter={StaticResource BoolToVisibility}}"/><DataGrid AutoGenerateColumns="False" ItemsSource="{Binding UsageWindows}" SelectedItem="{Binding SelectedUsageWindow}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Gün" Binding="{Binding DayOfWeek}"/><DataGridTextColumn Header="Başlangıç" Binding="{Binding StartTime}"/><DataGridTextColumn Header="Bitiş" Binding="{Binding EndTime}"/><DataGridCheckBoxColumn Header="Aktif" Binding="{Binding IsActive}"/></DataGrid.Columns></DataGrid></StackPanel></TabItem>
          <TabItem Header="Yetkilendirme"><StackPanel Margin="6"><TextBlock Text="İstasyon"/><TextBox Text="{Binding StationId}"/><TextBlock Text="Yakıt"/><TextBox Text="{Binding FuelTypeId}"/><TextBlock Text="Litre"/><TextBox Text="{Binding PreviewLiters}"/><TextBlock Text="Tarih/Saat"/><DatePicker SelectedDate="{Binding PreviewAt}"/><Button Margin="0,8,0,0" Content="Yetkilendirme Önizle" Command="{Binding PreviewAuthorizationCommand}"/><Border Margin="0,8,0,0" Padding="8" Background="{DynamicResource RowSelectedBrush}"><TextBlock TextWrapping="Wrap" Text="{Binding AuthorizationMessage}"/></Border></StackPanel></TabItem>
        </TabControl></StackPanel></ScrollViewer></Border>
      <Border Grid.ColumnSpan="2" Background="#99000000" Visibility="{Binding IsCardFormOpen, Converter={StaticResource BoolToVisibility}}"><Border Width="620" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource CardBrush}"><ScrollViewer><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="22" FontWeight="SemiBold" Text="Kart Formu"/><TextBlock Text="Müşteri"/><ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="Name"/><TextBlock Text="Filo"/><ComboBox ItemsSource="{Binding Fleets}" SelectedItem="{Binding SelectedFleet}" DisplayMemberPath="Name"/><TextBlock Text="Grup"/><ComboBox ItemsSource="{Binding FleetGroups}" SelectedItem="{Binding SelectedFleetGroup}" DisplayMemberPath="Name"/><TextBlock Text="Araç"/><ComboBox ItemsSource="{Binding Vehicles}" SelectedItem="{Binding SelectedVehicle}" DisplayMemberPath="CardSelectionLabel"/></StackPanel><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="Kart Adı"/><TextBox Text="{Binding CardDisplayName}"/><TextBlock Text="Kart Kodu"/><TextBox Text="{Binding CardCode}"/><TextBlock Text="ID Unit"/><TextBox Text="{Binding CardUnitId}"/><TextBlock Text="Kart Durumu"/><ComboBox ItemsSource="{Binding CardStatuses}" SelectedItem="{Binding CardStatus}"/><TextBlock Text="Geçerlilik Başlangıcı"/><DatePicker SelectedDate="{Binding CardValidFrom}"/><TextBlock Text="Geçerlilik Bitişi"/><DatePicker SelectedDate="{Binding CardValidUntil}"/><TextBlock Text="Ödeme Tipi"/><ComboBox ItemsSource="{Binding PaymentTypes}" SelectedItem="{Binding CardPaymentType}"/><StackPanel Visibility="{Binding IsPrepaid, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Bakiye"/><TextBox Text="{Binding CardPrepaidBalance}"/></StackPanel><StackPanel Visibility="{Binding IsCredit, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Kredi Limiti"/><TextBox Text="{Binding CardCreditLimit}"/></StackPanel><CheckBox Content="Aktif" IsChecked="{Binding CardIsActive}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="İptal" Command="{Binding CancelCardFormCommand}"/><Button Margin="8,0" Content="Kaydet" Command="{Binding SaveCardCommand}"/></StackPanel></StackPanel></Grid></ScrollViewer></Border></Border>
      <Border Grid.ColumnSpan="2" Background="#99000000" Visibility="{Binding IsLimitFormOpen, Converter={StaticResource BoolToVisibility}}"><Border Width="420" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource CardBrush}"><StackPanel><TextBlock FontSize="20" Text="Limit"/><ComboBox ItemsSource="{Binding LimitTypes}" SelectedItem="{Binding NewLimitType}"/><TextBox Text="{Binding NewLimitLiters}" ToolTip="Litre limiti"/><DatePicker SelectedDate="{Binding LimitValidFrom}"/><DatePicker SelectedDate="{Binding LimitValidUntil}"/><CheckBox Content="Aktif" IsChecked="{Binding LimitIsActive}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="İptal" Command="{Binding CancelLimitFormCommand}"/><Button Margin="8,0" Content="Kaydet" Command="{Binding SaveLimitCommand}"/></StackPanel></StackPanel></Border></Border>
      <Border Grid.ColumnSpan="2" Background="#99000000" Visibility="{Binding IsUsageWindowFormOpen, Converter={StaticResource BoolToVisibility}}"><Border Width="420" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource CardBrush}"><StackPanel><TextBlock FontSize="20" Text="Kullanım Zamanı"/><ComboBox ItemsSource="{Binding Weekdays}" SelectedItem="{Binding SelectedWeekday}" DisplayMemberPath="Name"/><TextBox Text="{Binding UsageWindowStart}" ToolTip="Başlangıç saati"/><TextBox Text="{Binding UsageWindowEnd}" ToolTip="Bitiş saati"/><CheckBox Content="Aktif" IsChecked="{Binding UsageWindowIsActive}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="İptal" Command="{Binding CancelUsageWindowFormCommand}"/><Button Margin="8,0" Content="Kaydet" Command="{Binding SaveUsageWindowCommand}"/></StackPanel></StackPanel></Border></Border>
    </Grid>
  </Grid>
</UserControl>
