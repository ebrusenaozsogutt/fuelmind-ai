<UserControl x:Class="FuelMind.Desktop.Views.TankDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FuelMind.Desktop.Controls"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <Button HorizontalAlignment="Left" Command="{Binding BackCommand}" Content="← Tanklara Dön" />
            <TextBlock Margin="0,16,0,0" FontSize="26" Text="{Binding Tank.Code, TargetNullValue=Canlı veri yok}" />
            <TextBlock Text="{Binding Tank.TankId, StringFormat=Tank ID: {0}}" />
            <UniformGrid Margin="0,14,0,0" Columns="3">
                <TextBlock Text="{Binding Tank.MeasuredLevelLiters, StringFormat=Ölçülen seviye: {0:N0} L}" /><TextBlock Text="{Binding Tank.TrueLevelLiters, StringFormat=Gerçek seviye: {0:N0} L}" />
                <TextBlock Text="{Binding Tank.CapacityLiters, StringFormat=Kapasite: {0:N0} L}" /><TextBlock Text="{Binding Fill, StringFormat=Doluluk: {0:N0}%}" />
                <TextBlock Text="{Binding Tank.Temperature, StringFormat=Sıcaklık: {0:N1}}" /><TextBlock Text="{Binding Tank.WaterLevel, StringFormat=Su seviyesi: {0:N1}}" />
            </UniformGrid>
            <lvc:CartesianChart Height="300" Margin="0,16,0,0" Background="{DynamicResource AppBackgroundBrush}" Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" />
            <controls:AiAnalysisControl Margin="0,18,0,20" Result="{Binding AiAnalysis}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
