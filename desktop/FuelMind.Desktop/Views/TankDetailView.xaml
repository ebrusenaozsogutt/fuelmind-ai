<UserControl x:Class="FuelMind.Desktop.Views.TankDetailView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"><StackPanel Margin="28"><Button HorizontalAlignment="Left" Command="{Binding BackCommand}" Content="← Tanklara Dön"/><TextBlock Margin="0,16,0,0" FontSize="26" Text="{Binding Tank.Code, TargetNullValue=Canlı veri yok}"/><TextBlock Text="{Binding Tank.TankId, StringFormat=Tank ID: {0}}"/><UniformGrid Columns="3"><TextBlock Text="{Binding Tank.MeasuredLevelLiters, StringFormat=Measured: {0:N0} L}"/><TextBlock Text="{Binding Tank.TrueLevelLiters, StringFormat=True: {0:N0} L}"/><TextBlock Text="{Binding Tank.CapacityLiters, StringFormat=Capacity: {0:N0} L}"/><TextBlock Text="{Binding Fill, StringFormat=Fill: {0:N0}%}"/><TextBlock Text="{Binding Tank.Temperature, StringFormat=Temperature: {0:N1}}"/><TextBlock Text="{Binding Tank.WaterLevel, StringFormat=Water: {0:N1}}"/></UniformGrid><lvc:CartesianChart Height="300" Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}"/></StackPanel></UserControl>
