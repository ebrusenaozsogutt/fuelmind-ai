<UserControl x:Class="FuelMind.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="24">
        <Border Width="420" Padding="36" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#1B2732" BorderBrush="#355063" BorderThickness="1" CornerRadius="8">
            <StackPanel>
                <TextBlock FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource AppForegroundBrush}"
                           Text="FuelMind AI" />
                <TextBlock Margin="0,6,0,28" Foreground="#B8C7D1"
                           Text="Operasyon yönetim platformuna giriş yapın." TextWrapping="Wrap" />
                <TextBlock Foreground="{DynamicResource AppForegroundBrush}" Text="Kullanıcı adı" />
                <TextBox Margin="0,6,0,18" Padding="10,7" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Foreground="{DynamicResource AppForegroundBrush}" Text="Şifre" />
                <PasswordBox x:Name="PasswordInput" Margin="0,6,0,8" Padding="10,7" PasswordChanged="OnPasswordChanged" />
                <TextBox x:Name="VisiblePasswordInput" Margin="0,6,0,8" Padding="10,7" Visibility="Collapsed" TextChanged="OnVisiblePasswordChanged" />
                <CheckBox Margin="0,0,0,14" Foreground="{DynamicResource AppForegroundBrush}"
                          Content="Şifreyi göster" IsChecked="{Binding IsPasswordVisible}"
                          Checked="OnPasswordVisibilityChanged" Unchecked="OnPasswordVisibilityChanged" />
                <CheckBox Margin="0,0,0,18" Foreground="{DynamicResource AppForegroundBrush}"
                          Content="Beni hatırla" IsChecked="{Binding RememberMe}"
                          ToolTip="Bu aşamada parola veya oturum bilgisi kalıcı olarak saklanmaz." />
                <TextBlock Margin="0,0,0,12" Foreground="#FFB4AB" TextWrapping="Wrap" Text="{Binding ErrorMessage}" />
                <TextBlock Margin="0,0,0,12" Foreground="#B8C7D1" Text="Giriş yapılıyor..."
                           Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Button Height="38" IsDefault="True" Click="OnLoginClick" Content="Giriş Yap">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
