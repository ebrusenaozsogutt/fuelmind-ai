<UserControl x:Class="FuelMind.Desktop.Views.AlarmsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FuelMind.Desktop.Controls">
    <Grid Margin="{DynamicResource PageContentMargin}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Alarm Merkezi" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="Canlı operasyonel uyarılar: AI, kural, veri kalitesi ve eşik olaylarını değerlendirin." />
                <WrapPanel Margin="0,16,0,0">
                    <StackPanel Margin="0,0,12,0"><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="Durum" /><ComboBox Style="{StaticResource DarkComboBoxStyle}" Width="145" Margin="0,5,0,0" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" /></StackPanel>
                    <StackPanel Margin="0,0,12,0"><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="Önem" /><ComboBox Style="{StaticResource DarkComboBoxStyle}" Width="120" Margin="0,5,0,0" ItemsSource="{Binding SeverityFilters}" SelectedItem="{Binding SeverityFilter}" /></StackPanel>
                    <StackPanel><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="Tip" /><ComboBox Style="{StaticResource DarkComboBoxStyle}" Width="190" Margin="0,5,0,0" ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding TypeFilter}" /></StackPanel>
                </WrapPanel>
                <TextBlock Margin="0,10,0,0" Foreground="#FFB4B4" Text="{Binding LastError}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Width="88" VerticalAlignment="Top" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding RefreshCommand}" Content="Yenile" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="2*" MinWidth="360" /></Grid.ColumnDefinitions>
            <Grid>
                <ListBox ItemsSource="{Binding FilteredAlarms}" SelectedItem="{Binding SelectedAlarm}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate>
                        <Border x:Name="Card" Margin="0,0,0,10" Padding="16" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="14">
                            <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="3,1,1,1" /><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AppForegroundBrush}" Text="{Binding TitleDisplay}" TextWrapping="Wrap" /><TextBlock Margin="0,6,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding DescriptionDisplay}" TextWrapping="Wrap" /><TextBlock Margin="0,8,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding DetectedAt, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}" /><TextBlock Margin="0,4,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding TargetDisplay}" /></StackPanel>
                                <StackPanel Grid.Column="1" MaxWidth="150" Margin="16,0,0,0" HorizontalAlignment="Right"><Border Style="{StaticResource AlarmBadgeStyle}" Background="{Binding Severity, Converter={StaticResource AlarmSeverityToBrushConverter}}"><TextBlock Text="{Binding SeverityDisplay}" /></Border><Border Margin="0,6,0,0" Style="{StaticResource AlarmBadgeStyle}" Background="{Binding Status, Converter={StaticResource AlarmStatusToBrushConverter}}"><TextBlock Text="{Binding StatusDisplay}" /></Border><TextBlock Margin="0,8,0,0" HorizontalAlignment="Right" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding AlarmTypeDisplay}" TextAlignment="Right" TextWrapping="Wrap" /></StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <Border Padding="28" Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="14" IsHitTestVisible="False"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding FilteredAlarms.IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AppForegroundBrush}" Text="Aktif alarm bulunamadı" /><TextBlock Margin="0,8,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="Filtreleri değiştirebilir veya daha sonra yenileyebilirsiniz." TextAlignment="Center" TextWrapping="Wrap" /></StackPanel></Border>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource PremiumDetailPanelStyle}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel>
                    <TextBlock FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource AppForegroundBrush}" Text="{Binding SelectedAlarm.TitleDisplay, TargetNullValue=Alarm seçin}" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,12,0,0"><Border Style="{StaticResource AlarmBadgeStyle}" Background="{Binding SelectedAlarm.Severity, Converter={StaticResource AlarmSeverityToBrushConverter}}"><TextBlock Text="{Binding SelectedAlarm.SeverityDisplay}" /></Border><Border Margin="8,0,0,0" Style="{StaticResource AlarmBadgeStyle}" Background="{Binding SelectedAlarm.Status, Converter={StaticResource AlarmStatusToBrushConverter}}"><TextBlock Text="{Binding SelectedAlarm.StatusDisplay}" /></Border></WrapPanel>
                    <TextBlock Margin="0,18,0,0" FontWeight="SemiBold" Foreground="{DynamicResource AppForegroundBrush}" Text="Hedef" /><TextBlock Margin="0,4,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding SelectedAlarm.TargetDisplay}" />
                    <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Foreground="{DynamicResource AppForegroundBrush}" Text="Alarm tipi" /><TextBlock Margin="0,4,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding SelectedAlarm.AlarmTypeDisplay}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding SelectedAlarm.DetectedAt, StringFormat=Tespit: {0:dd.MM.yyyy HH:mm:ss}}" />
                    <controls:AlarmAiAnalysisControl Alarm="{Binding SelectedAlarm}" />
                    <TextBlock Margin="0,18,0,0" FontWeight="SemiBold" Foreground="{DynamicResource AppForegroundBrush}" Text="Açıklama" /><TextBlock Margin="0,4,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding SelectedAlarm.DescriptionDisplay}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,18,0,0" FontWeight="SemiBold" Foreground="{DynamicResource AppForegroundBrush}" Text="Muhtemel nedenler" /><ItemsControl Margin="0,5,0,0" ItemsSource="{Binding SelectedAlarm.ProbableCauses}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="0,2,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding DisplayDescription, StringFormat=• {0}}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <TextBlock Margin="0,18,0,0" FontWeight="SemiBold" Foreground="{DynamicResource AppForegroundBrush}" Text="Önerilen işlem" /><TextBlock Margin="0,5,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding SelectedAlarm.RecommendedActionDisplay}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,18,0,0" FontWeight="SemiBold" Foreground="{DynamicResource AppForegroundBrush}" Text="İlişkili arıza" /><TextBlock Margin="0,5,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding FaultRelationText}" TextWrapping="Wrap" />
                    <Button Margin="0,8,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding OpenRelatedFaultCommand}" IsEnabled="{Binding CanOpenRelatedFault}" Content="Arıza Yönetiminde Aç" />
                    <TextBlock Margin="0,18,0,5" Foreground="{DynamicResource MutedForegroundBrush}" Text="Çözüm notu" /><TextBox Height="68" Padding="8" Foreground="{DynamicResource AppForegroundBrush}" Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" AcceptsReturn="True" Text="{Binding ResolutionNote, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,16,0,0"><Button Margin="0,0,10,10" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AcknowledgeCommand}" IsEnabled="{Binding CanAcknowledge}" Content="Onayla" /><Button Margin="0,0,10,10" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding InvestigateCommand}" IsEnabled="{Binding CanInvestigate}" Content="İncele" /><Button Margin="0,0,10,10" Style="{StaticResource SecondaryActionButtonStyle}" Command="{Binding ResolveCommand}" IsEnabled="{Binding CanResolve}" Content="Çöz" /><Button Margin="0,0,10,10" Style="{StaticResource GhostButtonStyle}" Command="{Binding FalsePositiveCommand}" IsEnabled="{Binding CanFalsePositive}" Content="Yanlış Alarm Olarak İşaretle" /></WrapPanel>
                </StackPanel></ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
