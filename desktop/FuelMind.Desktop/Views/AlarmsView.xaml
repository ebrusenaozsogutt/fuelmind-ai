<UserControl x:Class="FuelMind.Desktop.Views.AlarmsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource AppForegroundBrush}" Text="Alarm Merkezi" />
                <WrapPanel Margin="0,16,0,0">
                    <StackPanel Margin="0,0,12,0"><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="Durum" /><ComboBox Style="{StaticResource DarkComboBoxStyle}" Width="145" Margin="0,5,0,0" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" /></StackPanel>
                    <StackPanel Margin="0,0,12,0"><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="Önem" /><ComboBox Style="{StaticResource DarkComboBoxStyle}" Width="120" Margin="0,5,0,0" ItemsSource="{Binding SeverityFilters}" SelectedItem="{Binding SeverityFilter}" /></StackPanel>
                    <StackPanel><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="Tip" /><ComboBox Style="{StaticResource DarkComboBoxStyle}" Width="190" Margin="0,5,0,0" ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding TypeFilter}" /></StackPanel>
                </WrapPanel>
                <TextBlock Margin="0,10,0,0" Foreground="#FFB4B4" Text="{Binding LastError}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Width="88" Height="34" VerticalAlignment="Top" Padding="12,5" Command="{Binding RefreshCommand}" Content="Yenile" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid>
                <ListBox ItemsSource="{Binding FilteredAlarms}" SelectedItem="{Binding SelectedAlarm}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate>
                        <Border x:Name="Card" Margin="0,0,0,10" Padding="16" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6">
                            <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="BorderBrush" Value="#38BDF8" /><Setter Property="BorderThickness" Value="4,1,1,1" /><Setter Property="Background" Value="#29485A" /></DataTrigger></Style.Triggers></Style></Border.Style>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AppForegroundBrush}" Text="{Binding Title}" TextWrapping="Wrap" /><TextBlock Margin="0,6,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding Description}" TextWrapping="Wrap" /><TextBlock Margin="0,8,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding DetectedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" /><TextBlock Margin="0,4,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding TargetDisplay}" /></StackPanel>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" HorizontalAlignment="Right"><Border Style="{StaticResource AlarmBadgeStyle}" Background="{Binding Severity, Converter={StaticResource AlarmSeverityToBrushConverter}}"><TextBlock Text="{Binding Severity}" /></Border><Border Margin="0,6,0,0" Style="{StaticResource AlarmBadgeStyle}" Background="{Binding Status, Converter={StaticResource AlarmStatusToBrushConverter}}"><TextBlock Text="{Binding Status}" /></Border><TextBlock Margin="0,8,0,0" HorizontalAlignment="Right" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding AlarmType}" /></StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <Border Padding="24" Background="{DynamicResource CardBrush}" CornerRadius="6" IsHitTestVisible="False"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding FilteredAlarms.IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AppForegroundBrush}" Text="Aktif alarm bulunamadı" /><TextBlock Margin="0,8,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="Filtreleri değiştirebilir veya daha sonra yenileyebilirsiniz." TextAlignment="Center" TextWrapping="Wrap" /></StackPanel></Border>
            </Grid>

            <Border Grid.Column="2" Padding="18" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    <TextBlock FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource AppForegroundBrush}" Text="{Binding SelectedAlarm.Title, TargetNullValue=Alarm seçin}" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,12,0,0"><Border Style="{StaticResource AlarmBadgeStyle}" Background="{Binding SelectedAlarm.Severity, Converter={StaticResource AlarmSeverityToBrushConverter}}"><TextBlock Text="{Binding SelectedAlarm.Severity}" /></Border><Border Margin="8,0,0,0" Style="{StaticResource AlarmBadgeStyle}" Background="{Binding SelectedAlarm.Status, Converter={StaticResource AlarmStatusToBrushConverter}}"><TextBlock Text="{Binding SelectedAlarm.Status}" /></Border></WrapPanel>
                    <TextBlock Margin="0,18,0,0" FontWeight="SemiBold" Foreground="{DynamicResource AppForegroundBrush}" Text="Hedef" /><TextBlock Margin="0,4,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding SelectedAlarm.TargetDisplay}" />
                    <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Foreground="{DynamicResource AppForegroundBrush}" Text="Alarm tipi" /><TextBlock Margin="0,4,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding SelectedAlarm.AlarmType}" />
                    <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding SelectedAlarm.DetectedAt, StringFormat=Tespit: {0:yyyy-MM-dd HH:mm:ss}}" />
                    <TextBlock Margin="0,18,0,0" FontWeight="SemiBold" Foreground="{DynamicResource AppForegroundBrush}" Text="Açıklama" /><TextBlock Margin="0,4,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding SelectedAlarm.Description}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,18,0,0" FontWeight="SemiBold" Foreground="{DynamicResource AppForegroundBrush}" Text="Muhtemel nedenler" /><ItemsControl Margin="0,5,0,0" ItemsSource="{Binding SelectedAlarm.ProbableCauses}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="0,2,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding Description, StringFormat=• {0}}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <TextBlock Margin="0,18,0,0" FontWeight="SemiBold" Foreground="{DynamicResource AppForegroundBrush}" Text="Önerilen işlem" /><TextBlock Margin="0,5,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding SelectedAlarm.RecommendedActionDisplay}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,18,0,5" Foreground="{DynamicResource MutedForegroundBrush}" Text="Çözüm notu" /><TextBox Height="68" Padding="8" Foreground="{DynamicResource AppForegroundBrush}" Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" AcceptsReturn="True" Text="{Binding ResolutionNote, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,16,0,0"><Button Margin="0,0,10,10" Padding="14,7" Command="{Binding AcknowledgeCommand}" IsEnabled="{Binding CanAcknowledge}" Content="Onayla" /><Button Margin="0,0,10,10" Padding="14,7" Command="{Binding InvestigateCommand}" IsEnabled="{Binding CanInvestigate}" Content="İncele" /><Button Margin="0,0,10,10" Padding="14,7" Command="{Binding ResolveCommand}" IsEnabled="{Binding CanResolve}" Content="Çöz" /><Button Margin="0,0,10,10" Padding="14,7" Command="{Binding FalsePositiveCommand}" IsEnabled="{Binding CanFalsePositive}" Content="Yanlış Pozitif" /></WrapPanel>
                </StackPanel></ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
