<UserControl x:Class="FuelMind.Desktop.Views.SalesHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="{DynamicResource PageContentMargin}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal">
      <TextBlock FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource AppForegroundBrush}" Text="Satışlar"/>
      <TextBlock Margin="22,7,6,0" Text="Satış türü:"/>
      <ComboBox Width="125" ItemsSource="{Binding SaleTypes}" SelectedItem="{Binding SelectedSaleType}"/>
      <Button Margin="12,0,0,0" Content="Yenile" Command="{Binding LoadCommand}"/>
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,16,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="700"/><ColumnDefinition Width="1.1*" MinWidth="360"/></Grid.ColumnDefinitions>
      <Grid>
      <DataGrid AutoGenerateColumns="False" ItemsSource="{Binding Sales}" SelectedItem="{Binding SelectedSale, Mode=TwoWay}" IsReadOnly="True" RowHeight="34">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Tarih" Width="1.2*" Binding="{Binding SaleTimestamp, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>
          <DataGridTextColumn Header="Tip" Width="0.7*" Binding="{Binding SaleKind}"/>
          <DataGridTextColumn Header="Müşteri" Width="1.5*" Binding="{Binding CustomerLabel}"/>
          <DataGridTextColumn Header="Araç" Width="1.2*" Binding="{Binding VehicleLabel}"/>
          <DataGridTextColumn Header="Kart" Width="1.2*" Binding="{Binding CardLabel}"/>
          <DataGridTextColumn Header="Litre" Width="0.8*" Binding="{Binding QuantityLiters, StringFormat={}{0:N3} L}"/>
          <DataGridTextColumn Header="Toplam" Width="0.9*" Binding="{Binding TotalAmount, StringFormat={}{0:N2} TL}"/>
          <DataGridTextColumn Header="Durum" Width="1*" Binding="{Binding SaleStatus}"/>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding EmptyStateMessage}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </Grid>
      <Border Grid.Column="1" Margin="16,0,0,0" Padding="18" MinWidth="360" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource CardBrush}">
          <StackPanel>
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Satış Detayı"/>
            <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" Text="Ticari Bilgiler"/>
            <TextBlock Text="{Binding SelectedSale.CustomerLabel, StringFormat=Müşteri: {0}}"/><TextBlock Text="{Binding SelectedSale.FleetLabel, StringFormat=Filo: {0}}"/><TextBlock Text="{Binding SelectedSale.FleetGroupLabel, StringFormat=Grup: {0}}"/><TextBlock Text="{Binding SelectedSale.VehicleLabel, StringFormat=Araç: {0}}"/><TextBlock Text="{Binding SelectedSale.DriverLabel, StringFormat=Şoför: {0}}"/><TextBlock Text="{Binding SelectedSale.CardLabel, StringFormat=Kart / ID Unit: {0}}"/>
            <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="Saha Bilgileri"/>
            <TextBlock Text="{Binding SelectedSale.StationLabel, StringFormat=İstasyon: {0}}"/><TextBlock Text="{Binding SelectedSale.PumpLabel, StringFormat=Pompa: {0}}"/><TextBlock Text="{Binding SelectedSale.NozzleId, StringFormat=Nozzle: {0}, TargetNullValue=Nozzle: —}"/><TextBlock Text="{Binding SelectedSale.FuelTypeLabel, StringFormat=Yakıt: {0}}"/>
            <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="Miktar / Totalizer"/>
            <TextBlock Text="{Binding SelectedSale.StartTotalizerLiters, StringFormat=Başlangıç: {0:N3}, TargetNullValue=Başlangıç: —}"/><TextBlock Text="{Binding SelectedSale.EndTotalizerLiters, StringFormat=Bitiş: {0:N3}, TargetNullValue=Bitiş: —}"/><TextBlock Text="{Binding SelectedSale.QuantityLiters, StringFormat=Litre: {0:N3} L}"/>
            <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="Fiyat"/>
            <TextBlock Text="{Binding SelectedSale.ListUnitPrice, StringFormat=Liste: {0:N2} TL, TargetNullValue=Liste: —}"/><TextBlock Text="{Binding SelectedSale.DiscountRate, StringFormat=İskonto: {0:N2}%, TargetNullValue=İskonto: —}"/><TextBlock Text="{Binding SelectedSale.UnitPrice, StringFormat=Uygulanan: {0:N2} TL}"/><TextBlock Text="{Binding SelectedSale.TotalAmount, StringFormat=Toplam: {0:N2} TL}"/>
            <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="İşlem"/>
            <TextBlock Text="{Binding SelectedSale.PaymentType, StringFormat=Ödeme: {0}, TargetNullValue=Ödeme: —}"/><TextBlock Text="{Binding SelectedSale.SaleStatus, StringFormat=Durum: {0}}"/><TextBlock Text="{Binding SelectedSale.AttendantLabel, StringFormat=Pompacı: {0}}"/><TextBlock Text="{Binding SelectedSale.ShiftLabel, StringFormat=Vardiya: {0}}"/><TextBlock Text="{Binding SelectedSale.SaleTimestamp, StringFormat=Tarih: {0:dd.MM.yyyy HH:mm}}"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
