<UserControl x:Class="FuelMind.Desktop.Views.SalesHistoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="{DynamicResource PageContentMargin}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel LastChildFill="False"><StackPanel><TextBlock Style="{StaticResource PageTitleStyle}" Text="Satışlar"/><TextBlock Style="{StaticResource PageSubtitleStyle}" Text="Ticari hareketleri, ödeme ve saha telemetrisi bağlamıyla birlikte inceleyin."/></StackPanel><StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Orientation="Horizontal"><StackPanel><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="SATIŞ TÜRÜ"/><ComboBox Width="135" Margin="0,5,0,0" ItemsSource="{Binding SaleTypes}" SelectedItem="{Binding SelectedSaleType}"/></StackPanel><Button Margin="10,20,0,0" Style="{StaticResource SecondaryActionButtonStyle}" Content="Yenile" Command="{Binding LoadCommand}"/></StackPanel></DockPanel>
    <Grid Grid.Row="1" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="700"/><ColumnDefinition Width="1.1*" MinWidth="360"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource PremiumTablePanelStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel LastChildFill="False"><StackPanel><TextBlock Style="{StaticResource SectionTitleStyle}" Text="Satış Defteri"/><TextBlock Margin="0,3,0,0" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" Text="Tarih, müşteri, kart ve ödeme hareketleri"/></StackPanel><Border DockPanel.Dock="Right" Style="{StaticResource FilterChipStyle}"><TextBlock Text="LIVE LEDGER"/></Border></DockPanel><Grid Grid.Row="1" Margin="0,14,0,0"><DataGrid AutoGenerateColumns="False" ItemsSource="{Binding Sales}" SelectedItem="{Binding SelectedSale, Mode=TwoWay}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Tarih" Width="1.2*" Binding="{Binding SaleTimestamp, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/><DataGridTextColumn Header="Tip" Width="0.7*" Binding="{Binding SaleKind}"/><DataGridTextColumn Header="Müşteri" Width="1.5*" Binding="{Binding CustomerLabel}"/><DataGridTextColumn Header="Araç" Width="1.2*" Binding="{Binding VehicleLabel}"/><DataGridTextColumn Header="Kart" Width="1.2*" Binding="{Binding CardLabel}"/><DataGridTextColumn Header="Litre" Width="0.8*" Binding="{Binding QuantityLiters, StringFormat={}{0:N3} L}"/><DataGridTextColumn Header="Toplam" Width="0.9*" Binding="{Binding TotalAmount, StringFormat={}{0:N2} TL}"/><DataGridTextColumn Header="Durum" Width="1*" Binding="{Binding SaleStatus}"/></DataGrid.Columns></DataGrid><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding EmptyStateMessage}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Grid></Border>
      <Border Grid.Column="1" Margin="16,0,0,0" Style="{StaticResource PremiumDetailPanelStyle}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Border HorizontalAlignment="Left" Style="{StaticResource FilterChipStyle}"><TextBlock Text="SEÇİLİ SATIŞ"/></Border><TextBlock Margin="0,12,0,0" FontSize="20" FontWeight="SemiBold" Text="{Binding SelectedSale.CustomerLabel, TargetNullValue=Satış seçin}"/><TextBlock Margin="0,3,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding SelectedSale.SaleTimestamp, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/><Border Margin="0,16,0,0" Style="{StaticResource PremiumProfileCardStyle}"><StackPanel><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="TİCARİ BİLGİLER"/><TextBlock Margin="0,8,0,0" Text="{Binding SelectedSale.CustomerLabel, StringFormat=Müşteri: {0}}"/><TextBlock Text="{Binding SelectedSale.VehicleLabel, StringFormat=Araç: {0}}"/><TextBlock Text="{Binding SelectedSale.CardLabel, StringFormat=Kart / ID Unit: {0}}"/><TextBlock Text="{Binding SelectedSale.PaymentType, StringFormat=Ödeme: {0}, TargetNullValue=Ödeme: —}"/></StackPanel></Border><Border Style="{StaticResource PremiumProfileCardStyle}"><StackPanel><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="SAHA VE TOTALIZER"/><TextBlock Margin="0,8,0,0" Text="{Binding SelectedSale.StationLabel, StringFormat=İstasyon: {0}}"/><TextBlock Text="{Binding SelectedSale.PumpLabel, StringFormat=Pompa: {0}}"/><TextBlock Text="{Binding SelectedSale.FuelTypeLabel, StringFormat=Yakıt: {0}}"/><TextBlock Text="{Binding SelectedSale.StartTotalizerLiters, StringFormat=Başlangıç: {0:N3}, TargetNullValue=Başlangıç: —}"/><TextBlock Text="{Binding SelectedSale.EndTotalizerLiters, StringFormat=Bitiş: {0:N3}, TargetNullValue=Bitiş: —}"/></StackPanel></Border><Border Style="{StaticResource PremiumProfileCardStyle}"><StackPanel><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="TUTAR"/><TextBlock Margin="0,8,0,0" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="{Binding SelectedSale.TotalAmount, StringFormat={}{0:N2} TL}"/><TextBlock Margin="0,5,0,0" Text="{Binding SelectedSale.QuantityLiters, StringFormat={}{0:N3} L}"/><TextBlock Text="{Binding SelectedSale.UnitPrice, StringFormat=Birim fiyat: {0:N2} TL}"/><TextBlock Text="{Binding SelectedSale.SaleStatus, StringFormat=Durum: {0}}"/></StackPanel></Border></StackPanel></ScrollViewer></Border>
    </Grid>
  </Grid>
</UserControl>
