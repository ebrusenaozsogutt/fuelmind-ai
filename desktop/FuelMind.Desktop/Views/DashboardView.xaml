<UserControl x:Class="FuelMind.Desktop.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28"><TextBlock FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource AppForegroundBrush}" Text="Dashboard"/><UniformGrid Margin="0,24,0,0" Columns="2"><Border Style="{StaticResource DashboardCardStyle}"><TextBlock Text="{Binding TotalStock, StringFormat=Toplam stok: {0}}"/></Border><Border Style="{StaticResource DashboardCardStyle}"><TextBlock Text="{Binding DailySales, StringFormat=Günlük satış: {0}}"/></Border><Border Style="{StaticResource DashboardCardStyle}"><TextBlock Text="{Binding ActivePumpCount, StringFormat=Aktif pompa: {0}}"/></Border><Border Style="{StaticResource DashboardCardStyle}"><TextBlock Text="{Binding ActiveAlarms, StringFormat=Aktif alarm: {0}}"/></Border><Border Style="{StaticResource DashboardCardStyle}"><TextBlock Text="{Binding CriticalAlarms, StringFormat=Kritik alarm: {0}}"/></Border><Border Style="{StaticResource DashboardCardStyle}"><TextBlock Text="{Binding RiskEquipment, StringFormat=Riskli ekipman: {0}}"/></Border><Border Style="{StaticResource DashboardCardStyle}"><TextBlock Text="{Binding LowestStockTank, StringFormat=En yakın kritik stok: {0}}"/></Border><Border Style="{StaticResource DashboardCardStyle}"><TextBlock Text="{Binding StationHealthScore, StringFormat=İstasyon sağlık skoru: {0}}"/></Border></UniformGrid><Border Style="{StaticResource DashboardCardStyle}" Margin="0,16,0,0"><StackPanel><TextBlock FontWeight="SemiBold" Text="Operasyon özeti"/><TextBlock Margin="0,8,0,0" Text="{Binding OperationSummary}" TextWrapping="Wrap"/></StackPanel></Border></StackPanel></ScrollViewer>
</UserControl>
