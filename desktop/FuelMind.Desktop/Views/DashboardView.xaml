<UserControl x:Class="FuelMind.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="28">
      <DockPanel Margin="0,0,0,18">
        <StackPanel>
          <TextBlock Style="{StaticResource PageTitleStyle}" Text="Operasyon Merkezi" />
          <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="İstasyonun canlı durumu, riskleri ve operasyon özeti" />
        </StackPanel>
        <Border DockPanel.Dock="Right" VerticalAlignment="Center" Padding="10,5" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="14">
          <StackPanel Orientation="Horizontal">
            <TextBlock Foreground="{DynamicResource SuccessForegroundBrush}" FontWeight="Bold" Text="●" />
            <TextBlock Margin="5,0,0,0" FontWeight="SemiBold" Text="CANLI" />
            <TextBlock Margin="5,0,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="·" />
            <TextBlock Margin="5,0,0,0" Text="{Binding ConnectionDisplay}" />
          </StackPanel>
        </Border>
      </DockPanel>

      <WrapPanel>
        <Border Style="{StaticResource KpiCardStyle}"><StackPanel><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="Bugün Satılan Yakıt"/><TextBlock Margin="0,8,0,0" FontSize="27" FontWeight="SemiBold" Text="{Binding DailySales}"/><TextBlock Margin="0,5,0,0" Foreground="{DynamicResource AccentBrush}" Text="Litre bazlı günlük toplam"/></StackPanel></Border>
        <Border Style="{StaticResource KpiCardStyle}"><StackPanel><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="Ortalama Tank Doluluğu"/><TextBlock Margin="0,8,0,0" FontSize="27" FontWeight="SemiBold" Text="{Binding AverageTankFill}"/><TextBlock Margin="0,5,0,0" Foreground="{DynamicResource SuccessForegroundBrush}" Text="Canlı ölçüm"/></StackPanel></Border>
        <Border Style="{StaticResource KpiCardStyle}"><StackPanel><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="Aktif Alarm"/><TextBlock Margin="0,8,0,0" FontSize="27" FontWeight="SemiBold" Text="{Binding ActiveAlarms}"/><TextBlock Margin="0,5,0,0" Foreground="{DynamicResource DangerForegroundBrush}" Text="{Binding CriticalAlarms, StringFormat={}{0} kritik}"/></StackPanel></Border>
        <Border Style="{StaticResource KpiCardStyle}"><StackPanel><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="Aktif Pompa"/><TextBlock Margin="0,8,0,0" FontSize="27" FontWeight="SemiBold" Text="{Binding ActivePumpCount}"/><TextBlock Margin="0,5,0,0" Foreground="{DynamicResource AccentBrush}" Text="Anlık çalışma durumu"/></StackPanel></Border>
        <Border Style="{StaticResource KpiCardStyle}"><StackPanel><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="AI Risk Skoru"/><TextBlock Margin="0,8,0,0" FontSize="27" FontWeight="SemiBold" Text="{Binding AiRiskScore}"/><TextBlock Margin="0,5,0,0" Foreground="{DynamicResource AiAccentBrush}" Text="{Binding AiRiskLevel}"/></StackPanel></Border>
      </WrapPanel>

      <Grid Margin="0,4,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*" MinWidth="400"/><ColumnDefinition Width="*" MinWidth="300"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,20,20">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Operasyon Özeti"/>
            <TextBlock Margin="0,12,0,0" MaxHeight="42" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding OperationSummary}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
            <Border Margin="0,16,0,0" Padding="16" Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="8"><StackPanel><TextBlock FontWeight="SemiBold" Text="Satış ve stok görünümü"/><TextBlock Margin="0,10,0,0" FontSize="24" FontWeight="SemiBold" Text="{Binding StationHealthScore, StringFormat=İstasyon sağlığı: {0}}"/><TextBlock Margin="0,7,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="Canlı veri ile güncellenen istasyon sağlık göstergesi"/></StackPanel></Border>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource SectionCardStyle}">
          <StackPanel>
            <DockPanel><TextBlock Style="{StaticResource SectionTitleStyle}" Text="Risk ve Alarmlar"/><Button DockPanel.Dock="Right" Command="{Binding OpenActiveAlarmsCommand}" Content="Alarmlar"/></DockPanel>
            <TextBlock Margin="0,16,0,0" Text="{Binding HighRiskEquipment, StringFormat=Yüksek / kritik ekipman: {0}}"/>
            <TextBlock Margin="0,8,0,0" Text="{Binding MostRiskyEquipment, StringFormat=En riskli: {0}}" TextWrapping="Wrap"/>
            <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding LastAiAssessment, StringFormat=Son AI değerlendirmesi: {0}}"/>
          </StackPanel>
        </Border>
      </Grid>

      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*" MinWidth="400"/><ColumnDefinition Width="*" MinWidth="300"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,20,20">
          <StackPanel>
            <DockPanel><TextBlock Style="{StaticResource SectionTitleStyle}" Text="Tank Durumları"/><Button DockPanel.Dock="Right" Command="{Binding OpenTanksCommand}" Content="Tankları Aç"/></DockPanel>
            <Grid Margin="0,14,0,0">
              <ItemsControl ItemsSource="{Binding Tanks}"><ItemsControl.Style><Style TargetType="ItemsControl"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasTanks}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ItemsControl.Style><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,0,10,0" Padding="13" Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="8"><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Code, TargetNullValue=Tank}" TextTrimming="CharacterEllipsis"/><TextBlock Margin="0,8,0,0" FontSize="19" FontWeight="SemiBold" Text="{Binding MeasuredLevelLiters, StringFormat={}{0:N0} L}"/><ProgressBar Margin="0,10,0,6" Height="8" Minimum="0" Maximum="{Binding CapacityLiters}" Value="{Binding MeasuredLevelLiters}"/><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding Temperature, StringFormat=Sıcaklık {0:N1} °C}" TextTrimming="CharacterEllipsis"/><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding WaterLevel, StringFormat=Su {0:N1} L}" TextTrimming="CharacterEllipsis"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="Henüz tank verisi bulunmuyor."><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasTanks}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            </Grid>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource SectionCardStyle}">
          <StackPanel>
            <DockPanel><TextBlock Style="{StaticResource SectionTitleStyle}" Text="Pompa Sağlığı"/><Button DockPanel.Dock="Right" Command="{Binding OpenPumpsCommand}" Content="Pompaları Aç"/></DockPanel>
            <Grid Margin="0,14,0,0">
              <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Pumps}"><ItemsControl.Style><Style TargetType="ItemsControl"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasPumps}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ItemsControl.Style><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="75"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock FontWeight="SemiBold" Text="{Binding PumpId, StringFormat=P{0:00}}"/><ProgressBar Grid.Column="1" Height="9" VerticalAlignment="Center" Minimum="0" Maximum="100" Value="{Binding AiAnalysis.RiskScore}"/><TextBlock Grid.Column="2" HorizontalAlignment="Right" Text="{Binding AiAnalysis.RiskDisplay, TargetNullValue=Veri yok}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
              <TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="Henüz pompa verisi bulunmuyor."><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasPumps}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
