<UserControl x:Class="FuelMind.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="{DynamicResource PageContentMargin}">
      <DockPanel Margin="0,0,0,20" LastChildFill="False">
        <StackPanel><TextBlock Style="{StaticResource PageTitleStyle}" Text="Operasyon Merkezi"/><TextBlock Style="{StaticResource PageSubtitleStyle}" Text="İstasyonun canlı durumu, riskleri ve operasyon özeti"/></StackPanel>
        <Border DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource LiveConnectionBadgeStyle}"><StackPanel Orientation="Horizontal"><TextBlock FontSize="10" Foreground="{DynamicResource SuccessForegroundBrush}" FontWeight="Bold" Text="●"/><TextBlock Margin="4,0,0,0" FontSize="11" FontWeight="SemiBold" Text="{Binding ConnectionStatusLabel}"/><TextBlock Margin="4,0,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="·"/><TextBlock Margin="4,0,0,0" FontSize="11" Text="{Binding ConnectionDisplay}"/></StackPanel></Border>
      </DockPanel>

      <Grid Margin="0,0,0,4">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border MinWidth="0" Margin="0,0,16,16" Style="{StaticResource ShowcaseKpiCardStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel LastChildFill="False"><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="BUGÜN SATILAN YAKIT"/><TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}" Text="◈"/></DockPanel><TextBlock Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Center" FontSize="28" FontWeight="SemiBold" Text="{Binding DailySales}"/><TextBlock Grid.Row="2" Foreground="{DynamicResource AccentBrush}" Text="Litre bazlı günlük toplam"/></Grid></Border>
        <Border Grid.Column="1" MinWidth="0" Margin="0,0,16,16" Style="{StaticResource ShowcaseKpiCardStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel LastChildFill="False"><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="ORTALAMA DOLULUK"/><TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource SuccessForegroundBrush}" Text="◒"/></DockPanel><TextBlock Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Center" FontSize="28" FontWeight="SemiBold" Text="{Binding AverageTankFill}"/><TextBlock Grid.Row="2" Foreground="{DynamicResource SuccessForegroundBrush}" Text="Canlı tank ölçümü"/></Grid></Border>
        <Border Grid.Column="2" MinWidth="0" Margin="0,0,16,16" Style="{StaticResource ShowcaseKpiCardStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel LastChildFill="False"><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="AKTİF ALARM"/><TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource DangerForegroundBrush}" Text="!"/></DockPanel><TextBlock Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Center" FontSize="28" FontWeight="SemiBold" Text="{Binding ActiveAlarms}"/><TextBlock Grid.Row="2" Foreground="{DynamicResource DangerForegroundBrush}" Text="{Binding CriticalAlarms, StringFormat={}{0} kritik}"/></Grid></Border>
        <Border Grid.Column="3" MinWidth="0" Margin="0,0,16,16" Style="{StaticResource ShowcaseKpiCardStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel LastChildFill="False"><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="AKTİF POMPA"/><TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}" Text="◉"/></DockPanel><TextBlock Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Center" FontSize="28" FontWeight="SemiBold" Text="{Binding ActivePumpCount}"/><TextBlock Grid.Row="2" Foreground="{DynamicResource AccentBrush}" Text="Anlık çalışma durumu"/></Grid></Border>
        <Border Grid.Column="4" MinWidth="0" Margin="0,0,0,16" Style="{StaticResource ShowcaseKpiCardStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel LastChildFill="False"><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="AI RİSK SKORU"/><TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource AiAccentBrush}" Text="✦"/></DockPanel><TextBlock Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Center" FontSize="28" FontWeight="SemiBold" Text="{Binding AiRiskScore}"/><TextBlock Grid.Row="2" Foreground="{DynamicResource AiAccentBrush}" Text="{Binding AiRiskLevel}"/></Grid></Border>
      </Grid>

      <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*" MinWidth="420"/><ColumnDefinition Width="*" MinWidth="310"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource DashboardHeroCardStyle}" Margin="0,0,20,22"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><StackPanel><Border HorizontalAlignment="Left" Style="{StaticResource FilterChipStyle}"><StackPanel Orientation="Horizontal"><TextBlock Foreground="{DynamicResource SuccessForegroundBrush}" Text="●"/><TextBlock Margin="5,0,0,0" Text="CANLI OPERASYON"/></StackPanel></Border><TextBlock Margin="0,14,0,0" FontSize="20" FontWeight="SemiBold" Text="Operasyon Özeti"/><TextBlock Margin="0,8,0,0" MaxHeight="46" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding OperationSummary}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/></StackPanel><Border Grid.Column="1" Padding="14" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="1" CornerRadius="12"><StackPanel><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="İSTASYON SAĞLIĞI"/><TextBlock Margin="0,8,0,0" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="{Binding StationHealthScore}"/><Separator Margin="0,12,0,10"/><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="TOPLAM STOK"/><TextBlock Margin="0,5,0,0" FontWeight="SemiBold" Text="{Binding TotalStock}"/></StackPanel></Border></Grid></Border>
        <Border Grid.Column="1" Style="{StaticResource SectionCardStyle}"><StackPanel><DockPanel LastChildFill="False"><StackPanel><TextBlock Style="{StaticResource SectionTitleStyle}" Text="Risk ve Alarmlar"/><TextBlock Margin="0,3,0,0" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" Text="AI önceliklendirmesi"/></StackPanel><Button DockPanel.Dock="Right" Style="{StaticResource DashboardCompactActionButton}" Command="{Binding OpenActiveAlarmsCommand}" Content="Alarmlar"/></DockPanel><Border Margin="0,16,0,0" Padding="12" Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="12"><StackPanel><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="YÜKSEK / KRİTİK EKİPMAN"/><TextBlock Margin="0,4,0,0" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource DangerForegroundBrush}" Text="{Binding HighRiskEquipment}"/><TextBlock Margin="0,10,0,0" Foreground="{DynamicResource MutedForegroundBrush}" Text="{Binding MostRiskyEquipment, StringFormat=En riskli: {0}}" TextWrapping="Wrap"/><TextBlock Margin="0,7,0,0" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" Text="{Binding LastAiAssessment, StringFormat=Son AI değerlendirmesi: {0}}"/></StackPanel></Border></StackPanel></Border>
      </Grid>

      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*" MinWidth="420"/><ColumnDefinition Width="*" MinWidth="310"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,20,22"><StackPanel><DockPanel LastChildFill="False"><StackPanel><TextBlock Style="{StaticResource SectionTitleStyle}" Text="Tank Durumları"/><TextBlock Margin="0,3,0,0" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" Text="Seviye, sıcaklık ve su metrikleri"/></StackPanel><Button DockPanel.Dock="Right" Style="{StaticResource DashboardCompactActionButton}" Command="{Binding OpenTanksCommand}" Content="Tanklar"/></DockPanel><Grid Margin="0,16,0,0"><ItemsControl ItemsSource="{Binding Tanks}"><ItemsControl.Style><Style TargetType="ItemsControl"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasTanks}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ItemsControl.Style><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource DashboardTankCardStyle}"><StackPanel><DockPanel LastChildFill="False"><TextBlock FontWeight="SemiBold" Text="{Binding Code, TargetNullValue=Tank}" TextTrimming="CharacterEllipsis"/><Border DockPanel.Dock="Right" Style="{StaticResource FilterChipStyle}"><TextBlock Text="CANLI"/></Border></DockPanel><TextBlock Margin="0,10,0,0" FontSize="21" FontWeight="SemiBold" Text="{Binding MeasuredLevelLiters, StringFormat={}{0:N0} L}"/><ProgressBar Margin="0,10,0,10" Height="7" Minimum="0" Maximum="{Binding CapacityLiters}" Value="{Binding MeasuredLevelLiters}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="SICAKLIK"/><TextBlock Margin="0,3,0,0" Text="{Binding Temperature, StringFormat={}{0:N1} °C}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="SU"/><TextBlock Margin="0,3,0,0" Text="{Binding WaterLevel, StringFormat={}{0:N1} L}"/></StackPanel></Grid></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="Henüz tank verisi bulunmuyor."><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasTanks}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></StackPanel></Border>
        <Border Grid.Column="1" Style="{StaticResource SectionCardStyle}"><StackPanel><DockPanel LastChildFill="False"><StackPanel><TextBlock Style="{StaticResource SectionTitleStyle}" Text="Pompa Sağlığı"/><TextBlock Margin="0,3,0,0" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" Text="Canlı debi ve AI değerlendirmesi"/></StackPanel><Button DockPanel.Dock="Right" Style="{StaticResource DashboardCompactActionButton}" Command="{Binding OpenPumpsCommand}" Content="Pompalar"/></DockPanel><Grid Margin="0,16,0,0"><ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Pumps}"><ItemsControl.Style><Style TargetType="ItemsControl"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasPumps}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ItemsControl.Style><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource DashboardPumpRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="{Binding PumpId, StringFormat=P{0:00}}"/><Border Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource StatusBadgeStyle}"><TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{Binding Status, TargetNullValue=UNKNOWN}"/></Border><StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Style="{StaticResource TopologyMicroLabelStyle}" Text="DEBİ"/><TextBlock Margin="0,2,0,0" Text="{Binding FlowRate, StringFormat={}{0:N1} L/dk}"/></StackPanel><Border Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource FilterChipStyle}"><TextBlock Text="{Binding AiAnalysis.PumpBadgeDisplay, TargetNullValue=Değerlendirme bekleniyor}" TextTrimming="CharacterEllipsis"/></Border></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock Foreground="{DynamicResource MutedForegroundBrush}" Text="Henüz pompa verisi bulunmuyor."><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasPumps}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></StackPanel></Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
