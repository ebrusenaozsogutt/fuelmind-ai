# Application
APP_NAME=FuelMind AI Backend
APP_VERSION=0.1.0
DEBUG=true
API_PREFIX=/api
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+psycopg://fuelmind_user@localhost:5432/fuelmind_db

# Security: replace this placeholder with a securely generated value.
SECRET_KEY=replace-with-a-secure-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Development-only demo seed. Keep disabled outside local development.
ENABLE_DEMO_USERS=false
DEMO_ADMIN_PASSWORD=change-this-development-admin-password
DEMO_OPERATOR_PASSWORD=change-this-development-operator-password
