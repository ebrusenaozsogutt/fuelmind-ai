# Application
APP_NAME=FuelMind AI Backend
APP_VERSION=0.1.0
DEBUG=true
API_PREFIX=/api
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+psycopg://fuelmind_user@localhost:5432/fuelmind_db

# Security: replace this placeholder with a securely generated value.
SECRET_KEY=replace-with-a-secure-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Development-only demo seed. Keep disabled outside local development.
ENABLE_DEMO_USERS=true
DEMO_ADMIN_PASSWORD=fuelmind-demo-admin
DEMO_OPERATOR_PASSWORD=fuelmind-demo-operator

# Simulation, live transport, and planning
LIVE_WS_HEARTBEAT_SECONDS=20
SAFETY_STOCK_DAYS=2
DELIVERY_LEAD_TIME_DAYS=2
RECONCILIATION_TOLERANCE_LITERS=1.000
